[submodule "ext/SDL"]
	path = ext/SDL
	url = https://github.com/GNUbase/SDL.git
	branch = gnubase
[submodule "ext/RmlUi"]
	path = ext/RmlUi
	url = https://github.com/GNUbase/RmlUi.git
	branch = gnubase
[submodule "ext/Catch2"]
	path = ext/Catch2
	url = https://github.com/catchorg/Catch2.git
[submodule "ext/json"]
	path = ext/json
	url = https://github.com/nlohmann/json.git
	shallow = true
[submodule "ext/dr_libs"]
	path = ext/dr_libs
	url = https://github.com/mackron/dr_libs.git
[submodule "ext/stb"]
	path = ext/stb
	url = https://github.com/nothings/stb.git
[submodule "ext/flac"]
	path = ext/flac
	url = https://github.com/xiph/flac.git
	shallow = true
