#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Blocks commits whose staged files (content or path) contain a keyword from
# .git/info/private-keywords (one per line, case-insensitive, extended regex).
# The list lives outside the repo on purpose: committing it would publish the
# keywords. Binary files are not scanned. Scan errors block too (fail closed).
# Without a list, a clone that tools/install-git-hooks.sh marked as a maintainer
# clone blocks every commit; other clones skip the scan and rely on the CI scan
# of pull requests.
# A keyword may be followed by a tab and folders, separated by spaces, whose file
# content may contain it, such as an SDK's namespace in its adapter. File names
# and commit messages never may.
list="$(git rev-parse --git-common-dir)/info/private-keywords"
if [ ! -e "$list" ]; then
	required=$(git config --bool gnubase.requireKeywordList); rc=$?
	{ [ $rc -eq 1 ] || [ "$required" = false ]; } && exit 0
fi
keywords=$(tr -d '\r' < "$list" | sed -e '/^$/d')
pattern=$(printf '%s\n' "$keywords" | cut -f1 | paste -sd '|' -)
[ -n "$pattern" ] || { echo "Commit blocked, keyword list $list missing or empty" >&2; exit 1; }
tab=$(printf '\t')
strict=$(printf '%s\n' "$keywords" | grep -v "$tab" | paste -sd '|' -)

content= failed=0
if [ -n "$strict" ]; then
	content=$(git grep --cached -I -n -i -E -e "$strict") || [ $? -eq 1 ] || failed=1
fi
while IFS="$tab" read -r keyword folders; do
	[ -n "$folders" ] || continue
	set -- ':/'
	for folder in $folders; do
		set -- "$@" ":(top,exclude)$folder"
	done
	hits=$(git grep --cached -I -n -i -E -e "$keyword" -- "$@") || [ $? -eq 1 ] || failed=1
	[ -n "$hits" ] && content="${content:+$content
}$hits"
done <<EOF
$keywords
EOF
names=$(git ls-files | grep -i -E -e "$pattern") || [ $? -eq 1 ] || failed=1
[ $failed -eq 0 ] || { echo "Commit blocked, keyword scan failed" >&2; exit 1; }
[ -z "$content$names" ] && exit 0
echo "Commit blocked, private keywords found:" >&2
{ [ -n "$content" ] && echo "$content"; [ -n "$names" ] && echo "$names"; } >&2
exit 1
