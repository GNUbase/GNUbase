*.deb filter=lfs diff=lfs merge=lfs -text
*.rpm filter=lfs diff=lfs merge=lfs -text
*.AppImage filter=lfs diff=lfs merge=lfs -text

# Plugin binaries and presets
*.vst3 filter=lfs diff=lfs merge=lfs -text
*.clap filter=lfs diff=lfs merge=lfs -text
*.vstpreset filter=lfs diff=lfs merge=lfs -text
*.fxp filter=lfs diff=lfs merge=lfs -text
*.fxb filter=lfs diff=lfs merge=lfs -text

# Archives and project containers
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text
*.dawproject filter=lfs diff=lfs merge=lfs -text

# Shell scripts and Git hooks keep LF line endings on every platform, because sh fails on CRLF.
*.sh text eol=lf
tools/git-hooks/* text eol=lf
