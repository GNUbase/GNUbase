@@ -52,7 +53,13 @@ PercussiveAudioCurve::reset()
 void
 PercussiveAudioCurve::setFftSize(int newSize)
 {
-    m_prevMag = reallocate(m_prevMag, m_fftSize/2 + 1, newSize/2 + 1);
+    // GNUbase: only ever grow the buffer, so that switching between
+    // FFT sizes, as real-time mode does when the ratio or pitch scale
+    // changes, allocates nothing once the largest size has been seen
