<!-- A sample document (#49) that must look the same on every platform: text in Lato (family LatoLatin) at several
     sizes and two weights, borders, rounded corners, a turned box and clipped text, in 320x240 dp. Its screenshots
     are tests/golden/ui/sample-1x.png and sample-2x.png. -->
<rml>
<head>
	<title>Sample</title>
	<style>
		body {
			display: block; position: absolute; left: 0; top: 0; width: 320dp; height: 240dp; margin: 0;
			padding: 12dp; box-sizing: border-box; background-color: #1d2127; color: #e8eaed;
			font-family: LatoLatin; font-size: 13dp;
		}
		h1 { display: block; margin: 0 0 4dp 0; font-size: 22dp; font-weight: bold; color: #ffffff; }
		p { display: block; margin: 0 0 8dp 0; }
		.row { display: flex; margin-bottom: 10dp; }
		.box { width: 60dp; height: 40dp; margin-right: 12dp; box-sizing: border-box; }
		.panel { background-color: #2c323b; border: 1dp #4a5361; border-radius: 6dp; }
		.button {
			background-color: #3d7eff; border-radius: 4dp; color: #ffffff; font-weight: bold; text-align: center;
			line-height: 40dp;
		}
		.ring { border: 3dp #e04b8b; border-radius: 20dp; }
		.turned { background-color: #2bb5a8; transform: rotate(15deg); }
		.clip { width: 150dp; height: 18dp; overflow: hidden; white-space: nowrap; }
		.small { font-size: 10dp; color: #9aa3ad; }
	</style>
</head>
<body>
	<h1>GNUbase</h1>
	<p>The quick brown fox jumps over the lazy dog. 0123456789</p>
	<div class="row">
		<div class="box panel"/>
		<div class="box button">Play</div>
		<div class="box ring"/>
		<div class="box turned"/>
	</div>
	<p class="clip">This line is too long for its box, so it is cut off at the edge.</p>
	<p class="small">Small text: 1/16 · 120 BPM · 4/4 · -6.0 dB</p>
</body>
</rml>
