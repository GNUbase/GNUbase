<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Menus, context menus and tooltips of the widget library (#54) for tests/widgets_tests.cpp: a menu button, a track
     with a context menu that has submenus (one with only a disabled item), a disabled item and a hidden one (#524), an
     element whose right click with a modifier key opens another menu, elements with tooltips (one with a member
     without a title and one with a title of its own), a notification, a menu with nested controls and controls that
     aren't Tab stops (#826), and a menu bar whose File menu has a submenu and whose Tools title is disabled. -->
<rml>
<head>
	<title>Popups</title>
	<style>
		body { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 8dp; }
		#track { position: absolute; left: 200dp; top: 100dp; width: 200dp; height: 40dp; }
		#plain { position: absolute; left: 200dp; top: 200dp; width: 200dp; height: 40dp; }
		#corner { position: absolute; right: 0; bottom: 0; width: 40dp; height: 20dp; }
		#group { position: absolute; left: 450dp; top: 200dp; width: 150dp; height: 60dp; }
		#member { position: absolute; left: 10dp; top: 10dp; width: 40dp; height: 20dp; }
		#titled { position: absolute; left: 70dp; top: 10dp; width: 40dp; height: 20dp; }
		#modified { position: absolute; left: 450dp; top: 100dp; width: 100dp; height: 40dp; }
		#menubar { position: absolute; left: 200dp; top: 300dp; }
	</style>
</head>
<body>
	<button id="edit-button" menu="edit">Edit</button>
	<button id="controls-button" menu="controls-menu">Controls</button>
	<div id="track" class="panel" contextmenu="track-menu" title="Audio 01">Audio 01</div>
	<div id="plain" class="panel">No menu</div>
	<div id="corner" contextmenu="track-menu" title="A long tooltip near the window's corner"/>
	<div id="group" title="Group"><div id="member"/><div id="titled" title="Titled"/></div>
	<div id="modified" class="panel" contextmenu="track-menu" modifiercontextmenu="edit">Modified</div>
	<notification id="message" duration="0.5"/>
	<menu id="edit">
		<menuitem id="undo">Undo</menuitem>
		<menuitem id="redo" disabled="disabled">Redo</menuitem>
		<menuseparator/>
		<menuitem id="cut">Cut</menuitem>
	</menu>
	<menu id="track-menu">
		<menuitem id="rename">Rename</menuitem>
		<menuitem id="color">Color
			<menu id="colors">
				<menuitem id="red">Red</menuitem>
				<menuitem id="blue">Blue</menuitem>
			</menu>
		</menuitem>
		<menuitem id="remove" disabled="disabled">Remove</menuitem>
		<menuitem id="lock">Lock
			<menu id="locks">
				<menuitem id="locked" disabled="disabled">Locked</menuitem>
			</menu>
		</menuitem>
		<menuitem id="gone" class="hidden">Gone</menuitem>
	</menu>
	<menu id="controls-menu">
		<menuitem id="controls-first">First</menuitem>
		<input id="disabled-control" type="text" disabled="disabled"/>
		<input id="hidden-control" type="text" style="display: none;"/>
		<div><div><button id="nested-control">Nested</button></div></div>
		<input id="no-tab-control" type="text" style="tab-index: none;"/>
		<input id="no-focus-control" type="text" style="focus: none;"/>
		<menuitem id="controls-last">Last</menuitem>
	</menu>
	<menubar id="menubar">
		<button id="file-title" menu="file">File</button>
		<button id="view-title" menu="view">View</button>
		<button id="tools-title" menu="tools" disabled="disabled">Tools</button>
		<button id="help-title" menu="help">Help</button>
	</menubar>
	<menu id="file">
		<menuitem id="new">New</menuitem>
		<menuitem id="recent">Recent
			<menu id="recent-menu">
				<menuitem id="first-recent">Song 1</menuitem>
				<menuitem id="second-recent">Song 2</menuitem>
			</menu>
		</menuitem>
		<menuitem id="close">Close</menuitem>
	</menu>
	<menu id="view">
		<menuitem id="zoom-in">Zoom In</menuitem>
	</menu>
	<menu id="tools">
		<menuitem id="setup">Setup</menuitem>
	</menu>
	<menu id="help">
		<menuitem id="about">About</menuitem>
	</menu>
</body>
</rml>
