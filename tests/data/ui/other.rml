<!-- A blue box 40 by 40 dp at (100 dp, 10 dp). -->
<rml>
<head>
	<title>Other</title>
	<style>
		body { display: block; position: absolute; left: 0; top: 0; right: 0; bottom: 0; margin: 0; }
		div { display: block; }
		#box { position: absolute; left: 100dp; top: 10dp; width: 40dp; height: 40dp; background-color: #0000ff; }
	</style>
</head>
<body><div id="box"/></body>
</rml>
