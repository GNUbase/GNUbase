<!-- The project window: a docking window (docs/features/docking.md) with the toolbar, the info line, the zones and
     their splitters, the status line and the transport bar. The main zone shows the event display (#84) until the
     track list (#81) joins it. ui::Docking lays out the elements with zone, splitter for, strip and toggle
     attributes and fills the other zones with their panels' tabs. ui::EventDisplay fills the element #event-display
     and drives the controls and menus with these ids (docs/features/event-display.md): the ruler's arrow button
     .ruler-format, #ruler-format-menu, #zoom-presets-menu, #auto-scroll and #auto-scroll-menu, and the snap controls
     #snap, #snap-type, #snap-type-menu, #grid-type, #grid-type-menu (which the display fills with the ruler format's
     grid types) and #snap-zero-crossing (docs/features/snap.md), and the tools: a button[tool] per tool, whose
     tool-menu opens on a second click (#object-selection-menu, #line-menu), and #combine-selection-tools
     (docs/features/tools.md). Its dialogs are zoom-preset.rml and
     zoom-presets.rml, next to this file.
     The focus zone "project" has the project window's key commands, such as zooming with H and G. -->
<rml>
<head>
	<title>Project</title>
	<style>
		body
		{
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
		}

		#toolbar button
		{
			margin-right: 2dp;
		}

		#toolbar #auto-scroll-settings, #toolbar #play-tool
		{
			margin-right: 12dp;
		}

		#toolbar .spacer
		{
			flex: 1 1 0;
		}

		#event-display
		{
			position: absolute;
			left: 0;
			top: 0;
			right: 0;
			bottom: 0;
		}
	</style>
</head>
<body class="docking" focuszone="project">
	<div id="toolbar" class="toolbar" strip="toolbar">
		<button id="combine-selection-tools" type="toggle" class="icon-only" title="Combine Selection Tools"><svg class="icon" src="../icons/tool-pointer.svg"/></button>
		<button tool="objectSelection" tool-menu="object-selection-menu" class="icon-only" title="Object Selection"><svg class="icon" src="../icons/tool-pointer.svg"/></button>
		<button tool="rangeSelection" class="icon-only" title="Range Selection"><svg class="icon" src="../icons/tool-range.svg"/></button>
		<button tool="draw" class="icon-only" title="Draw"><svg class="icon" src="../icons/tool-draw.svg"/></button>
		<button tool="erase" class="icon-only" title="Erase"><svg class="icon" src="../icons/tool-erase.svg"/></button>
		<button tool="split" class="icon-only" title="Split"><svg class="icon" src="../icons/tool-split.svg"/></button>
		<button tool="glue" class="icon-only" title="Glue"><svg class="icon" src="../icons/tool-glue.svg"/></button>
		<button tool="mute" class="icon-only" title="Mute"><svg class="icon" src="../icons/tool-mute.svg"/></button>
		<button tool="zoom" class="icon-only" title="Zoom"><svg class="icon" src="../icons/tool-zoom.svg"/></button>
		<button tool="line" tool-menu="line-menu" class="icon-only" title="Line"><svg class="icon" src="../icons/tool-line.svg"/></button>
		<button id="play-tool" tool="play" class="icon-only" title="Play"><svg class="icon" src="../icons/tool-audition.svg"/></button>
		<button id="auto-scroll" type="toggle" title="Auto-Scroll">Auto-Scroll</button>
		<button id="auto-scroll-settings" class="icon-only" menu="auto-scroll-menu" title="Select Auto-Scroll Settings"><svg class="icon" src="../icons/general-arrow-down.svg"/></button>
		<button id="zoom-presets" class="icon-only" menu="zoom-presets-menu" title="Horizontal Zoom Presets"><svg class="icon" src="../icons/tool-zoom.svg"/></button>
		<button id="snap" type="toggle" class="icon-only" title="Snap On/Off"><svg class="icon" src="../icons/general-snap.svg"/></button>
		<button id="snap-type" menu="snap-type-menu" title="Snap Type">Grid</button>
		<button id="grid-type" menu="grid-type-menu" title="Grid Type">Bar</button>
		<button id="snap-zero-crossing" type="toggle" class="icon-only" title="Snap to Zero Crossing"><svg class="icon" src="../icons/general-zero-crossing.svg"/></button>
		<div class="spacer"/>
		<button id="show-left-zone" type="toggle" toggle="left" class="icon-only" title="Show/Hide Left Zone"><svg class="icon" src="../icons/layout-left-zone.svg"/></button>
		<button id="show-lower-zone" type="toggle" toggle="lower" class="icon-only" title="Show/Hide Lower Zone"><svg class="icon" src="../icons/layout-lower-zone.svg"/></button>
		<button id="show-right-zone" type="toggle" toggle="right" class="icon-only" title="Show/Hide Right Zone"><svg class="icon" src="../icons/layout-right-zone.svg"/></button>
		<button id="window-layout" class="icon-only" menu="window-layout-menu" title="Set up Window Layout"><svg class="icon" src="../icons/general-arrow-down.svg"/></button>
	</div>
	<div id="info-line" class="strip" strip="infoLine" default="hidden"/>
	<div class="zones">
		<div id="left-zone" zone="left" focuszone="left" size="240" default="hidden"/>
		<splitter for="left"/>
		<div class="zone-column">
			<div id="main-zone" zone="main" focuszone="project">
				<div id="event-display" class="event-display">
					<button class="ruler-format icon-only" menu="ruler-format-menu" title="Ruler Time Format"><svg class="icon" src="../icons/general-arrow-down.svg"/></button>
				</div>
			</div>
			<splitter for="lower" resize="next"/>
			<div id="lower-zone" zone="lower" focuszone="lower" size="240" default="hidden"/>
		</div>
		<splitter for="right" resize="next"/>
		<div id="right-zone" zone="right" focuszone="right" size="240" default="hidden"/>
	</div>
	<div id="status-line" class="strip" strip="statusLine" default="hidden"/>
	<div id="transport-bar" class="strip" strip="transportBar" default="hidden"/>

	<!-- Set up Window Layout (reference manual p. 65) -->
	<menu id="window-layout-menu">
		<menuitem type="toggle" toggle="left">Left Zone</menuitem>
		<menuitem type="toggle" toggle="lower">Lower Zone</menuitem>
		<menuitem type="toggle" toggle="right">Right Zone</menuitem>
		<menuseparator/>
		<menuitem type="toggle" toggle="infoLine">Info Line</menuitem>
		<menuitem type="toggle" toggle="overviewLine">Overview Line</menuitem>
		<menuitem type="toggle" toggle="statusLine">Status Line</menuitem>
		<menuitem type="toggle" toggle="transportBar">Transport Bar</menuitem>
	</menu>
	<menu id="ruler-format-menu">
		<menuitem format="barsBeats">Bars+Beats</menuitem>
		<menuitem format="seconds">Seconds</menuitem>
		<menuitem format="timecode">Timecode</menuitem>
		<menuitem format="samples">Samples</menuitem>
		<menuitem format="userFrames">fps (User)</menuitem>
	</menu>
	<!-- The presets come before Zoom Full, the project's cycle markers after it. -->
	<menu id="zoom-presets-menu">
		<menuitem id="zoom-full">Zoom Full</menuitem>
		<menuseparator/>
		<menuitem id="zoom-preset-add">Add...</menuitem>
		<menuitem id="zoom-presets-organize">Organize...</menuitem>
	</menu>
	<menu id="snap-type-menu">
		<menuitem snap-type="grid">Grid</menuitem>
		<menuitem snap-type="gridRelative">Grid Relative</menuitem>
		<menuitem snap-type="events">Events</menuitem>
		<menuitem snap-type="shuffle">Shuffle</menuitem>
		<menuitem snap-type="cursor">Cursor</menuitem>
		<menuitem snap-type="gridCursor">Grid + Cursor</menuitem>
		<menuitem snap-type="eventsCursor">Events + Cursor</menuitem>
		<menuitem snap-type="eventsGridCursor">Events + Grid + Cursor</menuitem>
	</menu>
	<menu id="grid-type-menu"/>
	<!-- The tools' modes, which a second click on the tool's button opens (reference manual pp. 265, 873) -->
	<menu id="object-selection-menu">
		<menuitem sizing="normal">Normal Sizing</menuitem>
		<menuitem sizing="moveContents">Sizing Moves Contents</menuitem>
		<menuitem disabled="">Sizing Applies Time Stretch</menuitem>
	</menu>
	<menu id="line-menu">
		<menuitem line-mode="line">Line</menuitem>
		<menuitem line-mode="parabola">Parabola</menuitem>
		<menuitem line-mode="sine">Sine</menuitem>
		<menuitem line-mode="triangle">Triangle</menuitem>
		<menuitem line-mode="square">Square</menuitem>
	</menu>
	<menu id="auto-scroll-menu">
		<menuitem id="page-scroll">Page Scroll</menuitem>
		<menuitem id="stationary-cursor">Stationary Cursor</menuitem>
		<menuseparator/>
		<menuitem id="suspend-auto-scroll">Suspend Auto-Scroll when Editing</menuitem>
	</menu>
</body>
</rml>
