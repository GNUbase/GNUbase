<!-- The Freeze Channel Options dialog (docs/features/render-in-place.md, reference manual p. 992): ui::TrackList opens
     it with Edit > Freeze/Unfreeze > Selected Tracks for the selected audio and instrument tracks that aren't frozen,
     with the Tail Size of the user setting render.freezeTail. OK saves it there, for Selected Tracks (with Current
     Settings) too, and freezes them with track.freeze. -->
<rml>
<head>
	<title>Freeze Channel Options</title>
	<style>
		dialog
		{
			width: 300dp;
		}

		.row
		{
			display: flex;
			align-items: center;
			margin: 8dp 12dp 0 12dp;
		}

		.row label
		{
			flex: 1;
		}

		.buttons
		{
			justify-content: flex-end;
		}

		.buttons button
		{
			margin-left: 6dp;
		}
	</style>
</head>
<body>
	<dialog id="freeze-options-dialog">
		<div class="dialog-titlebar">Freeze Channel Options</div>
		<div class="row">
			<label for="freeze-tail">Tail Size (Seconds)</label>
			<valuefield id="freeze-tail" value="30" min="0" max="60" step="0.5" decimals="1"/>
		</div>
		<div class="row buttons">
			<button result="cancel">Cancel</button>
			<button id="freeze-options-ok" class="primary" result="ok">OK</button>
		</div>
	</dialog>
</body>
</rml>
