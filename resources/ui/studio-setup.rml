<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The studio setup dialog (#79, docs/features/studio-setup.md): the audio system, the audio device with its ports,
     the MIDI ports and the MIDI inputs' MPE setup, each a page that the devices list on the left selects, and a page
     for each detected MPE input device (#1674). app::AppUi opens it (the UI command
     window.studioSetup). Its Lua reads everything from the engine when the dialog loads and after Apply, and changes
     it only through engine commands: Apply and OK send what the pages changed, Cancel drops it. -->
<rml>
<head>
	<title>Studio Setup</title>
	<style>
		dialog
		{
			width: 780dp;
		}

		.content
		{
			display: flex;
			height: 460dp;
			margin: 8dp 12dp 0 12dp;
		}

		#studio-devices
		{
			width: 160dp;
			margin-right: 12dp;
		}

		.page
		{
			display: none;
			flex: 1;
			overflow-y: auto;
		}

		.page.shown
		{
			display: block;
		}

		.field
		{
			display: flex;
			align-items: center;
			height: 28dp;
		}

		.field .label
		{
			width: 160dp;
		}

		.ports
		{
			margin-top: 8dp;
		}

		#driver
		{
			width: 320dp;
		}

		.ports td
		{
			padding: 2dp 6dp 2dp 0;
			vertical-align: middle;
		}

		/* I/O, Port System Name, Show As, Visible, State and, for MIDI, In 'All MIDI Inputs' */
		.ports td:nth-child(1)
		{
			width: 36dp;
		}

		.ports td:nth-child(2)
		{
			width: 130dp;
		}

		.ports td:nth-child(3)
		{
			width: 136dp;
		}

		.ports td:nth-child(4)
		{
			width: 52dp;
		}

		.ports td:nth-child(5)
		{
			width: 80dp;
		}

		.ports input.text
		{
			width: 130dp;
		}

		/* The Note Expression Input page: the selected input's settings. */
		.mpe-port
		{
			display: none;
		}

		.mpe-port.shown
		{
			display: block;
		}

		.mpe-port input.text
		{
			width: 60dp;
		}

		.mpe-port .field .label
		{
			width: 200dp;
		}

		/* The MIDI Activity display: the input's last messages, the newest at the bottom. */
		.mpe-activity
		{
			height: 112dp;
			margin-left: 200dp;
		}

		.mpe-message
		{
			height: 14dp;
		}

		.row
		{
			display: flex;
			margin: 8dp 12dp 0 12dp;
		}

		#studio-setup-message
		{
			flex: 1;
		}

		.row button
		{
			margin-left: 6dp;
		}
	</style>
	<script>
		-- The dialog's state, in the UI's Lua: what the engine said when the dialog loaded, to send only what changed.
		StudioSetup = {}
		local setup = StudioSetup

		local function escape(text)
			return (tostring(text):gsub('[&<>"]', {["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;"}))
		end

		local function option(value, text, selected)
			return '<option value="' .. escape(value) .. '"' .. (selected and " selected" or "") .. ">" ..
				escape(text) .. "</option>"
		end

		-- attributes: what tells the check box apart, e.g. 'id="multi-processing"'.
		local function checkbox(attributes, checked, disabled)
			return '<input type="checkbox" ' .. attributes .. (checked and " checked" or "") ..
				(disabled and " disabled" or "") .. "/>"
		end

		local function field(label, control)
			return '<div class="field"><span class="label">' .. escape(label) .. "</span>" .. control .. "</div>"
		end

		local function milliseconds(frames, sampleRate)
			return string.format("%.1f ms", frames * 1000 / sampleRate)
		end

		local function numberText(value)
			return math.tointeger(value) and tostring(math.tointeger(value)) or tostring(value)
		end

		-- A form control's value: the value attribute that RmlUi keeps up to date.
		local function valueOf(element)
			local value = element and element:GetAttribute("value")
			return value ~= nil and tostring(value) or nil
		end

		local function checked(element)
			return element ~= nil and element:HasAttribute("checked")
		end

		local function audioSystemPage(devices, status)
			local device = status.device
			local options = {}
			setup.drivers = {}
			setup.loadedDriver = ""
			if device == nil then
				options[1] = option("", "No Driver", true)
			end
			for _, backend in ipairs(devices.backends) do
				for _, info in ipairs(backend.devices or {}) do
					setup.drivers[#setup.drivers + 1] = {backend = backend.name, device = info.id}
					local text = backend.name .. " - " .. info.name .. (info.available == false and " (unavailable)" or "")
					local selected = device ~= nil and device.backend == backend.name and device.id == info.id
					if selected then
						setup.loadedDriver = tostring(#setup.drivers)
					end
					options[#options + 1] = option(#setup.drivers, text, selected)
				end
			end
			local rml = field("Audio Driver",
				'<select id="driver" onchange="StudioSetup.touchDriver(document)">' .. table.concat(options) .. "</select>")
			if device ~= nil then
				rml = rml .. field("Input Latency", '<span id="input-latency">' ..
					milliseconds(device.inputLatency, device.sampleRate) .. "</span>") ..
					field("Output Latency", '<span id="output-latency">' ..
					milliseconds(device.outputLatency, device.sampleRate) .. "</span>") ..
					field("HW Sample Rate", "<span>" .. numberText(device.sampleRate) .. " Hz</span>") ..
					field("Record Shift (samples)", '<input type="text" id="record-shift" value="' ..
					device.recordShift .. '"/>')
			end
			return rml ..
				field("Activate Multi Processing", checkbox('id="multi-processing"', status.processing.multiProcessing))
		end

		-- A select of values with current selected; current is added when values lack it, so that the select never
		-- falls back to another value the user didn't choose.
		local function choices(id, values, current)
			local found = false
			for _, value in ipairs(values) do
				found = found or value == current
			end
			if not found then
				values = {current, table.unpack(values)}
			end
			local options = {}
			for _, value in ipairs(values) do
				options[#options + 1] = option(numberText(value), numberText(value), value == current)
			end
			return '<select id="' .. id .. '">' .. table.concat(options) .. "</select>"
		end

		local function portRows(ports, input)
			local rows = {}
			for _, port in ipairs(ports) do
				rows[#rows + 1] = '<tr class="port" name="' .. escape(port.name) .. '" input="' .. tostring(input) ..
					'"><td>' .. (input and "In" or "Out") .. "</td><td>" .. escape(port.name) ..
					'</td><td><input type="text" class="show-as" value="' .. escape(port.showAs) .. '"/></td><td>' ..
					checkbox('class="visible"', port.visible) .. "</td><td>" .. (port.visible and "Active" or "Inactive") ..
					"</td></tr>"
			end
			return table.concat(rows)
		end

		-- Above a ports table: its Reset button, #reset-audio-ports or #reset-midi-ports.
		local function portsTitle(id)
			return field("Ports", '<button id="reset-' .. id .. '" onclick="StudioSetup.resetPorts(document, \'' .. id ..
				'\')">Reset</button>')
		end

		-- The open device's page. audio.get's device lists its sample rates, block sizes and clock sources, current
		-- ones included, unlike its entry in audio.devices.
		local function audioDevicePage(status, ports)
			local device = status.device
			if device == nil then
				return "<p>No audio device.</p>"
			end
			local clockSources = device.clockSources or {}
			local clock = ""
			if #clockSources > 0 then
				-- Some drivers flag none as current: an empty option then, which Apply doesn't send, instead of the
				-- select falling back to the first source.
				local options = {}
				if device.clockSource == nil then
					options[1] = option("", "", true)
				end
				for _, name in ipairs(clockSources) do
					options[#options + 1] = option(name, name, name == device.clockSource)
				end
				clock = field("Clock Source", '<select id="clock-source">' .. table.concat(options) .. "</select>")
			end
			return '<div class="field"><button id="control-panel" onclick="StudioSetup.controlPanel(document)"' ..
				(device.controlPanel and "" or " disabled") .. ">Control Panel</button></div>" ..
				field("Input Latency", "<span>" .. milliseconds(device.inputLatency, device.sampleRate) .. "</span>") ..
				field("Output Latency", "<span>" .. milliseconds(device.outputLatency, device.sampleRate) .. "</span>") ..
				field("Sample Rate", choices("sample-rate", device.sampleRates or {}, device.sampleRate)) ..
				field("Buffer Size", choices("block-size", device.blockSizes or {}, device.blockSize)) .. clock ..
				field("Externally Clocked", checkbox('id="externally-clocked"', device.externallyClocked)) ..
				field("Direct Monitoring",
					checkbox('id="direct-monitoring"', device.directMonitoring, not device.canMonitorDirectly)) ..
				portsTitle("audio-ports") ..
				'<table class="ports"><thead><tr><td>I/O</td><td>Port System Name</td><td>Show As</td><td>Visible</td>' ..
				'<td>State</td></tr></thead><tbody id="audio-ports">' .. portRows(ports.inputs, true) ..
				portRows(ports.outputs, false) .. "</tbody></table>"
		end

		local function midiPage(ports)
			local rows = {}
			for index, port in ipairs(ports) do
				local state = not port.present and "Not Present" or (port.visible and "Active" or "Inactive")
				rows[#rows + 1] = '<tr class="port" index="' .. index .. '" name="' .. escape(port.name) .. '"><td>' ..
					(port.input and "In" or "Out") ..
					"</td><td>" .. escape(port.name) .. '</td><td><input type="text" class="show-as" value="' ..
					escape(port.showAs) .. '"/></td><td>' .. checkbox('class="visible"', port.visible) .. "</td><td>" ..
					state .. "</td><td>" .. (port.input and checkbox('class="all-inputs"', port.inAllInputs) or "") ..
					"</td></tr>"
			end
			return portsTitle("midi-ports") ..
				'<table class="ports"><thead><tr><td>I/O</td><td>Port System Name</td><td>Show As</td>' ..
				"<td>Visible</td><td>State</td><td>In 'All MIDI Inputs'</td></tr></thead><tbody id=\"midi-ports\">" ..
				table.concat(rows) .. "</tbody></table>"
		end

		-- The Note Expression Input page (reference manual pp. 1295-1298): the MIDI Input list selects an input, whose
		-- MPE setup (mpe in midi.ports) shows below it; each input has its fields, the others' hidden. Built again after
		-- Apply, it keeps showing the input selected (setup.mpeShown, its backend/id).
		local mpeModes = {{"off", "Off"}, {"lower", "MPE Mode, Lower Zone"}, {"upper", "MPE Mode, Upper Zone"},
			{"rotation", "Channel Rotation"}, {"both", "MPE Mode, Both Zones"}}
		local initialsX = {{"off", "Off"}, {"center", "Center (64)"}}
		local initialsY = {{"off", "Off"}, {"min", "Min (0)"}, {"center", "Center (64)"}, {"max", "Max (127)"}}
		-- A dimension's MIDI Message (#1674): aftertouch, pitch bend or a controller.
		local mpeMessages = {{"aftertouch", "Aftertouch"}, {"pitchBend", "Pitchbend"}}
		for number = 0, 127 do
			mpeMessages[#mpeMessages + 1] = {"cc" .. number, "CC " .. number .. (number == 74 and " (Brightness)" or "")}
		end
		-- Its Note Expression Assignment.
		local mpeExpressions = {{"none", "None"}, {"volume", "Volume"}, {"pan", "Pan"}, {"tuning", "Tuning"},
			{"vibrato", "Vibrato"}, {"expression", "Expression"}, {"brightness", "Brightness"}, {"pressure", "Pressure"},
			{"polyPressure", "MIDI PolyPressure"}}
		-- The members of mpe that the page edits with a select, by its class.
		local mpeSelects = {mode = "mpe-mode", initialX = "mpe-initial-x", initialY = "mpe-initial-y",
			xMessage = "mpe-x-message", pressureMessage = "mpe-pressure-message", yMessage = "mpe-y-message",
			xExpression = "mpe-x-expression", pressureExpression = "mpe-pressure-expression",
			yExpression = "mpe-y-expression"}
		local activityLines = 8 -- the messages the MIDI Activity display shows

		local function named(class, values, current, extra)
			local options = {}
			for _, value in ipairs(values) do
				options[#options + 1] = option(value[1], value[2], value[1] == current)
			end
			return '<select class="' .. class .. '"' .. (extra or "") .. ">" .. table.concat(options) .. "</select>"
		end

		local function numbered(class, last, current, disabled)
			local values = {}
			for number = 1, last do
				values[#values + 1] = {number, tostring(number)}
			end
			return named(class, values, current, disabled and " disabled" or "")
		end

		local function portKey(port)
			return port.backend .. "/" .. port.id
		end

		-- A MIDI message as the MIDI Activity display shows it: its channel, its kind and its values.
		local function describe(bytes)
			local status, channel = bytes[1] & 0xF0, (bytes[1] & 0x0F) + 1
			local first, second = bytes[2] or 0, bytes[3] or 0
			local kinds = {[0x80] = "Note Off " .. first .. " " .. second, [0x90] = "Note On " .. first .. " " .. second,
				[0xA0] = "Poly Pressure " .. first .. " " .. second, [0xB0] = "CC " .. first .. " " .. second,
				[0xC0] = "Program " .. first, [0xD0] = "Aftertouch " .. first,
				[0xE0] = "Pitchbend " .. (first + (second << 7))}
			if status == 0x90 and second == 0 then
				status = 0x80
			end
			if kinds[status] == nil then
				return "System " .. string.format("%02X", bytes[1])
			end
			return "Ch " .. channel .. " " .. kinds[status]
		end

		local function activityRml(key)
			local lines = {}
			for _, line in ipairs((setup.activity or {})[key] or {}) do
				lines[#lines + 1] = '<div class="mpe-message">' .. escape(line) .. "</div>"
			end
			return table.concat(lines)
		end

		local function mpePage(ports)
			local shownKey = nil
			for _, port in ipairs(ports) do
				if port.input and (shownKey == nil or portKey(port) == setup.mpeShown) then
					shownKey = portKey(port)
				end
			end
			local inputs, fields = {}, {}
			for index, port in ipairs(ports) do
				if port.input then
					local mpe = port.mpe
					local shown = portKey(port) == shownKey
					inputs[#inputs + 1] = option(index, port.showAs, shown)
					fields[#fields + 1] = '<div class="mpe-port' .. (shown and " shown" or "") .. '" index="' .. index ..
						'">' ..
						(port.mpeDevice and field("Detected Device", '<span class="mpe-device">' ..
							escape(port.mpeDevice) .. "</span>") or "") ..
						field("Pressure MIDI Message", named("mpe-pressure-message", mpeMessages, mpe.pressureMessage)) ..
						field("Pressure Note Expression", named("mpe-pressure-expression", mpeExpressions,
							mpe.pressureExpression)) ..
						field("Horizontal/X MIDI Message", named("mpe-x-message", mpeMessages, mpe.xMessage)) ..
						field("Horizontal/X Initial Value", named("mpe-initial-x", initialsX, mpe.initialX)) ..
						field("Use for Tuning", checkbox('class="mpe-tuning" onchange="StudioSetup.mpeTuningChanged(element)"',
							mpe.tuning)) ..
						field("Pitch Range", '<input type="text" class="mpe-pitch-range" value="' .. mpe.pitchRange ..
							'"/>') ..
						field("Horizontal/X Note Expression", named("mpe-x-expression", mpeExpressions,
							mpe.tuning and "tuning" or mpe.xExpression, ' own="' .. mpe.xExpression ..
							'" onchange="StudioSetup.mpeXExpressionChanged(element)"' .. (mpe.tuning and " disabled" or ""))) ..
						field("Vertical/Y MIDI Message", named("mpe-y-message", mpeMessages, mpe.yMessage)) ..
						field("Vertical/Y Initial Value", named("mpe-initial-y", initialsY, mpe.initialY)) ..
						field("Vertical/Y Note Expression", named("mpe-y-expression", mpeExpressions, mpe.yExpression)) ..
						field("Multi-Channel Input Mode", named("mpe-mode", mpeModes, mpe.mode,
							' onchange="StudioSetup.mpeModeChanged(element)"')) ..
						field("Used Channels", numbered("mpe-channels", 16, mpe.channels)) ..
						field("Upper Zone Channels", numbered("mpe-upper-channels", 13, mpe.upperChannels,
							mpe.mode ~= "both")) ..
						field("First Channel", numbered("mpe-first-channel", 16, mpe.firstChannel,
							mpe.mode ~= "rotation")) ..
						field("MIDI Activity", "") ..
						'<div class="mpe-activity">' .. activityRml(portKey(port)) .. "</div></div>"
				end
			end
			if #inputs == 0 then
				return "<p>No MIDI input.</p>"
			end
			return field("MIDI Input", '<select id="mpe-input" onchange="StudioSetup.showMpeInput(document, ' ..
				"element:GetAttribute('value'))\">" .. table.concat(inputs) .. "</select>") .. table.concat(fields)
		end

		-- Why the device chosen last can't be used while a fallback plays instead (failed in audio.get), or nil: the
		-- dummy device, or the backend's default device with the fallback device default.
		local function failure(status)
			local failed = status.failed
			if failed == nil then
				return nil
			end
			local device = status.device
			local instead = "the dummy device"
			if device ~= nil and device.backend ~= "dummy" then
				instead = device.backend .. " - " .. (device.name ~= "" and device.name or device.id)
			end
			return "Cannot use " .. failed.backend .. (failed.device ~= "" and " - " .. failed.device or "") .. ": " ..
				failed.reason .. "; " .. instead .. " plays instead"
		end

		-- Shows the errors of commands that failed, and why the device chosen last can't be used.
		local function report(document, errors)
			local messages = {table.unpack(errors)}
			messages[#messages + 1] = failure(setup.status)
			document:GetElementById("studio-setup-message").inner_rml = escape(table.concat(messages, "; "))
		end

		-- The user picked another option of the Audio Driver list than the one it loaded with, maybe the loaded one
		-- again later. The list's own change when it shows its first selection counts for nothing.
		function setup.touchDriver(document)
			if valueOf(document:GetElementById("driver")) ~= setup.loadedDriver then
				setup.driverTouched = true
			end
		end

		-- Reads everything from the engine and fills the pages.
		function setup.load(document)
			setup.driverTouched = false
			local devices = gnubase.audio.devices()
			setup.status = gnubase.audio.get()
			setup.audioPorts = gnubase.audio.ports()
			setup.midiPorts = gnubase.midi.ports().ports
			local device = setup.status.device
			document:GetElementById("devices-device").inner_rml = escape(device and device.name or "Audio Device")
			document:GetElementById("page-system").inner_rml = audioSystemPage(devices, setup.status)
			document:GetElementById("page-device").inner_rml = audioDevicePage(setup.status, setup.audioPorts)
			document:GetElementById("page-midi").inner_rml = midiPage(setup.midiPorts)
			document:GetElementById("page-mpe").inner_rml = mpePage(setup.midiPorts)
			-- A page for each detected MPE input device, named after it, after the Note Expression Input page.
			local list = document:GetElementById("studio-devices")
			for _, item in ipairs(document:QuerySelectorAll(".devices-mpe-device")) do
				list:RemoveChild(item)
			end
			for index, port in ipairs(setup.midiPorts) do
				if port.input and port.mpeDevice then
					local item = list:AppendChild(document:CreateElement("listitem"))
					item:SetClass("devices-mpe-device", true)
					item:SetAttribute("value", "mpe" .. index)
					item.inner_rml = escape(port.mpeDevice)
				end
			end
			setup.document = document
			if not setup.subscribed then
				setup.subscribed = true
				gnubase.on("midi.activity", setup.activityArrived)
				gnubase.midi.activityListen({on = true, listener = "studioSetup"})
			end
			report(document, {})
		end

		-- The MIDI Activity display: the inputs' messages (the event midi.activity), each input's last ones.
		function setup.activityArrived(event)
			setup.activity = setup.activity or {}
			local changed = {}
			for _, received in ipairs(event.data.received) do
				local key = received.backend .. "/" .. received.id
				local lines = setup.activity[key] or {}
				lines[#lines + 1] = describe(received.bytes)
				if #lines > activityLines then
					table.remove(lines, 1)
				end
				setup.activity[key] = lines
				changed[key] = true
			end
			local document = setup.document
			if document == nil then
				return
			end
			for _, fields in ipairs(document:QuerySelectorAll(".mpe-port")) do
				local key = portKey(setup.midiPorts[tonumber(fields:GetAttribute("index"))])
				if changed[key] then
					fields:QuerySelector(".mpe-activity").inner_rml = activityRml(key)
				end
			end
		end

		-- The handler goes with the document: the next one that opens loads this script again.
		function setup.close()
			setup.document = nil
			if setup.subscribed then
				gnubase.off("midi.activity", setup.activityArrived)
				gnubase.midi.activityListen({on = false, listener = "studioSetup"})
				setup.subscribed = false
			end
		end

		-- Shows the selected MIDI input's MPE setup.
		function setup.showMpeInput(document, index)
			setup.mpeShown = portKey(setup.midiPorts[tonumber(index)])
			for _, fields in ipairs(document:QuerySelectorAll(".mpe-port")) do
				fields:SetClass("shown", fields:GetAttribute("index") == tostring(index))
			end
		end

		-- Use for Tuning sets X's Note Expression Assignment to tuning (reference manual p. 1297), which it keeps
		-- while on; off, X plays its own assignment again (the select's own attribute, #1749).
		function setup.mpeTuningChanged(element)
			local fieldElement = element.parent_node
			local x = fieldElement and fieldElement.parent_node and
				fieldElement.parent_node:QuerySelector("select.mpe-x-expression")
			if x == nil then
				return
			end
			if checked(element) then
				if valueOf(x) ~= "tuning" then
					x:SetAttribute("own", valueOf(x))
					x:SetAttribute("value", "tuning")
				end
				x:SetAttribute("disabled", "")
			else
				x:RemoveAttribute("disabled")
				if valueOf(x) == "tuning" then
					x:SetAttribute("value", x:GetAttribute("own") or "none")
				end
			end
		end

		-- Tuning chosen for X is Use for Tuning.
		function setup.mpeXExpressionChanged(element)
			local fieldElement = element.parent_node
			local tuning = fieldElement and fieldElement.parent_node and
				fieldElement.parent_node:QuerySelector("input.mpe-tuning")
			if valueOf(element) ~= "tuning" then
				element:SetAttribute("own", valueOf(element))
			elseif tuning ~= nil and not checked(tuning) then
				tuning:SetAttribute("checked", "")
			end
		end

		-- First Channel is only for channel rotation, Upper Zone Channels only for both zones (#1675). The page starts
		-- with them as the mode is; while it is built, the mode's select reports its value before they exist.
		function setup.mpeModeChanged(element)
			local mode = element:GetAttribute("value")
			for class, enabledIn in pairs{["mpe-first-channel"] = "rotation", ["mpe-upper-channels"] = "both"} do
				local select = element.parent_node.parent_node:QuerySelector("select." .. class)
				if select ~= nil and mode == enabledIn then
					select:RemoveAttribute("disabled")
				elseif select ~= nil then
					select:SetAttribute("disabled", "")
				end
			end
		end

		-- Shows the page that the devices list selects. A detected MPE device's ("mpe" and its port's index) is the
		-- Note Expression Input page with its input.
		function setup.show(document, page)
			local device = tonumber(page:match("^mpe(%d+)$"))
			if device ~= nil then
				page = "mpe"
				document:GetElementById("mpe-input"):SetAttribute("value", tostring(device))
				setup.showMpeInput(document, device)
			end
			for _, name in ipairs{"system", "device", "midi", "mpe"} do
				document:GetElementById("page-" .. name):SetClass("shown", name == page)
			end
		end

		-- Runs an engine command; a failure goes into errors instead of raising.
		local function call(errors, command, parameters)
			local ok, result = pcall(command, parameters)
			if not ok then
				errors[#errors + 1] = tostring(result)
			end
			return ok
		end

		-- The rows of a ports table with what they show now.
		local function rowsOf(document, id)
			local rows = {}
			for _, row in ipairs(document:QuerySelectorAll("#" .. id .. " tr")) do
				local allInputs = row:QuerySelector("input.all-inputs")
				rows[#rows + 1] = {row = row, showAs = valueOf(row:QuerySelector("input.show-as")) or "",
					visible = checked(row:QuerySelector("input.visible")), inAllInputs = allInputs and checked(allInputs)}
			end
			return rows
		end

		local function applyAudioDevice(document, errors, device)
			local changes = {}
			local sampleRate = tonumber(valueOf(document:GetElementById("sample-rate")))
			if sampleRate ~= nil and sampleRate ~= device.sampleRate then
				changes.sampleRate = sampleRate
			end
			local blockSize = math.tointeger(tonumber(valueOf(document:GetElementById("block-size"))))
			if blockSize ~= nil and blockSize ~= device.blockSize then
				changes.blockSize = blockSize
			end
			local clockSource = valueOf(document:GetElementById("clock-source"))
			if clockSource ~= nil and clockSource ~= "" and clockSource ~= device.clockSource then
				changes.clockSource = clockSource
			end
			local externallyClocked = checked(document:GetElementById("externally-clocked"))
			if externallyClocked ~= device.externallyClocked then
				changes.externallyClocked = externallyClocked
			end
			local directMonitoring = checked(document:GetElementById("direct-monitoring"))
			if directMonitoring ~= device.directMonitoring then
				changes.directMonitoring = directMonitoring
			end
			local recordShift = math.tointeger(tonumber(valueOf(document:GetElementById("record-shift"))))
			if recordShift == nil then
				errors[#errors + 1] = "Record Shift must be a whole number of samples"
			elseif recordShift ~= device.recordShift then
				changes.recordShift = recordShift
			end
			if next(changes) ~= nil then
				call(errors, gnubase.audio.set, changes)
			end

			local byName = {}
			for _, input in ipairs{true, false} do
				for _, port in ipairs(setup.audioPorts[input and "inputs" or "outputs"]) do
					byName[tostring(input) .. "/" .. port.name] = port
				end
			end
			for _, row in ipairs(rowsOf(document, "audio-ports")) do
				local name = tostring(row.row:GetAttribute("name"))
				local input = row.row:GetAttribute("input") == "true"
				local port = byName[tostring(input) .. "/" .. name]
				if port ~= nil and (row.showAs ~= port.showAs or row.visible ~= port.visible) then
					call(errors, gnubase.audio.setPort, {input = input, name = name,
						showAs = row.showAs == name and "" or row.showAs, visible = row.visible})
				end
			end
		end

		-- Sends what the pages changed. Returns the errors of the commands that failed.
		function setup.apply(document)
			local errors = {}
			local device = setup.status.device
			local driver = setup.drivers[tonumber(valueOf(document:GetElementById("driver")))]
			local fallback = setup.status.failed ~= nil
			if driver ~= nil and (device == nil or driver.backend ~= device.backend or driver.device ~= device.id) then
				-- Another driver: the pages showed the old device, whose settings don't apply to the new one. It runs if
				-- the old one ran, and the app opens it again when it starts.
				call(errors, gnubase.audio.setDevice, {backend = driver.backend, device = driver.device, remember = true})
			elseif driver ~= nil and fallback and setup.driverTouched then
				-- The fallback that plays for the device chosen last, which couldn't be used, picked in the list: Apply
				-- makes it the user's choice, with what the pages changed. Untouched, the choice stays for the next
				-- start.
				if call(errors, gnubase.audio.setDevice, {backend = driver.backend, device = driver.device,
					remember = true}) then
					applyAudioDevice(document, errors, gnubase.audio.get().device)
				end
			elseif device ~= nil then
				applyAudioDevice(document, errors, device)
			end

			local multiProcessing = checked(document:GetElementById("multi-processing"))
			if multiProcessing ~= setup.status.processing.multiProcessing then
				-- Processing threads change while the device stands.
				local running = gnubase.audio.get().running
				if running then
					call(errors, gnubase.audio.stop)
				end
				call(errors, gnubase.audio.setProcessing, {multiProcessing = multiProcessing})
				if running then
					call(errors, gnubase.audio.start)
				end
			end

			for _, row in ipairs(rowsOf(document, "midi-ports")) do
				local port = setup.midiPorts[tonumber(row.row:GetAttribute("index"))]
				local inAllInputs = nil -- outputs don't belong to all MIDI inputs
				if port.input then
					inAllInputs = row.inAllInputs
				end
				if row.showAs ~= port.showAs or row.visible ~= port.visible or
					(port.input and inAllInputs ~= port.inAllInputs) then
					call(errors, gnubase.midi.setPort, {backend = port.backend, id = port.id, input = port.input,
						showAs = row.showAs == port.name and "" or row.showAs, visible = row.visible,
						inAllInputs = inAllInputs})
				end
			end
			for _, fields in ipairs(document:QuerySelectorAll(".mpe-port")) do
				local port = setup.midiPorts[tonumber(fields:GetAttribute("index"))]
				local pitchRange = math.tointeger(tonumber(valueOf(fields:QuerySelector("input.mpe-pitch-range"))))
				if pitchRange == nil or pitchRange < 1 or pitchRange > 96 then
					errors[#errors + 1] = "Pitch Range must be a whole number of semitones from 1 to 96"
				else
					local mpe = {channels = math.tointeger(tonumber(valueOf(fields:QuerySelector("select.mpe-channels")))),
						firstChannel = math.tointeger(tonumber(valueOf(fields:QuerySelector("select.mpe-first-channel")))),
						upperChannels = math.tointeger(tonumber(valueOf(fields:QuerySelector("select.mpe-upper-channels")))),
						pitchRange = pitchRange, tuning = checked(fields:QuerySelector("input.mpe-tuning"))}
					for name, class in pairs(mpeSelects) do
						mpe[name] = valueOf(fields:QuerySelector("select." .. class))
					end
					-- Under Use for Tuning, X's own assignment.
					if mpe.tuning then
						mpe.xExpression = fields:QuerySelector("select.mpe-x-expression"):GetAttribute("own") or "none"
					end
					local changed = false
					for name, value in pairs(mpe) do
						changed = changed or port.mpe[name] ~= value
					end
					if changed then
						call(errors, gnubase.midi.setPort, {backend = port.backend, id = port.id, input = true, mpe = mpe})
					end
				end
			end
			return errors
		end

		-- Apply: sends the changes and shows what the engine made of them.
		function setup.applyAndLoad(document)
			local errors = setup.apply(document)
			setup.load(document)
			report(document, errors)
		end

		-- OK: sends the changes and closes, unless a command failed.
		function setup.ok(document)
			local errors = setup.apply(document)
			if #errors == 0 then
				document:Close()
			else
				setup.load(document)
				report(document, errors)
			end
		end

		function setup.reset(document)
			local errors = {}
			call(errors, gnubase.audio.reset)
			setup.load(document)
			report(document, errors)
		end

		function setup.controlPanel(document)
			local errors = {}
			call(errors, gnubase.audio.controlPanel)
			report(document, errors)
		end

		-- The ports' Reset: their system names and every port visible, sent with Apply or OK.
		function setup.resetPorts(document, id)
			for _, row in ipairs(document:QuerySelectorAll("#" .. id .. " tr")) do
				row:QuerySelector("input.show-as"):SetAttribute("value", row:GetAttribute("name"))
				row:QuerySelector("input.visible"):SetAttribute("checked", "")
			end
		end
	</script>
</head>
<body onload="StudioSetup.load(document)" onunload="StudioSetup.close()">
	<dialog id="studio-setup">
		<div class="dialog-titlebar">Studio Setup</div>
		<div class="content">
			<listview id="studio-devices" value="system" onchange="StudioSetup.show(document, element:GetAttribute('value'))">
				<listitem id="devices-system" value="system" class="selected">Audio System</listitem>
				<listitem id="devices-device" value="device">Audio Device</listitem>
				<listitem id="devices-midi" value="midi">MIDI Port Setup</listitem>
				<listitem id="devices-mpe" value="mpe">Note Expression Input</listitem>
			</listview>
			<div class="page shown" id="page-system"/>
			<div class="page" id="page-device"/>
			<div class="page" id="page-midi"/>
			<div class="page" id="page-mpe"/>
		</div>
		<div class="row">
			<div id="studio-setup-message"/>
			<button id="reset-device" title="Opens the audio device again" onclick="StudioSetup.reset(document)">Reset</button>
			<button id="apply" onclick="StudioSetup.applyAndLoad(document)">Apply</button>
			<button id="cancel" result="cancel">Cancel</button>
			<button id="ok" class="primary" onclick="StudioSetup.ok(document)">OK</button>
		</div>
	</dialog>
</body>
</rml>
