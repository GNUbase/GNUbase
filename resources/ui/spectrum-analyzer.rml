<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The Spectrum Analyzer (#147, docs/features/audio-functions.md, reference manual pp. 607-608) of the first audio
     event in the document's attribute events (ids): ui::EventDisplay opens it (audio.spectrumAnalyzer). Its Lua
     measures the section of the clip the event plays (clip.spectrum) and draws one channel as bars or all as curves,
     from -120 dB at the bottom to 0 dB at the top of #sa-graph, a bar per 1/24 octave from 20 Hz. The mouse over
     the graph shows the channel, frequency, note and level in #sa-value; a right click makes that frequency the one
     the difference D is measured from (.reference), and a click drops it. A clip whose file can't be read shows
     clip.spectrum's error in #sa-value instead, as Detect Silence and Statistics show theirs. -->
<rml>
<head>
	<title>Spectrum Analyzer</title>
	<style>
		dialog
		{
			width: 640dp;
		}

		.row, #sa-view
		{
			margin: 8dp 12dp 0 12dp;
		}

		.row
		{
			display: flex;
			align-items: center;
		}

		#sa-value
		{
			flex: 1;
			margin-left: 12dp;
		}

		#sa-graph
		{
			position: relative;
			height: 260dp;
		}

		#sa-view
		{
			overflow-x: auto;
		}

		#sa-zoom
		{
			width: 160dp;
			margin-left: 12dp;
		}

		.sa-graph.all .sa-bar
		{
			height: 2dp;
		}

		.sa-bar
		{
			position: absolute;
			bottom: 0;
		}

		.row button
		{
			margin-left: 6dp;
		}

		.buttons
		{
			justify-content: flex-end;
		}
	</style>
	<script src="analysis-job.lua"/>
	<script>
		SpectrumAnalyzer = {}
		local dialog = SpectrumAnalyzer
		local floor = -120 -- dB at the bottom of the graph

		local function escape(text)
			return (tostring(text):gsub('[&<>"]', {["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;"}))
		end

		local noteNames = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"}

		local function note(frequency)
			local nearest = math.floor(69 + (12 * math.log(frequency / 440, 2)) + 0.5)
			return noteNames[(nearest % 12) + 1] .. ((nearest // 12) - 2)
		end

		local function channelName(index, count)
			if count == 1 then
				return "Mono"
			end
			if count == 2 then
				return index == 1 and "Left" or "Right"
			end
			return "Channel " .. index
		end

		local function levelText(level)
			return level and string.format("%.1f dB", level) or "-oo dB"
		end

		-- One channel as bars, or every channel as a separate thin curve.
		local function draw(document)
			local width = 100 / #dialog.result.frequencies
			local bars = {}
			for c, channel in ipairs(dialog.result.channels) do
				if dialog.channel == 0 or dialog.channel == c then
					for i = 1, #channel.levels do
						local level = channel.levels[i]
						local height = level and math.max(0, math.min(100, (level - floor) * 100 / -floor)) or 0
						local reference = dialog.reference and dialog.reference.index == i and dialog.reference.channel == c
						bars[#bars + 1] = string.format(
							'<div class="sa-bar channel-%d%s" channel="%d" index="%d" ' ..
							'style="left: %.4f%%; width: %.4f%%; %s: %.4f%%"/>',
							c, reference and " reference" or "", c, i, (i - 1) * width, width,
							dialog.channel == 0 and "bottom" or "height", height)
					end
				end
			end
			local graph = document:GetElementById("sa-graph")
			graph:SetClass("all", dialog.channel == 0)
			graph.inner_rml = table.concat(bars)
		end

		function dialog.zoom(document)
			local zoom = tonumber(tostring(document:GetElementById("sa-zoom"):GetAttribute("value"))) or 1
			document:GetElementById("sa-graph").style.width = (zoom * 100) .. "%"
		end

		function dialog.load(document)
			local first = tonumber(tostring(document:GetAttribute("events") or ""):match("%d+"))
			local event = nil
			for _, each in ipairs(gnubase.project.get().audioEvents) do
				if each.id == first then
					event = each
				end
			end
			if event == nil then
				document:Close()
				return
			end
			dialog.result = nil
			dialog.job = createAnalysisJob(function(text)
				document:GetElementById("sa-value").inner_rml = escape(text)
			end)
			dialog.job.start(gnubase.clip.spectrum, {clip = event.clip, start = event.offset,
				["end"] = event.offset + event.length}, function(ok, result)
				if not ok then
					dialog.result = nil
					document:GetElementById("sa-value").inner_rml = escape(tostring(result))
					return
				end
				dialog.result = result
				local count = #dialog.result.channels
				local options = {}
				for i = 1, count do
					options[#options + 1] = '<option value="' .. i .. '"' .. (i == 1 and " selected" or "") .. ">" ..
						escape(channelName(i, count)) .. "</option>"
				end
				if count > 1 then
					options[#options + 1] = '<option value="0">All Channels</option>'
				end
				document:GetElementById("sa-channel").inner_rml = table.concat(options)
				dialog.channel = 1
				dialog.reference = nil
				draw(document)
			end)
		end

		function dialog.chooseChannel(document)
			local value = tonumber(tostring(document:GetElementById("sa-channel"):GetAttribute("value") or ""))
			if value and dialog.result and (value == 0 or dialog.result.channels[value]) then
				dialog.channel = value
				draw(document)
			end
		end

		-- Content coordinates, including the horizontal scroll of a zoomed graph.
		local function origin(graph)
			local left = graph.client_left
			local top = graph.client_top
			local element = graph
			while element do
				left = left + element.offset_left
				top = top + element.offset_top
				element = element.offset_parent
				if element then
					left = left - element.scroll_left
					top = top - element.scroll_top
				end
			end
			return left, top
		end

		local function barAt(graph, x)
			local left = origin(graph)
			local count = #dialog.result.frequencies
			local index = math.floor((x - left) * count / graph.client_width) + 1
			return math.max(1, math.min(count, index))
		end

		-- The value field: channel, frequency, note and level at the bar, and the difference to the reference bar.
		function dialog.show(document, index, channel)
			local frequency = dialog.result.frequencies[index]
			local levels = dialog.result.channels[channel].levels
			local text = string.format("%s  %.1f Hz  %s  %s", channelName(channel, #dialog.result.channels),
				frequency, note(frequency), levelText(levels[index]))
			if dialog.reference then
				local from = dialog.result.channels[dialog.reference.channel].levels[dialog.reference.index]
				local to = levels[index]
				text = text .. "  D: " .. ((from and to) and string.format("%.1f dB", to - from) or "-")
			end
			document:GetElementById("sa-value"):SetAttribute("index", tostring(index))
			document:GetElementById("sa-value").inner_rml = escape(text)
		end

		local function channelAt(graph, index, y)
			if dialog.channel ~= 0 then return dialog.channel end
			local _, top = origin(graph)
			local level = floor + (1 - ((y - top) / graph.client_height)) * -floor
			local channel, distance = 1, math.huge
			for c, each in ipairs(dialog.result.channels) do
				local delta = math.abs((each.levels[index] or floor) - level)
				if delta < distance then channel, distance = c, delta end
			end
			return channel
		end

		function dialog.move(document, event)
			if dialog.result then
				local graph = document:GetElementById("sa-graph")
				local index = barAt(graph, event.parameters.mouse_x)
				dialog.show(document, index, channelAt(graph, index, event.parameters.mouse_y))
			end
		end

		-- A right click picks the reference, a click drops it.
		function dialog.press(document, event)
			if not dialog.result then
				return
			end
			local graph = document:GetElementById("sa-graph")
			local index = barAt(graph, event.parameters.mouse_x)
			local channel = channelAt(graph, index, event.parameters.mouse_y)
			dialog.reference = event.parameters.button == 1 and {index = index, channel = channel} or nil
			draw(document)
			dialog.show(document, index, channel)
		end
	</script>
</head>
<body onshow="SpectrumAnalyzer.load(document)" onunload="if SpectrumAnalyzer.job then SpectrumAnalyzer.job.close() end">
	<dialog id="spectrum-analyzer-dialog">
		<div class="dialog-titlebar">Spectrum Analyzer</div>
		<div class="row">
			<select id="sa-channel" onchange="SpectrumAnalyzer.chooseChannel(document)"/>
			<div id="sa-value"/>
		</div>
		<div id="sa-view">
			<div id="sa-graph" class="sa-graph" onmousemove="SpectrumAnalyzer.move(document, event)"
				onmousedown="SpectrumAnalyzer.press(document, event)"/>
		</div>
		<div class="row buttons">
			<label for="sa-zoom">Zoom</label>
			<slider id="sa-zoom" min="1" max="8" step="1" value="1" onchange="SpectrumAnalyzer.zoom(document)"/>
			<button id="sa-close" class="primary" result="ok">Close</button>
		</div>
	</dialog>
</body>
</rml>
