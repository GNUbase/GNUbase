<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The rule editor and the project input transformer (#178, docs/features/midi-rules.md, reference manual pp.
     1392-1423), and the project rule editor (#179, docs/features/project-rules.md, pp. 1424-1445). app::AppUi opens
     it with the document's attributes parts and notes (ids separated by commas) for the rule editor, target="project"
     for the project input transformer, target="track" with track="id" for a track's input transformer (#966), or
     target="projectRules" for the project rule editor, which runs
     project.applyRules or project.findByRules on the project window's selection (gnubase.ui.projectSelection and
     gnubase.ui.selectInProject) between its pre and post commands (gnubase.ui.command). Its Lua shows the presets, the filter lines,
     the function and the action lines, and runs the engine's commands: Apply runs midi.applyRules (select:
     midi.findByRules, which shows how many events it found) or, for the input transformers, sets the modules edited
     with midi.setInputTransformer or the track's channel.set; Save Preset runs midiRules.savePreset. An asterisk after
     the preset says that the lines differ from it. A command the engine refuses keeps the dialog open
     with its message; Cancel closes it. -->
<rml>
<head>
	<title>Rule Editor</title>
	<style>
		dialog
		{
			width: 760dp;
		}

		.rule-row
		{
			display: flex;
			align-items: center;
			margin: 6dp 12dp 0 12dp;
		}

		.rule-row .label
		{
			width: 90dp;
		}

		.rule-row select, .rule-row input.text
		{
			width: 110dp;
			margin-right: 4dp;
		}

		.rule-row select.bracket
		{
			width: 50dp;
		}

		.rule-row select.join
		{
			width: 60dp;
		}

		.rule-row input.text.number
		{
			width: 70dp;
		}

		.rule-heading
		{
			margin: 10dp 12dp 0 12dp;
		}

		#rule-editor-message
		{
			flex: 1;
		}

		.rule-row button
		{
			margin-left: 6dp;
		}
	</style>
	<script>
		-- The dialog's state, in the UI's Lua.
		RuleEditor = {}
		local editor = RuleEditor

		local targets = {{"position", "Position"}, {"length", "Length"}, {"subtype", "Subtype"},
			{"mainValue", "Main Value"}, {"channel", "Channel"}, {"type", "Type"}, {"secondaryValue", "Secondary Value"}}
		local conditions = {{"equal", "Equal"}, {"unequal", "Unequal"}, {"bigger", "Bigger"},
			{"biggerOrEqual", "Bigger or Equal"}, {"less", "Less"}, {"lessOrEqual", "Less or Equal"},
			{"insideRange", "Inside Range"}, {"outsideRange", "Outside Range"}, {"noteIsEqualTo", "Note is Equal to"}}
		local types = {{"note", "Note"}, {"polyPressure", "Poly Pressure"}, {"controller", "Controller"},
			{"program", "Program Change"}, {"aftertouch", "Aftertouch"}, {"pitchBend", "Pitchbend"}}
		local operations = {{"add", "Add"}, {"subtract", "Subtract"}, {"multiplyBy", "Multiply by"},
			{"divideBy", "Divide by"}, {"roundBy", "Round by"}, {"setRandom", "Set Random Values Between"},
			{"setFixed", "Set to Fixed Value"}, {"setRelativeRandom", "Set Relative Random Values Between"},
			{"useSubtype", "Use Subtype"}, {"useMainValue", "Use Main Value"}, {"mirror", "Mirror"},
			{"transposeToScale", "Transpose to Scale"}, {"addLength", "Add Length"}}
		local scales = {{"major", "Major"}, {"minor", "Minor"}, {"harmonicMinor", "Harmonic Minor"},
			{"melodicMinor", "Melodic Minor"}, {"dorian", "Dorian"}, {"phrygian", "Phrygian"}, {"lydian", "Lydian"},
			{"mixolydian", "Mixolydian"}, {"locrian", "Locrian"}, {"majorPentatonic", "Major Pentatonic"},
			{"minorPentatonic", "Minor Pentatonic"}, {"blues", "Blues"}, {"wholeTone", "Whole Tone"}}
		local opens = {{"0", ""}, {"1", "("}, {"2", "(("}, {"3", "((("}}
		local closes = {{"0", ""}, {"1", ")"}, {"2", "))"}, {"3", ")))"}}
		local joins = {{"and", "And"}, {"or", "Or"}}
		-- The project rule editor's.
		local projectTargets = {{"mediaType", "Media Type"}, {"containerType", "Container Type"}, {"name", "Name"},
			{"position", "Position"}, {"length", "Length"}, {"colorName", "Color Name"}, {"property", "Property"}}
		local projectConditions = {{"equal", "Equal"}, {"unequal", "Unequal"}, {"bigger", "Bigger"},
			{"biggerOrEqual", "Bigger or Equal"}, {"less", "Less"}, {"lessOrEqual", "Less or Equal"},
			{"insideRange", "Inside Range"}, {"outsideRange", "Outside Range"}, {"allTypes", "All Types"},
			{"propertyIsSet", "Property is Set"}, {"propertyIsNotSet", "Property is Not Set"},
			{"contains", "Contains"}, {"containsNot", "Contains Not"}}
		local mediaTypes = {{"audio", "Audio"}, {"midi", "MIDI"}, {"marker", "Marker"}, {"tempo", "Tempo"},
			{"signature", "Signature"}, {"arranger", "Arranger"}, {"transpose", "Transpose"}, {"chord", "Chord"},
			{"group", "Group"}, {"effect", "Effect"}, {"vca", "VCA"}}
		local containerTypes = {{"folder", "Folder Track"}, {"track", "Track"}, {"part", "Part"}, {"event", "Event"}}
		local properties = {{"isMuted", "Is Muted"}, {"isSelected", "Is Selected"}, {"isEmpty", "Is Empty"},
			{"isHidden", "Is Hidden"}, {"hasTrackVersion", "Has Track Version"},
			{"followsChordTrack", "Follows Chord Track"}, {"isDisabled", "Is Disabled"},
			{"parentIsSelected", "Parent Object Is Selected"}}
		local actionTargets = {{"position", "Position"}, {"length", "Length"},
			{"trackOperation", "Track Operation"}, {"name", "Name"}, {"color", "Set Color"}}
		local projectOperations = {{"add", "Add"}, {"subtract", "Subtract"}, {"multiplyBy", "Multiply by"},
			{"divideBy", "Divide by"}, {"roundBy", "Round by"}, {"setRandom", "Set Random Values Between"},
			{"setRelativeRandom", "Set Relative Random Values Between"}, {"setFixed", "Set to Fixed Value"},
			{"replace", "Replace"}, {"append", "Append"}, {"prepend", "Prepend"}, {"generateName", "Generate Name"},
			{"replaceSearchString", "Replace Search String"}, {"eraseBefore", "Erase Before"},
			{"eraseAfter", "Erase After"}, {"eraseFrontCharacter", "Erase Front Character"},
			{"eraseEndCharacter", "Erase End Character"}, {"mute", "Mute"}, {"solo", "Solo"}, {"record", "Record"},
			{"monitor", "Monitor"}, {"timeDomain", "Time Domain"}, {"increment", "Increment"},
			{"decrement", "Decrement"}}
		local switches = {{"on", "On"}, {"off", "Off"}, {"toggle", "Toggle"}}
		local timeDomains = {{"musical", "Musical"}, {"linear", "Linear"}, {"toggle", "Toggle"}}

		local function escape(text)
			return (tostring(text):gsub('[&<>"]', {["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;"}))
		end

		local function dropDown(id, choices, value, class, onchange)
			local options = {}
			for index, choice in ipairs(choices) do
				local on = tostring(value) == choice[1] or (value == nil and index == 1)
				options[#options + 1] = '<option value="' .. escape(choice[1]) .. '"' .. (on and " selected" or "") ..
					">" .. escape(choice[2]) .. "</option>"
			end
			return '<select id="rule-editor-' .. id .. '"' .. (class and (' class="' .. class .. '"') or "") ..
				(onchange and (' onchange="' .. onchange .. '"') or "") .. ">" .. table.concat(options) ..
				"</select>"
		end

		local function text(id, value)
			return '<input type="text" class="text number" id="rule-editor-' .. id .. '" value="' ..
				escape(value or 0) .. '"/>'
		end

		local function textField(id, value)
			return '<input type="text" class="text" id="rule-editor-' .. id .. '" value="' .. escape(value or "") ..
				'"/>'
		end

		local function element(document, id)
			return document:GetElementById("rule-editor-" .. id)
		end

		local function valueOf(document, id)
			local found = element(document, id)
			local value = found and found:GetAttribute("value")
			return value ~= nil and tostring(value) or ""
		end

		-- A number from a text field; with strict, an error naming it if it isn't one, else 0.
		local function number(document, id, name, strict)
			local value = tonumber(valueOf(document, id))
			if value == nil then
				if strict then
					error(name .. " must be a number", 0)
				end
				return 0
			end
			return math.tointeger(value) or value
		end

		local function ids(text)
			local list = {}
			for id in tostring(text or ""):gmatch("%d+") do
				list[#list + 1] = math.tointeger(tonumber(id))
			end
			return list
		end

		local function functionsFor()
			if editor.project then
				return {{"delete", "Delete"}, {"transform", "Transform"}, {"select", "Select"},
					{"deselect", "Deselect"}}
			end
			if editor.input then
				return {{"delete", "Filter"}, {"transform", "Transform"}, {"insert", "Insert"},
					{"insertExclusive", "Insert Exclusive"}}
			end
			return {{"delete", "Delete"}, {"transform", "Transform"}, {"insert", "Insert"},
				{"insertExclusive", "Insert Exclusive"}, {"select", "Select"}}
		end

		-- Live events have no position or length, so the input transformer leaves them out, unless a preset's line
		-- has them: then the engine says why it refuses the rules.
		local function targetsFor(current)
			if editor.project then
				return projectTargets
			end
			if not editor.input then
				return targets
			end
			local list = {}
			for _, target in ipairs(targets) do
				if (target[1] ~= "position" and target[1] ~= "length") or target[1] == current then
					list[#list + 1] = target
				end
			end
			return list
		end

		local function isOneOf(value, choices)
			for _, choice in ipairs(choices) do
				if choice[1] == value then
					return true
				end
			end
			return false
		end

		-- The project rule editor's choices for a filter line's parameter 1, or nil for a text or number field.
		local function filterChoices(target)
			return ({mediaType = mediaTypes, containerType = containerTypes, property = properties})[target]
		end

		local function isTextTarget(target)
			return target ~= "position" and target ~= "length"
		end

		local function projectFilterValues(prefix, line)
			local choices = filterChoices(line.target)
			if choices then
				return dropDown(prefix .. "p1", choices, line.parameter1)
			elseif isTextTarget(line.target) then
				return textField(prefix .. "p1", type(line.parameter1) == "string" and line.parameter1 or "")
			end
			return text(prefix .. "p1", tonumber(line.parameter1) or 0) .. text(prefix .. "p2", line.parameter2)
		end

		local function projectActionValues(prefix, line)
			local p1 = type(line.parameter1) == "string" and line.parameter1 or ""
			if line.target == "position" or line.target == "length" then
				return text(prefix .. "p1", tonumber(line.parameter1) or 0) .. text(prefix .. "p2", line.parameter2)
			elseif line.target == "trackOperation" then
				return dropDown(prefix .. "p1", line.operation == "timeDomain" and timeDomains or switches, p1)
			elseif line.target == "name" then
				local p2 = ""
				if line.operation == "replaceSearchString" then
					p2 = textField(prefix .. "p2", type(line.parameter2) == "string" and line.parameter2 or "")
				elseif line.operation == "generateName" then
					p2 = text(prefix .. "p2", tonumber(line.parameter2) or 1)
				end
				return textField(prefix .. "p1", p1) .. p2
			end
			return line.operation == "setFixed" and textField(prefix .. "p1", p1) or ""
		end

		-- A line's parameters, whose fields depend on its target and operation.
		local function filterValues(prefix, line)
			if editor.project then
				return projectFilterValues(prefix, line)
			end
			if line.target == "type" then
				return dropDown(prefix .. "p1", types, line.parameter1) .. text(prefix .. "p2", 0)
			end
			return text(prefix .. "p1", line.parameter1) .. text(prefix .. "p2", line.parameter2)
		end

		local function actionValues(prefix, line)
			if editor.project then
				return projectActionValues(prefix, line)
			end
			local p1 = line.target == "type" and dropDown(prefix .. "p1", types, line.parameter1) or
				text(prefix .. "p1", line.parameter1)
			local p2 = line.operation == "transposeToScale" and dropDown(prefix .. "p2", scales, line.parameter2) or
				text(prefix .. "p2", line.parameter2)
			return p1 .. p2
		end

		-- A line starts with a check box that picks it for Remove. A change of target or operation makes its
		-- parameters' fields anew (RuleEditor.retarget), leaving the drop-down list that announced it in place.
		local function filterRow(index, line)
			local prefix = "filter-" .. index .. "-"
			local retarget = "RuleEditor.retarget(document, 'filter', " .. index .. ")"
			return '<div class="rule-row"><input type="checkbox" id="rule-editor-' .. prefix .. 'pick"/>' ..
				dropDown(prefix .. "open", opens, line.open or 0, "bracket") ..
				dropDown(prefix .. "target", targetsFor(line.target), line.target, nil, retarget) ..
				dropDown(prefix .. "condition", editor.project and projectConditions or conditions, line.condition) .. '<span id="rule-editor-' .. prefix ..
				'values">' .. filterValues(prefix, line) .. "</span>" ..
				dropDown(prefix .. "close", closes, line.close or 0, "bracket") ..
				dropDown(prefix .. "join", joins, line.join or "and", "join") .. "</div>"
		end

		local function actionRow(index, line)
			local prefix = "action-" .. index .. "-"
			local retarget = "RuleEditor.retarget(document, 'action', " .. index .. ")"
			return '<div class="rule-row"><input type="checkbox" id="rule-editor-' .. prefix .. 'pick"/>' ..
				dropDown(prefix .. "target", editor.project and actionTargets or targetsFor(line.target), line.target,
					nil, retarget) ..
				dropDown(prefix .. "operation", editor.project and projectOperations or operations, line.operation, nil,
					retarget) .. '<span id="rule-editor-' ..
				prefix .. 'values">' .. actionValues(prefix, line) .. "</span></div>"
		end

		-- Fields are made anew from the rules; drop-down lists announce a change while they are made, which the
		-- handlers ignore (building).
		local function render(document)
			editor.building = true
			local rows = {}
			for index, line in ipairs(editor.rules.filters) do
				rows[#rows + 1] = filterRow(index, line)
			end
			element(document, "filters").inner_rml = table.concat(rows)
			rows = {}
			for index, line in ipairs(editor.rules.actions) do
				rows[#rows + 1] = actionRow(index, line)
			end
			element(document, "actions").inner_rml = table.concat(rows)
			element(document, "function-field").inner_rml =
				dropDown("function", functionsFor(), editor.rules["function"])
			if editor.project then
				rows = {}
				for _, list in ipairs({"pre", "post"}) do
					local fields = {'<span class="label">' .. (list == "pre" and "Pre" or "Post") .. "</span>"}
					for index = 1, 4 do
						local command = (editor.rules[list] or {})[index]
						fields[#fields + 1] = textField(list .. "-" .. index, command and command.command or "")
					end
					rows[#rows + 1] = '<div class="rule-row">' .. table.concat(fields) .. "</div>"
				end
				element(document, "commands").inner_rml = table.concat(rows)
			end
			editor.building = false
		end

		-- A line's parameter as its field has it: with choices, a name from its drop-down list (fallback if the
		-- field is a text field still), else a number.
		local function parameter(document, id, name, choices, fallback, strict)
			local value = valueOf(document, id)
			if choices ~= nil then
				return isOneOf(value, choices) and value or fallback
			end
			if isOneOf(value, types) or isOneOf(value, scales) then
				return 0
			end
			return number(document, id, name, strict)
		end

		-- A key command list as the fields show it: a command keeps its parameters while its name stays.
		local function readCommands(document, list)
			local commands = {}
			for index = 1, 4 do
				local name = valueOf(document, list .. "-" .. index)
				if name ~= "" then
					local before = (editor.rules[list] or {})[index]
					commands[#commands + 1] = {command = name,
						parameters = before and before.command == name and before.parameters or nil}
				end
			end
			return commands
		end

		local function readProject(document, strict)
			local rules = {filters = {}, actions = {}, ["function"] = valueOf(document, "function"),
				pre = readCommands(document, "pre"), post = readCommands(document, "post")}
			for index = 1, #editor.rules.filters do
				local prefix = "filter-" .. index .. "-"
				local name = "Filter line " .. index
				local line = {open = number(document, prefix .. "open", name, false),
					target = valueOf(document, prefix .. "target"),
					condition = valueOf(document, prefix .. "condition"),
					close = number(document, prefix .. "close", name, false), join = valueOf(document, prefix .. "join"),
					parameter2 = 0}
				local choices = filterChoices(line.target)
				if choices then
					local value = valueOf(document, prefix .. "p1")
					line.parameter1 = isOneOf(value, choices) and value or choices[1][1]
				elseif isTextTarget(line.target) then
					line.parameter1 = valueOf(document, prefix .. "p1")
				else
					line.parameter1 = number(document, prefix .. "p1", name .. ": Parameter 1", strict)
					line.parameter2 = number(document, prefix .. "p2", name .. ": Parameter 2", strict)
				end
				rules.filters[index] = line
			end
			for index = 1, #editor.rules.actions do
				local prefix = "action-" .. index .. "-"
				local name = "Action line " .. index
				local line = {target = valueOf(document, prefix .. "target"),
					operation = valueOf(document, prefix .. "operation"), parameter1 = "", parameter2 = 0}
				if line.target == "position" or line.target == "length" then
					line.parameter1 = number(document, prefix .. "p1", name .. ": Parameter 1", strict)
					line.parameter2 = number(document, prefix .. "p2", name .. ": Parameter 2", strict)
				else
					line.parameter1 = valueOf(document, prefix .. "p1")
					if line.operation == "replaceSearchString" then
						line.parameter2 = valueOf(document, prefix .. "p2")
					elseif line.operation == "generateName" then
						line.parameter2 = number(document, prefix .. "p2", name .. ": Parameter 2", strict)
					end
				end
				rules.actions[index] = line
			end
			return rules
		end

		-- The rules the dialog shows; with strict, an error for a value that isn't a number.
		local function read(document, strict)
			if editor.project then
				return readProject(document, strict)
			end
			local rules = {filters = {}, actions = {}, ["function"] = valueOf(document, "function")}
			for index = 1, #editor.rules.filters do
				local prefix = "filter-" .. index .. "-"
				local name = "Filter line " .. index
				local line = {open = number(document, prefix .. "open", name, false),
					target = valueOf(document, prefix .. "target"),
					condition = valueOf(document, prefix .. "condition"),
					close = number(document, prefix .. "close", name, false), join = valueOf(document, prefix .. "join")}
				local isType = line.target == "type"
				line.parameter1 = parameter(document, prefix .. "p1", name .. ": Parameter 1", isType and types or nil,
					"note", strict)
				line.parameter2 = parameter(document, prefix .. "p2", name .. ": Parameter 2", nil, 0,
					strict and not isType)
				rules.filters[index] = line
			end
			for index = 1, #editor.rules.actions do
				local prefix = "action-" .. index .. "-"
				local name = "Action line " .. index
				local line = {target = valueOf(document, prefix .. "target"),
					operation = valueOf(document, prefix .. "operation")}
				if line.target == "type" then
					line.operation = "setFixed"
				end
				line.parameter1 = parameter(document, prefix .. "p1", name .. ": Parameter 1",
					line.target == "type" and types or nil, "note", strict)
				line.parameter2 = parameter(document, prefix .. "p2", name .. ": Parameter 2",
					line.operation == "transposeToScale" and scales or nil, "major", strict)
				rules.actions[index] = line
			end
			return rules
		end

		-- The rules as the engine takes them: an empty Lua table would be an object, so empty lists are left out.
		local function engineRules(rules)
			local function list(items)
				return items and #items > 0 and items or nil
			end
			return {filters = list(rules.filters), actions = list(rules.actions), ["function"] = rules["function"],
				pre = list(rules.pre), post = list(rules.post)}
		end

		local function copy(rules)
			local result = {filters = {}, actions = {}, ["function"] = rules["function"] or "transform",
				pre = rules.pre or {}, post = rules.post or {}}
			for index, line in ipairs(rules.filters or {}) do
				result.filters[index] = line
			end
			for index, line in ipairs(rules.actions or {}) do
				result.actions[index] = line
			end
			return result
		end

		-- Whether input transformers take rules: they don't select, and live events have no position or length.
		local function live(rules)
			if rules["function"] == "select" then
				return false
			end
			for _, list in ipairs({rules.filters or {}, rules.actions or {}}) do
				for _, line in ipairs(list) do
					if line.target == "position" or line.target == "length" then
						return false
					end
				end
			end
			return true
		end

		-- The presets, for an input transformer those it can apply (#969).
		local function showPresets(document, chosen)
			editor.presets = {}
			for _, preset in ipairs((editor.project and gnubase.projectRules or gnubase.midiRules).presets().presets) do
				if not editor.input or live(preset.rules) then
					editor.presets[#editor.presets + 1] = preset
				end
			end
			local choices = {{"", ""}}
			for _, preset in ipairs(editor.presets) do
				choices[#choices + 1] = {preset.name, preset.name}
			end
			editor.building = true
			element(document, "preset-field").inner_rml =
				dropDown("preset", choices, chosen, nil, "RuleEditor.choose(document)")
			editor.building = false
		end

		-- Whether two values are alike: numbers by value, tables by their keys.
		local function same(a, b)
			if type(a) == "table" and type(b) == "table" then
				for key, value in pairs(a) do
					if not same(value, b[key]) then
						return false
					end
				end
				for key in pairs(b) do
					if a[key] == nil then
						return false
					end
				end
				return true
			end
			return a == b
		end

		-- The asterisk after the preset while the lines differ from it.
		function editor.changed(document)
			if editor.building then
				return
			end
			local modified = editor.baseline ~= nil and not same(editor.baseline, read(document, false))
			element(document, "modified").inner_rml = modified and "*" or ""
		end

		-- What the dialog shows now is the preset chosen, to compare the lines with.
		local function remember(document)
			editor.baseline = valueOf(document, "preset") ~= "" and read(document, false) or nil
			editor.changed(document)
		end

		-- The input transformer's modules, as the engine has them: the project's or the track's channel's.
		local function engineModules()
			local project = gnubase.project.get()
			if not editor.track then
				return project.inputTransformer
			end
			for _, track in ipairs(project.tracks) do
				if track.id == editor.track then
					for _, channel in ipairs(project.channels) do
						if channel.id == track.channel and channel.inputTransformer then
							editor.channel = channel.id
							return channel.inputTransformer.modules
						end
					end
				end
			end
			error("The track has no input transformer", 0)
		end

		-- A module as the dialog shows it, with the edits made to it before another module was shown.
		local function showModule(document)
			local edit = editor.edits[editor.module]
			if edit then
				editor.rules = copy(edit.rules)
			else
				local module = engineModules()[editor.module] or {}
				edit = {on = module.on, preset = ""}
				editor.rules = copy(module.rules or {})
			end
			element(document, "on-field").inner_rml = '<input type="checkbox" id="rule-editor-on"' ..
				(edit.on and " checked" or "") .. '/><span class="label">On</span>'
			showPresets(document, edit.preset)
			element(document, "name"):SetAttribute("value", edit.preset or "")
			render(document)
			editor.baseline = edit.baseline
			editor.changed(document)
		end

		function editor.load(document)
			editor.parts = ids(document:GetAttribute("parts"))
			editor.notes = ids(document:GetAttribute("notes"))
			local target = tostring(document:GetAttribute("target") or "")
			editor.input = target == "project" or target == "track"
			editor.track = target == "track" and ids(document:GetAttribute("track"))[1] or nil
			editor.project = target == "projectRules"
			editor.rules = copy({})
			editor.edits = {}
			editor.baseline = nil
			element(document, "title").inner_rml = editor.track and "Track Input Transformer" or
				(editor.input and "Project Input Transformer" or
					(editor.project and "Project Rule Editor" or "Rule Editor"))
			element(document, "apply").inner_rml = editor.input and "OK" or "Apply"
			showPresets(document, nil)
			if editor.input then
				editor.module = 1
				editor.building = true
				element(document, "module-field").inner_rml = '<span class="label">Module</span>' ..
					dropDown("module", {{"1", "1"}, {"2", "2"}, {"3", "3"}, {"4", "4"}}, "1", nil,
						"RuleEditor.chooseModule(document)") .. '<span id="rule-editor-on-field"/>'
				editor.building = false
				showModule(document)
			else
				render(document)
			end
		end

		-- Makes a line's parameters' fields anew for its target and operation.
		function editor.retarget(document, kind, index)
			if editor.building then
				return
			end
			local prefix = kind .. "-" .. index .. "-"
			local rules = read(document, false)
			local line = (kind == "filter" and rules.filters or rules.actions)[index]
			editor.building = true
			element(document, prefix .. "values").inner_rml =
				kind == "filter" and filterValues(prefix, line) or actionValues(prefix, line)
			editor.building = false
			editor.changed(document)
		end

		function editor.insert(document, list)
			editor.rules = read(document, false)
			local line = list == "filters" and {open = 0, target = "type", condition = "equal", parameter1 = "note",
				parameter2 = 0, close = 0, join = "and"} or {target = "subtype", operation = "add", parameter1 = 0,
				parameter2 = 0}
			if editor.project then
				line = list == "filters" and {open = 0, target = "containerType", condition = "equal",
					parameter1 = "part", parameter2 = 0, close = 0, join = "and"} or {target = "position",
					operation = "add", parameter1 = 0, parameter2 = 0}
			end
			table.insert(editor.rules[list], line)
			render(document)
			editor.changed(document)
		end

		-- Removes the lines picked, or the last one if none is.
		function editor.remove(document, list)
			editor.rules = read(document, false)
			local kind = list == "filters" and "filter-" or "action-"
			local kept = {}
			for index, line in ipairs(editor.rules[list]) do
				if not element(document, kind .. index .. "-pick"):HasAttribute("checked") then
					kept[#kept + 1] = line
				end
			end
			if #kept == #editor.rules[list] then
				table.remove(kept)
			end
			editor.rules[list] = kept
			render(document)
			editor.changed(document)
		end

		function editor.choose(document)
			if editor.building then
				return
			end
			local name = valueOf(document, "preset")
			for _, preset in ipairs(editor.presets) do
				if preset.name == name then
					editor.rules = copy(preset.rules)
					element(document, "name"):SetAttribute("value", name)
					render(document)
					remember(document)
					return
				end
			end
		end

		local function message(document, text)
			element(document, "message").inner_rml = escape(text)
		end

		-- Keeps the edits of the module shown while another one shows; a value that isn't a number keeps it shown
		-- with the message.
		local function keepModule(document)
			local ok, rules = pcall(read, document, true)
			if not ok then
				message(document, rules)
				return false
			end
			editor.edits[editor.module] = {on = element(document, "on"):HasAttribute("checked"), rules = rules,
				preset = valueOf(document, "preset"), baseline = editor.baseline}
			return true
		end

		function editor.chooseModule(document)
			if editor.building then
				return
			end
			if not keepModule(document) then
				editor.building = true
				element(document, "module"):SetAttribute("value", tostring(editor.module))
				editor.building = false
				return
			end
			editor.module = math.tointeger(tonumber(valueOf(document, "module"))) or 1
			message(document, "")
			showModule(document)
		end

		function editor.save(document)
			local ok, failure = pcall(function()
				local name = valueOf(document, "name")
				local presets = editor.project and gnubase.projectRules or gnubase.midiRules
				presets.savePreset({name = name, rules = engineRules(read(document, true))})
				showPresets(document, name)
				remember(document)
			end)
			message(document, ok and "Preset saved" or failure)
		end

		-- Key commands in order: an engine command through its Lua function, which returns once it ran, a UI command
		-- as its keys would run it.
		local function runCommands(commands)
			for _, command in ipairs(commands or {}) do
				local area, action = command.command:match("^([^.]+)%.(.+)$")
				local engine = area and area ~= "ui" and type(gnubase[area]) == "table" and gnubase[area][action]
				if type(engine) == "function" then
					engine(command.parameters or {})
				else
					gnubase.ui.command({command = command.command, parameters = command.parameters})
				end
			end
		end

		-- The pre commands, the rules on the project window's selection as it is then, and the post commands.
		local function applyProject(rules)
			runCommands(rules.pre)
			local parameters = {rules = rules}
			local selection = gnubase.ui.projectSelection()
			local selected = {}
			for _, list in ipairs({selection.tracks or {}, selection.events or {}, selection.markers or {}}) do
				for _, id in ipairs(list) do
					selected[#selected + 1] = id
				end
			end
			if #selected > 0 then
				parameters.selected = selected
			end
			if rules["function"] == "deselect" then
				gnubase.ui.selectInProject({})
			elseif rules["function"] == "select" then
				local found = gnubase.project.findByRules(parameters)
				gnubase.ui.selectInProject({tracks = found.tracks, events = found.events, markers = found.markers})
			else
				gnubase.project.applyRules(parameters)
			end
			runCommands(rules.post)
			return true
		end

		local function apply(document)
			if editor.input then
				-- Every module edited, up to the last one; the ones before it that weren't stay as they are. The shown
				-- module is read once, by keepModule (#1203).
				local current = engineModules()
				if not keepModule(document) then
					return false
				end
				local last = 0
				for index in pairs(editor.edits) do
					last = math.max(last, index)
				end
				local modules = {}
				for index = 1, last do
					local edit = editor.edits[index]
					modules[index] = edit and {on = edit.on, rules = engineRules(edit.rules)} or
						{on = current[index].on}
				end
				local ok, failure = pcall(function()
					if editor.track then
						gnubase.channel.set({channel = editor.channel, inputTransformer = {modules = modules}})
					else
						gnubase.midi.setInputTransformer({modules = modules})
					end
				end)
				-- The engine names the module it refuses, from 0: that one shows, with the message (#1143).
				local refused = tostring(failure):match("modules%[(%d+)%]")
				if not ok and refused and editor.edits[tonumber(refused) + 1] then
					editor.module = tonumber(refused) + 1
					editor.building = true
					element(document, "module"):SetAttribute("value", tostring(editor.module))
					editor.building = false
					showModule(document)
					error((tostring(failure):gsub("modules%[%d+%][.:]?%s*", "", 1)), 0)
				end
				if not ok then
					error(failure, 0)
				end
				return true
			end
			local rules = engineRules(read(document, true))
			if editor.project then
				return applyProject(rules)
			end
			local parameters = {parts = editor.parts, rules = rules}
			if #editor.notes > 0 then
				parameters.notes = editor.notes
			end
			if rules["function"] == "select" then
				local found = gnubase.midi.findByRules(parameters)
				message(document, (#found.notes + #found.controllers) .. " events found")
				return false
			end
			gnubase.midi.applyRules(parameters)
			return true
		end

		-- Apply (OK for the input transformer): runs the rules and closes, unless the engine refuses them.
		function editor.apply(document)
			local ok, result = pcall(apply, document)
			if not ok then
				message(document, result)
			elseif result then
				document:Close()
			end
		end
	</script>
</head>
<body onshow="RuleEditor.load(document)">
	<dialog id="rule-editor" onchange="RuleEditor.changed(document)">
		<div class="dialog-titlebar" id="rule-editor-title">Rule Editor</div>
		<div class="rule-row" id="rule-editor-module-field"/>
		<div class="rule-row">
			<span class="label">Preset</span>
			<span id="rule-editor-preset-field"/>
			<span id="rule-editor-modified"/>
			<input type="text" class="text" id="rule-editor-name" value=""/>
			<button id="rule-editor-save" onclick="RuleEditor.save(document)">Save Preset</button>
		</div>
		<div class="rule-heading">Event Target Filters</div>
		<div id="rule-editor-filters"/>
		<div class="rule-row">
			<button id="rule-editor-insert-filter" onclick="RuleEditor.insert(document, 'filters')">Insert</button>
			<button id="rule-editor-remove-filter" onclick="RuleEditor.remove(document, 'filters')">Remove</button>
		</div>
		<div class="rule-row">
			<span class="label">Function</span>
			<span id="rule-editor-function-field"/>
		</div>
		<div class="rule-heading">Event Transform Actions</div>
		<div id="rule-editor-actions"/>
		<div class="rule-row">
			<button id="rule-editor-insert-action" onclick="RuleEditor.insert(document, 'actions')">Insert</button>
			<button id="rule-editor-remove-action" onclick="RuleEditor.remove(document, 'actions')">Remove</button>
		</div>
		<div id="rule-editor-commands"/>
		<div class="rule-row">
			<div id="rule-editor-message"/>
			<button id="rule-editor-cancel" result="cancel">Cancel</button>
			<button id="rule-editor-apply" class="primary" onclick="RuleEditor.apply(document)">Apply</button>
		</div>
	</dialog>
</body>
</rml>
