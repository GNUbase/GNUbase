<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- The MIDI device manager (#136, docs/features/midi-devices.md, reference manual pp. 1109-1114): the installed MIDI
     devices, installing a GM device or defining a new one, removing one, exporting and importing setup files, and
     editing its banks, folders and presets. app::AppUi opens it (the UI command window.midiDeviceManager). Its Lua reads the devices from the user setting
     midi.devices, follows settings.changed, and changes them only through engine commands, at once. -->
<rml>
<head>
	<title>MIDI Device Manager</title>
	<style>
		dialog
		{
			width: 640dp;
		}

		.content
		{
			display: flex;
			height: 380dp;
			margin: 8dp 12dp 0 12dp;
		}

		.devices
		{
			display: flex;
			flex-direction: column;
			width: 260dp;
			margin-right: 12dp;
		}

		#installed-devices
		{
			flex: 1;
		}

		#patch-banks
		{
			flex: 1;
		}

		.patches
		{
			display: flex;
			flex-direction: column;
			flex: 1;
		}

		.patches input.text
		{
			width: 0dp;
		}

		.patches .unavailable, #bank-assignment.unavailable
		{
			display: none;
		}

		.patch-program
		{
			margin-left: 8dp;
		}

		.row
		{
			display: flex;
			align-items: center;
			margin-top: 6dp;
		}

		.row input.text, .row select
		{
			flex: 1;
		}

		.row button
		{
			margin-left: 6dp;
			white-space: nowrap;
		}

		.devices .row button
		{
			flex: 1;
		}

		/* Presets are dragged onto a bank, folder or preset to move them there. */
		#patch-banks listitem.preset
		{
			drag: drag-drop;
		}

		#bank-assignment span
		{
			display: flex;
			flex: 1;
			margin-left: 6dp;
		}

		.devices .row button:first-child
		{
			margin-left: 0;
		}

		.buttons
		{
			margin: 8dp 12dp 0 12dp;
		}

		#midi-devices-message
		{
			flex: 1;
		}
	</style>
	<script>
		-- The dialog's state, in the UI's Lua: the devices' names in the order the list shows them.
		MidiDevices = {}
		local manager = MidiDevices
		local busy = false

		local function selectedName(document)
			return manager.names[tonumber(document:GetElementById("installed-devices"):GetAttribute("value"))]
		end

		local function escape(text)
			return (tostring(text):gsub('[&<>"]', {["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;"}))
		end

		local function report(document, message)
			document:GetElementById("midi-devices-message").inner_rml = escape(message or "")
		end

		-- A patch's program and bank as the reference shows them, from 1.
		local function numbers(patch)
			local text = "Program " .. (patch.program + 1)
			if patch.bank ~= nil then
				text = text .. ", Bank " .. (patch.bank + 1)
			end
			return text
		end

		-- A folder's path, with / between nested folders, without empty parts; "" is the bank itself.
		local function normal(path)
			local parts = {}
			for part in tostring(path or ""):gmatch("[^/]+") do
				parts[#parts + 1] = part
			end
			return table.concat(parts, "/")
		end

		local function parent(path)
			return path:match("^(.*)/[^/]*$") or ""
		end

		-- Whether path is folder or inside it.
		local function inside(path, folder)
			return path == folder or path:sub(1, #folder + 1) == folder .. "/"
		end

		-- A bank's folders as a tree. Each folder lists its subfolders and its own presets (as one group) in the order
		-- they first appear in the bank's patches, then the folders that New Folder made (bank.folders), which may be
		-- empty. Also returns the folders' paths, in order: a folder row's value is its index there.
		local function tree(bank)
			local root, paths = {entries = {}, children = {}}, {}
			local function node(path)
				local current = root
				for name in normal(path):gmatch("[^/]+") do
					local child = current.children[name]
					if child == nil then
						paths[#paths + 1] = (current.path and current.path .. "/" or "") .. name
						child = {name = name, path = paths[#paths], index = #paths, entries = {}, children = {}}
						current.children[name] = child
						current.entries[#current.entries + 1] = child
					end
					current = child
				end
				return current
			end
			for p, patch in ipairs(bank.patches) do
				local folder = node(patch.folder)
				if folder.patches == nil then
					folder.patches = {}
					folder.entries[#folder.entries + 1] = folder.patches
				end
				folder.patches[#folder.patches + 1] = p
			end
			for _, path in ipairs(bank.folders or {}) do
				node(path)
			end
			return root, paths
		end

		-- The selected device's banks, with their folders and patches, as a tree. Presets are dragged onto a bank,
		-- folder or preset to move them there.
		local function showPatches(document)
			local device = manager.devices[selectedName(document)]
			local rows = {}
			local function row(level, value, text, class)
				rows[#rows + 1] = '<listitem level="' .. level .. '" value="' .. value .. '" expanded=""' ..
					(class and ' class="' .. class .. '"' or "") .. ">" .. text .. "</listitem>"
			end
			local function folder(b, bank, node, level)
				for _, entry in ipairs(node.entries) do
					if entry.path ~= nil then
						row(level, "folder" .. b .. "-" .. entry.index, escape(entry.name))
						folder(b, bank, entry, level + 1)
					else
						for _, p in ipairs(entry) do
							local patch = bank.patches[p]
							row(level, "patch" .. b .. "-" .. p, '<span class="patch-name">' .. escape(patch.name) ..
								'</span><span class="patch-program">' .. numbers(patch) .. "</span>", "preset")
						end
					end
				end
			end
			manager.folders = {}
			for b, bank in ipairs(device and device.banks or {}) do
				row(0, "bank" .. b, escape(bank.name))
				local root
				root, manager.folders[b] = tree(bank)
				folder(b, bank, root, 1)
			end
			document:GetElementById("patch-banks").inner_rml = table.concat(rows)
			document:GetElementById("patch-banks"):SetAttribute("value", "")
		end

		-- Bank Assignment (p. 1109): with several banks, the bank that the channel chosen uses, or all of them.
		local function assignment(document)
			local device = manager.devices[selectedName(document)]
			local channel = tostring(document:GetElementById("assign-channel"):GetAttribute("value") or "1")
			return device, channel, device and (device.bankAssignment or {})[channel]
		end
		local function showAssignment(document)
			local device, _, assigned = assignment(document)
			document:GetElementById("bank-assignment"):SetClass("unavailable", device == nil or #device.banks < 2)
			local options = {'<option value="">All Banks</option>'}
			for b, bank in ipairs(device and device.banks or {}) do
				options[#options + 1] = '<option value="' .. (b - 1) .. '"' .. (assigned == b - 1 and " selected" or "") ..
					">" .. escape(bank.name) .. "</option>"
			end
			document:GetElementById("assign-banks").inner_rml = '<select id="assign-bank" title="Bank Assignment" ' ..
				'onchange="MidiDevices.assign(document)">' .. table.concat(options) .. "</select>"
		end
		manager.showAssignment = showAssignment
		-- Reads the devices from the engine; selected is the name to select.
		function manager.load(document, selected, devices)
			busy = true
			manager.devices = devices or gnubase.settings.get{key = "midi.devices"}.value
			busy = false
			manager.names = {}
			for name in pairs(manager.devices) do
				manager.names[#manager.names + 1] = name
			end
			table.sort(manager.names)
			local items = {}
			local index = 1
			for i, name in ipairs(manager.names) do
				items[#items + 1] = '<listitem value="' .. i .. '">' .. escape(name) .. "</listitem>"
				if name == selected then
					index = i
				end
			end
			local list = document:GetElementById("installed-devices")
			list.inner_rml = table.concat(items)
			list:SetAttribute("value", tostring(index))
			document:GetElementById("remove-device"):SetAttribute("disabled", "")
			if #manager.names > 0 then
				document:GetElementById("remove-device"):RemoveAttribute("disabled")
			end
			showPatches(document)
			showAssignment(document)
			manager.edit(document)
		end

		function manager.follow(event)
			local document = manager.document
			local devices = event.data.values["midi.devices"]
			if not busy and document ~= nil and devices ~= nil then
				manager.load(document, selectedName(document), devices)
			end
		end

		function manager.open(document)
			manager.document = document
			local channels = {}
			for channel = 1, 16 do
				channels[channel] = '<option value="' .. channel .. '">Channel ' .. channel .. "</option>"
			end
			document:GetElementById("assign-channels").inner_rml = '<select id="assign-channel" title="MIDI Channel" ' ..
				'onchange="MidiDevices.showAssignment(document)">' .. table.concat(channels) .. "</select>"
			manager.load(document)
			gnubase.on("settings.changed", manager.follow)
		end

		function manager.close()
			manager.document = nil
			gnubase.off("settings.changed", manager.follow)
		end

		function manager.select(document)
			showPatches(document)
			showAssignment(document)
			manager.edit(document)
		end

		function manager.assign(document)
			local device, channel = assignment(document)
			if device == nil then
				return
			end
			local bank = tostring(document:GetElementById("assign-bank"):GetAttribute("value") or "")
			local assigned = device.bankAssignment or {}
			assigned[channel] = tonumber(bank)
			busy = true
			local ok, result = pcall(gnubase.midiDevice.set,
				{name = selectedName(document), banks = device.banks, bankAssignment = assigned})
			busy = false
			report(document, ok and "" or tostring(result))
			if ok then
				device.bankAssignment = result.device.bankAssignment
			end
		end
		-- What a row's value names: the device, the bank, the preset (patch rows), the kind of row, the bank's and
		-- the preset's index, and the folder that a folder row is, or the one a preset is in ("" for the bank).
		local function item(device, key)
			local kind, b, p = tostring(key or ""):match("^(%a+)(%d+)%-?(%d*)$")
			b, p = tonumber(b), tonumber(p)
			local bank = device and device.banks[b]
			local patch = kind == "patch" and bank and bank.patches[p] or nil
			local folder = kind == "folder" and (manager.folders[b] or {})[p] or normal(patch and patch.folder)
			return device, bank, patch, kind, b, p, folder
		end

		local function selection(document)
			return item(manager.devices[selectedName(document)],
				document:GetElementById("patch-banks"):GetAttribute("value"))
		end

		local function enable(document, id, enabled)
			local element = document:GetElementById(id)
			if enabled then
				element:RemoveAttribute("disabled")
			else
				element:SetAttribute("disabled", "")
			end
		end

		-- Selection fills the editor; Enable Edit protects both the controls and their handlers.
		function manager.edit(document)
			local device, bank, patch, kind, _, _, folder = selection(document)
			local editing = document:GetElementById("enable-edit"):HasAttribute("checked")
			local item = kind == "patch" and patch or kind == "bank" and bank or nil
			if kind == "folder" and folder ~= "" then
				item = {name = folder:match("[^/]*$")}
			end
			enable(document, "create-bank", editing and device ~= nil)
			enable(document, "new-folder", editing and bank ~= nil)
			enable(document, "new-preset", editing and bank ~= nil)
			enable(document, "multiple-presets", editing and bank ~= nil)
			enable(document, "preset-count", editing and bank ~= nil)
			enable(document, "remove-patch", editing and item ~= nil)
			document:GetElementById("patch-editor"):SetClass("unavailable", not editing or item == nil)
			document:GetElementById("preset-fields"):SetClass("unavailable", kind ~= "patch")
			for id, value in pairs({["patch-name"] = item and item.name or "",
				["patch-folder"] = patch and patch.folder or "", ["patch-program"] = patch and patch.program + 1 or 1,
				["patch-bank"] = patch and patch.bank and patch.bank + 1 or ""}) do
				document:GetElementById(id):SetAttribute("value", tostring(value))
			end
		end

		-- Changes the selected device's banks at the selection, or for a move the dragged preset to the row target:
		-- action is bank, folder, preset, multiple, remove, apply or move.
		function manager.change(document, action, target)
			if not document:GetElementById("enable-edit"):HasAttribute("checked") then
				return
			end
			local name = selectedName(document)
			local _, _, _, kind, b, p, folder = selection(document)
			if action == "move" then
				_, _, _, kind, b, p = item(manager.devices[name], manager.dragged)
			end
			local function value(id)
				return tostring(document:GetElementById(id):GetAttribute("value") or "")
			end
			busy = true -- Engine events arrive during the call; reload once the edit has completed.
			local ok, result, made = pcall(function()
				local device = gnubase.settings.get{key = "midi.devices"}.value[name]
				assert(device ~= nil, "Select an installed device")
				local bank = device.banks[b]
				local key, made = "", nil -- made: a folder to select once the device is shown again
				if action == "bank" then
					device.banks[#device.banks + 1] = {name = "New Bank", patches = {}}
					key = "bank" .. #device.banks
				else
					assert(bank ~= nil, "Select a bank")
					local patch = kind == "patch" and bank.patches[p] or nil
					if action == "folder" then
						-- New Folder (p. 1111): in the selected bank or folder, or in the selected preset's folder.
						local taken = {}
						for _, path in ipairs(manager.folders[b] or {}) do
							taken[path] = true
						end
						local function path(number)
							return (folder ~= "" and folder .. "/" or "") .. "New Folder" ..
								(number > 1 and " " .. number or "")
						end
						local number = 1
						while taken[path(number)] do
							number = number + 1
						end
						made = path(number)
						bank.folders = bank.folders or {}
						bank.folders[#bank.folders + 1] = made
					elseif action == "move" then
						-- Drag and drop (p. 1111): a preset into the bank or folder dropped on, or before the preset
						-- dropped on, in its folder.
						assert(patch ~= nil, "Drag a preset")
						local _, to, before, toKind, toB, toP, toFolder = item(device, target)
						assert(to ~= nil, "Drop the preset on a bank, folder or preset")
						key = "patch" .. b .. "-" .. p
						if before ~= patch then
							table.remove(bank.patches, p)
							patch.folder = toFolder ~= "" and toFolder or nil
							local at = #to.patches + 1
							if toKind == "patch" then
								at = toP - ((toB == b and toP > p) and 1 or 0)
							end
							table.insert(to.patches, at, patch)
							key = "patch" .. toB .. "-" .. at
						end
					elseif action == "preset" or action == "multiple" then
						local count = 1
						if action == "multiple" then
							count = tonumber(value("preset-count"))
						end
						local first = action == "multiple" and patch and patch.program or 0
						assert(count and count % 1 == 0 and count >= 1 and first + count <= 128,
							"Preset count must be a positive integer whose range fits programs 1 to 128")
						for i = 1, count do
							bank.patches[#bank.patches + 1] = {
								name = action == "multiple" and (patch and patch.name or "Preset") .. " " .. i or "New Preset",
								program = first + i - 1, bank = action == "multiple" and patch and patch.bank or nil,
								folder = folder ~= "" and folder or nil}
						end
						key = "patch" .. b .. "-" .. #bank.patches
					elseif action == "remove" then
						if kind == "bank" then
							table.remove(device.banks, b) -- the channels assigned the banks after it keep them
							for channel, assigned in pairs(device.bankAssignment or {}) do
								device.bankAssignment[channel] = assigned + 1 ~= b and
									(assigned + 1 > b and assigned - 1 or assigned) or nil
							end
						elseif kind == "patch" and patch ~= nil then
							table.remove(bank.patches, p)
							key = "bank" .. b
						elseif kind == "folder" and folder ~= "" then -- with the folders and presets inside it
							for i = #bank.patches, 1, -1 do
								if inside(normal(bank.patches[i].folder), folder) then
									table.remove(bank.patches, i)
								end
							end
							for i = #(bank.folders or {}), 1, -1 do
								if inside(normal(bank.folders[i]), folder) then
									table.remove(bank.folders, i)
								end
							end
							key = "bank" .. b
						end
					elseif action == "apply" then
						local selected = kind == "patch" and patch or kind == "bank" and bank or nil
						if kind == "folder" and folder ~= "" then
							selected = {}
						end
						assert(selected ~= nil, "Select a bank or preset")
						assert(value("patch-name"):find("%S"), "Enter a name")
						selected.name = value("patch-name")
						if kind == "patch" then
							local program, number = tonumber(value("patch-program")), tonumber(value("patch-bank"))
							assert(program and program % 1 == 0 and program >= 1 and program <= 128,
								"Program must be an integer from 1 to 128")
							assert(value("patch-bank") == "" or
								(number and number % 1 == 0 and number >= 1 and number <= 16384),
								"Bank must be blank or an integer from 1 to 16384")
							patch.program, patch.bank = program - 1, number and number - 1 or nil
							patch.folder = value("patch-folder") ~= "" and value("patch-folder") or nil
						end
						key = kind == "patch" and "patch" .. b .. "-" .. p or "bank" .. b
						if kind == "folder" then -- renamed: the folders and presets inside it move along
							assert(not selected.name:find("/"), "A folder's name can't contain /")
							made = (parent(folder) ~= "" and parent(folder) .. "/" or "") .. selected.name
							local function renamed(path)
								path = normal(path)
								return inside(path, folder) and made .. path:sub(#folder + 1) or nil
							end
							for _, candidate in ipairs(bank.patches) do
								candidate.folder = renamed(candidate.folder) or candidate.folder
							end
							for i, path in ipairs(bank.folders or {}) do
								bank.folders[i] = renamed(path) or path
							end
						end
					end
				end
				gnubase.midiDevice.set{name = name, banks = device.banks, bankAssignment = device.bankAssignment or {}}
				return key, made
			end)
			busy = false
			report(document, ok and "" or tostring(result))
			if ok then
				manager.load(document, name)
				for index, path in ipairs(made and manager.folders[b] or {}) do
					if path == made then
						result = "folder" .. b .. "-" .. index
					end
				end
				document:GetElementById("patch-banks"):SetAttribute("value", result)
				manager.edit(document)
			end
		end

		-- Drag and drop: the preset row that a drag starts on, and the row it ends on.
		local function rowValue(element)
			while element ~= nil and element.tag_name ~= "listitem" do
				element = element.parent_node
			end
			return element and element:GetAttribute("value")
		end

		function manager.drag(event)
			manager.dragged = rowValue(event.target_element)
		end

		function manager.drop(document, event)
			local target = rowValue(event.target_element)
			if manager.dragged ~= nil and target ~= nil then
				manager.change(document, "move", target)
			end
			manager.dragged = nil
		end

		function manager.key(document, event)
			if gnubase.ui.keyName{key = event.parameters.key_identifier}.keys == "Backspace" then
				event:StopPropagation()
				manager.change(document, "remove")
			end
		end

		-- Install Device: a GM device or a new one (Define New), with the name typed.
		function manager.install(document)
			local name = document:GetElementById("device-name"):GetAttribute("value") or ""
			local template = document:GetElementById("device-template"):GetAttribute("value") or "gm"
			local ok, result = pcall(gnubase.midiDevice.install, {name = tostring(name), template = tostring(template)})
			report(document, ok and "" or tostring(result))
			if ok then
				document:GetElementById("device-name"):SetAttribute("value", "")
				manager.load(document, tostring(name))
			end
		end

		-- Remove Device: the selected one.
		function manager.remove(document)
			local name = manager.names[tonumber(document:GetElementById("installed-devices"):GetAttribute("value"))]
			if name == nil then
				return
			end
			local ok, result = pcall(gnubase.midiDevice.remove, {name = name})
			report(document, ok and "" or tostring(result))
			manager.load(document)
		end
	</script>
</head>
<body onload="MidiDevices.open(document)" onunload="MidiDevices.close()">
	<dialog id="midi-devices">
		<div class="dialog-titlebar">MIDI Device Manager</div>
		<div class="content">
			<div class="devices">
				<listview id="installed-devices" title="Installed Devices" onchange="MidiDevices.select(document)"/>
				<div class="row">
					<select id="device-template" title="Device">
						<option value="gm" selected>GM Device</option>
						<option value="empty">Define New</option>
					</select>
				</div>
				<div class="row">
					<input type="text" class="text" id="device-name" title="Device Name"/>
				</div>
				<div class="row">
					<button id="install-device" onclick="MidiDevices.install(document)">Install Device</button>
					<button id="remove-device" onclick="MidiDevices.remove(document)">Remove Device</button>
				</div>
				<div class="row">
					<button id="export-setup" onclick="gnubase.ui.command{command = 'midiDevice.exportSetup'}">Export Setup</button>
					<button id="import-setup" onclick="gnubase.ui.command{command = 'midiDevice.importSetup'}">Import Setup</button>
				</div>
				<div class="row" id="bank-assignment">Bank Assignment<span id="assign-channels"/><span id="assign-banks"/></div>
			</div>
			<div class="patches">
				<listview id="patch-banks" title="Patch Banks" onchange="MidiDevices.edit(document)"
					onkeydown="MidiDevices.key(document, event)" ondragstart="MidiDevices.drag(event)"
					ondragdrop="MidiDevices.drop(document, event)"/>
				<div class="row">
					<label><input type="checkbox" class="checkbox" id="enable-edit"
						onchange="MidiDevices.edit(document)"/>Enable Edit</label>
				</div>
				<div class="row">
					<button id="create-bank" disabled onclick="MidiDevices.change(document, 'bank')">Create Bank</button>
					<button id="new-folder" disabled onclick="MidiDevices.change(document, 'folder')">New Folder</button>
					<button id="new-preset" disabled onclick="MidiDevices.change(document, 'preset')">New Preset</button>
					<button id="remove-patch" disabled onclick="MidiDevices.change(document, 'remove')">Remove</button>
				</div>
				<div class="row">
					<input type="text" class="text" id="preset-count" title="Preset count" value="1" disabled/>
					<button id="multiple-presets" disabled onclick="MidiDevices.change(document, 'multiple')"
						title="Add a range from the selected preset's name, program, bank and folder">Add Multiple Presets</button>
				</div>
				<div id="patch-editor" class="unavailable">
					<div class="row">Name <input type="text" class="text" id="patch-name" title="Name"/></div>
					<div id="preset-fields">
						<div class="row">Folder <input type="text" class="text" id="patch-folder" title="Folder"/></div>
						<div class="row">
							Program <input type="text" class="text" id="patch-program" title="Program (1-128)"/>
							Bank <input type="text" class="text" id="patch-bank" title="Bank (blank or 1-16384)"/>
						</div>
					</div>
					<div class="row"><button id="apply-patch" onclick="MidiDevices.change(document, 'apply')">Apply</button></div>
				</div>
			</div>
		</div>
		<div class="row buttons">
			<div id="midi-devices-message"/>
			<button id="close" class="primary" result="ok">Close</button>
		</div>
	</dialog>
</body>
</rml>
