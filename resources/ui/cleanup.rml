<!-- Asks before Media > Clean Up Media Folders removes the files of the media folders that nothing uses from the disk
     (docs/features/pool.md, #1827): ui::PoolPanel opens it with how many there are in #cleanup-message and each with
     its size in #cleanup-files, and sends media.cleanup with them only if it closes with Remove (the result ok). -->
<rml>
<head>
	<title>Clean Up Media Folders</title>
	<style>
		dialog
		{
			width: 480dp;
		}

		.row
		{
			display: flex;
			margin: 8dp 12dp 0 12dp;
		}

		#cleanup-files
		{
			display: block;
			max-height: 200dp;
			overflow-y: auto;
		}

		.cleanup-file
		{
			display: flex;
		}

		.cleanup-file .path
		{
			flex: 1;
		}

		.cleanup-file .size
		{
			margin-left: 12dp;
		}

		.buttons
		{
			justify-content: flex-end;
		}

		.buttons button
		{
			margin-left: 6dp;
		}
	</style>
</head>
<body>
	<dialog id="cleanup-dialog">
		<div class="dialog-titlebar">Clean Up Media Folders</div>
		<div class="row" id="cleanup-message"></div>
		<div class="row" id="cleanup-files"></div>
		<div class="row buttons">
			<button result="cancel">Cancel</button>
			<button class="primary" result="ok">Remove</button>
		</div>
	</dialog>
</body>
</rml>
