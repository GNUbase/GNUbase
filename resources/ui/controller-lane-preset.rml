<!-- Names a new controller lane preset (docs/features/controller-lanes.md): ui::ControllerLanes opens it from the
     Controller Lane Setup menu's Add Preset item, and saves the lanes shown under the name in #lane-preset-name when
     it closes with OK. -->
<rml>
<head>
	<title>Save Preset</title>
	<style>
		dialog
		{
			width: 300dp;
		}

		.row
		{
			display: flex;
			margin: 8dp 12dp 0 12dp;
		}

		#lane-preset-name
		{
			flex: 1;
		}

		.buttons
		{
			justify-content: flex-end;
		}

		.buttons button
		{
			margin-left: 6dp;
		}
	</style>
</head>
<body>
	<dialog id="lane-preset-dialog">
		<div class="dialog-titlebar">Save Preset</div>
		<div class="row"><input type="text" id="lane-preset-name" autofocus="autofocus"/></div>
		<div class="row buttons">
			<button result="cancel">Cancel</button>
			<button class="primary" result="ok">OK</button>
		</div>
	</dialog>
</body>
</rml>
