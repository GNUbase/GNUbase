<!-- Names a track visibility configuration (docs/features/track-visibility.md): ui::TrackVisibility opens it from the
     Track Visibility Configurations menu's Add Configuration and Rename Configuration, and takes the name in
     #visibility-configuration-name when it closes with OK. A name that trackVisibility.set would refuse shows why in
     #visibility-configuration-error and keeps the dialog open (#906). -->
<rml>
<head>
	<title>Add Configuration</title>
	<style>
		dialog
		{
			width: 300dp;
		}

		.row
		{
			display: flex;
			margin: 8dp 12px 0 12px;
		}

		#visibility-configuration-name
		{
			flex: 1;
		}

		.buttons
		{
			justify-content: flex-end;
		}

		.buttons button
		{
			margin-left: 6dp;
		}
	</style>
</head>
<body>
	<dialog id="visibility-configuration-dialog">
		<div class="dialog-titlebar" id="visibility-configuration-title">Add Configuration</div>
		<div class="row"><input type="text" id="visibility-configuration-name" autofocus="autofocus"/></div>
		<div class="row" id="visibility-configuration-error"/>
		<div class="row buttons">
			<button result="cancel">Cancel</button>
			<button id="visibility-configuration-ok" class="primary">OK</button>
		</div>
	</dialog>
</body>
</rml>
