<!-- The Render Tracks and Render Selection dialog (docs/features/render-in-place.md, reference manual pp. 1471-1477):
     ui::TrackList opens it with Edit > Render in Place > Render Settings, titled Render Selection for selected events
     and parts or a selection range, else Render Tracks, with the options of the user setting render.options: Source
     Tracks and Hide Source Tracks only in Render Tracks, Source Events only for selected events and parts, Mix down to
     One Audio File only for several tracks. Render saves them there, for Render (with Current Settings) too, and
     renders with track.renderInPlace. -->
<rml>
<head>
	<title>Render Settings</title>
	<style>
		dialog
		{
			width: 340dp;
		}

		.row
		{
			display: flex;
			align-items: center;
			margin: 8dp 12dp 0 12dp;
		}

		.row label
		{
			flex: 1;
		}

		.row select, #render-name
		{
			width: 170dp;
		}

		#render-folder
		{
			width: 140dp;
		}

		#render-folder-choose
		{
			width: 26dp;
			margin-left: 4dp;
		}

		.buttons
		{
			justify-content: flex-end;
		}

		.buttons button
		{
			margin-left: 6dp;
		}
	</style>
</head>
<body>
	<dialog id="render-settings-dialog">
		<div class="dialog-titlebar" id="render-settings-title">Render Tracks</div>
		<div class="row">
			<label for="render-mode">Mode</label>
			<select id="render-mode">
				<option value="separateEvents">As Separate Events</option>
				<option value="blockEvents">As Block Events</option>
				<option value="oneEvent" selected="">As One Event</option>
			</select>
		</div>
		<div class="row">
			<label for="render-processing">Processing</label>
			<select id="render-processing">
				<option value="dry">Dry</option>
				<option value="channelSettings" selected="">Channel Settings</option>
				<option value="completeSignalPath">Complete Signal Path</option>
			</select>
		</div>
		<div class="row">
			<label for="render-tail-mode">Tail Mode</label>
			<select id="render-tail-mode">
				<option value="bars">Bars &amp; Beats</option>
				<option value="seconds">Seconds</option>
				<option value="off" selected="">Off</option>
			</select>
		</div>
		<div class="row">
			<label for="render-tail">Tail Size</label>
			<valuefield id="render-tail" value="0" min="0" max="60" step="0.5" decimals="1"/>
		</div>
		<div class="row">
			<label for="render-format">Bit Depth</label>
			<select id="render-format">
				<option value="int16">16 Bit</option>
				<option value="int24">24 Bit</option>
				<option value="int32">32 Bit</option>
				<option value="float32" selected="">32 Bit Float</option>
				<option value="float64">64 Bit Float</option>
			</select>
		</div>
		<div class="row">
			<label for="render-custom-name">Use Custom Name</label>
			<input type="checkbox" id="render-custom-name"/>
		</div>
		<div class="row">
			<label for="render-name">Name</label>
			<input type="text" id="render-name" value=""/>
		</div>
		<div class="row">
			<label for="render-folder">File Path</label>
			<input type="text" id="render-folder" value=""/>
			<button id="render-folder-choose">...</button>
		</div>
		<div class="row" id="render-mixdown-row">
			<label for="render-mixdown">Mix down to One Audio File</label>
			<input type="checkbox" id="render-mixdown"/>
		</div>
		<div class="row" id="render-source-row">
			<label for="render-source">Source Tracks</label>
			<select id="render-source">
				<option value="keep" selected="">Keep Source Tracks Unchanged</option>
				<option value="mute">Mute Source Tracks</option>
				<option value="disable">Disable Source Tracks</option>
				<option value="remove">Remove Source Tracks</option>
			</select>
		</div>
		<div class="row" id="render-hide-row">
			<label for="render-hide">Hide Source Tracks</label>
			<input type="checkbox" id="render-hide"/>
		</div>
		<div class="row" id="render-source-events-row">
			<label for="render-source-events">Source Events</label>
			<select id="render-source-events">
				<option value="keep" selected="">Keep Source Events Unchanged</option>
				<option value="mute">Mute Source Events</option>
			</select>
		</div>
		<div class="row buttons">
			<button result="cancel">Cancel</button>
			<button id="render-settings-render" class="primary" result="ok">Render</button>
		</div>
	</dialog>
</body>
</rml>
