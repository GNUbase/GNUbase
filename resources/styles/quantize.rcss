/* The quantize panel and the toolbar's quantize section (ui/quantizepanel.h, docs/features/quantize.md): rows of
   controls, the grid's or the groove's settings (the other one gets .hidden) and the grid display, where code places
   the grid positions' lines and the catch range around them in percent of a bar. The themes color the display. The
   toolbar's section shows where the toolbar has room for it, and Warp Quantize On/Off goes first (fit="spare",
   docs/features/docking.md). The panel's section for
   several audio tracks (#145) lays out like its settings. */
.quantize-panel
{
	display: block;
	padding: 6dp 8dp;
}

.quantize-row
{
	display: flex;
	align-items: center;
	height: 30dp;
}

.quantize-row button, .quantize-row valuefield, .quantize-row input.text
{
	margin-right: 4dp;
	white-space: nowrap;
}

#quantize-presets, .quantize-preset-name
{
	flex: 1 1 0;
	min-width: 0;
}

.quantize-spacer
{
	flex: 1;
}

.quantize-settings
{
	display: block;
	margin-top: 4dp;
}

.quantize-panel .hidden
{
	display: none;
}

.quantize-field
{
	display: flex;
	align-items: center;
	height: 28dp;
}

.quantize-label
{
	width: 112dp;
}

.quantize-field button, .quantize-field valuefield
{
	width: 112dp;
}

.quantize-display
{
	position: relative;
	height: 48dp;
	margin: 6dp 0;
	overflow: hidden;
}

.quantize-line
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 1px;
}

.quantize-catch
{
	position: absolute;
	top: 0;
	bottom: 0;
}

.toolbar-quantize
{
	display: flex;
	align-items: center;
}

.toolbar-quantize button
{
	margin-right: 2dp;
}
