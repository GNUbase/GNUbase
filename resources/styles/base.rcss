/* SPDX-License-Identifier: GPL-3.0-or-later */
/* GNUbase's design system (docs/features/themes.md): how every widget is laid out, in dp. Colors, fonts and skins
   come from the active theme, and documents add their own layout after both. RmlUi has no default style sheet, so the
   block elements are declared here too. */

body, div, p, h1, h2, h3, h4, form, ul, ol, li, tabset, panels, panel, .menu-item, .list-item, .menu-separator
{
	display: block;
}

body
{
	margin: 0;
	padding: 0;
}

p, h1, h2, h3, h4
{
	margin: 0 0 6dp 0;
}

/* Icons (resources/icons): 16 dp unless a document says otherwise. */
svg.icon
{
	width: 16dp;
	height: 16dp;
}

/* Canvas elements (docs/features/canvas.md): documents give them their size. */
event-lanes, waveform, curve, ruler
{
	display: block;
}

/* Buttons, also with an icon, and the small toggle buttons of tracks and channels (mute, solo, record, monitor). */
button
{
	display: inline-block;
	box-sizing: border-box;
	min-width: 64dp;
	height: 24dp;
	padding: 4dp 10dp;
	text-align: center;
	tab-index: auto;
	nav: auto;
}

/* A disabled button lets clicks pass and takes no focus (ui/widgets.h). */
button:disabled
{
	pointer-events: none;
	tab-index: none;
}

button svg.icon
{
	vertical-align: -3dp;
}

button.icon-only
{
	min-width: 24dp;
	width: 24dp;
	padding: 4dp 0;
}

button.toggle
{
	min-width: 20dp;
	width: 20dp;
	height: 20dp;
	padding: 2dp 0;
}

/* Text fields */
input.text, input.password
{
	display: inline-block;
	box-sizing: border-box;
	width: 160dp;
	height: 24dp;
	padding: 4dp 6dp;
	nav: auto;
}

textarea
{
	display: inline-block;
	box-sizing: border-box;
	width: 240dp;
	height: 72dp;
	padding: 4dp 6dp;
	nav: auto;
}

/* Check boxes and radio buttons */
input.checkbox, input.radio
{
	display: inline-block;
	width: 18dp;
	height: 18dp;
	vertical-align: -4dp;
	nav: auto;
}

/* Drop-down lists */
select
{
	display: inline-block;
	box-sizing: border-box;
	width: 160dp;
	height: 24dp;
	nav: auto;
}

select selectvalue
{
	width: auto;
	height: 24dp;
	margin-right: 24dp;
	padding: 4dp 0 0 6dp;
	box-sizing: border-box;
}

select selectarrow
{
	width: 12dp;
	height: 8dp;
	margin: 8dp 6dp 0 0;
}

select selectbox
{
	margin-top: 2dp;
	padding: 4dp 0;
}

select selectbox option
{
	width: auto;
	padding: 3dp 12dp;
}

/* Sliders and progress bars */
input.range
{
	display: inline-block;
	width: 120dp;
	height: 16dp;
	vertical-align: -3dp;
	nav: auto;
}

input.range slidertrack
{
	height: 8dp;
	margin-top: 4dp;
}

/* RmlUi places the fill over the track and gives it the track's height. */
input.range sliderprogress
{
	margin: 0;
}

input.range sliderbar
{
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
	margin-right: -8dp;
}

input.range sliderarrowdec, input.range sliderarrowinc
{
	width: 0;
	height: 0;
}

progress
{
	display: inline-block;
	width: 120dp;
	height: 8dp;
}

/* Scroll bars */
scrollbarvertical
{
	width: 10dp;
}

scrollbarvertical sliderbar
{
	min-height: 24dp;
}

scrollbarhorizontal
{
	height: 10dp;
}

scrollbarhorizontal sliderbar
{
	min-width: 24dp;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc,
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc
{
	width: 0;
	height: 0;
}

scrollbarcorner
{
	width: 10dp;
	height: 10dp;
}

/* Tabs */
tabset tabs
{
	display: flex;
	height: 28dp;
	padding: 2dp 4dp 0 4dp;
	box-sizing: border-box;
}

tabset tab
{
	display: block;
	height: 26dp;
	padding: 5dp 12dp 0 12dp;
	box-sizing: border-box;
	margin-right: 2dp;
}

/* Dialogs, panels, toolbars, displays, tooltips, menus and lists */
.dialog
{
	display: block;
	padding-bottom: 12dp;
}

.dialog-titlebar
{
	display: block;
	height: 28dp;
	padding: 6dp 12dp 0 12dp;
	box-sizing: border-box;
}

.panel
{
	display: block;
	padding: 8dp;
}

.panel-header
{
	display: block;
	height: 24dp;
	padding: 4dp 8dp 0 8dp;
	box-sizing: border-box;
}

.toolbar
{
	display: flex;
	align-items: center;
	height: 32dp;
	padding: 0 6dp;
	box-sizing: border-box;
}

.display, .tooltip
{
	display: inline-block;
	padding: 4dp 8dp;
}

.menu, .list
{
	display: block;
	padding: 4dp 0;
}

.menu-item
{
	padding: 3dp 12dp;
}

.menu-separator
{
	height: 8dp;
}

.list-item
{
	height: 22dp;
	padding: 3dp 10dp 0 10dp;
	box-sizing: border-box;
}

/* Fixed graphics of mixer and editor widgets: their sizes in the themes' artwork */
.dropdown-arrow { display: inline-block; width: 12dp; height: 8dp; }
.knob, .knob-pointer { display: block; width: 40dp; height: 40dp; }
.fader { display: block; width: 12dp; }
.fader-cap { display: block; width: 22dp; height: 12dp; }
.meter { display: block; width: 12dp; }
.meter-fill { display: block; width: 12dp; }
.meter-peak { display: block; width: 12dp; height: 4dp; }
.splitter-grip-vertical { display: block; width: 8dp; height: 24dp; }
.splitter-grip-horizontal { display: block; width: 24dp; height: 8dp; }
.focus-ring { display: block; }

/* Widgets with a number (ui/widgets.h). They take the focus for the arrow keys and get the mouse's drags. Code
   positions their parts from the value: the knob's pointer, the fader's cap, the slider's fill and thumb, the meter's
   level and peak. */
knob, fader, slider, valuefield
{
	tab-index: auto;
	drag: drag;
}

knob
{
	display: inline-block;
	position: relative;
	width: 40dp;
	height: 40dp;
}

knob .knob, knob .knob-pointer
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

fader
{
	display: inline-block;
	position: relative;
	width: 24dp;
	height: 120dp;
}

fader .fader
{
	position: absolute;
	left: 6dp;
	top: 0;
	height: 100%;
}

/* Where the cap's centre goes: half a cap from either end. */
fader .fader-travel
{
	position: absolute;
	left: 0;
	right: 0;
	top: 6dp;
	bottom: 6dp;
}

fader .fader-cap
{
	position: absolute;
	left: 1dp;
	margin-top: -6dp;
}

slider
{
	display: inline-block;
	position: relative;
	width: 120dp;
	height: 16dp;
	vertical-align: -3dp;
}

slider .slider-track
{
	position: absolute;
	left: 0;
	right: 0;
	top: 4dp;
	height: 8dp;
}

slider .slider-fill
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

/* Where the thumb's centre goes: half a thumb from either end. */
slider .slider-travel
{
	position: absolute;
	left: 8dp;
	right: 8dp;
	top: 0;
	bottom: 0;
}

slider .slider-thumb
{
	position: absolute;
	top: 0;
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
}

valuefield
{
	display: inline-block;
	position: relative;
	box-sizing: border-box;
	width: 80dp;
	height: 24dp;
	padding: 4dp 8dp;
	text-align: right;
	white-space: nowrap;
}

/* A double click edits the value in a text field over the widget. */
valuefield input.text
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	text-align: right;
}

valuefield.editing
{
	drag: none;
}

valuefield.editing input.text
{
	display: block;
}

valuefield.editing .valuefield-text
{
	visibility: hidden;
}

meter
{
	display: inline-block;
	position: relative;
	width: 12dp;
	height: 120dp;
	overflow: hidden;
	clip: always; /* RmlUi clips only content that overflows in flow, not the absolute parts */
}

meter .meter
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

meter .meter-level
{
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	overflow: hidden;
	clip: always;
}

meter .meter-fill
{
	position: absolute;
	left: 0;
	bottom: 0;
}

/* The peak's top edge marks the level; at the bottom the meter hides it. */
meter .meter-peak
{
	position: absolute;
	left: 0;
	margin-bottom: -4dp;
}

/* The event display (docs/features/event-display.md): the overview line, then the ruler over the event lanes, with
   the project cursor across both. Code sets only where the cursors and the overview's rectangle are; the cross-hair
   cursor shows while the mouse is over the lanes. */
.event-display
{
	position: relative;
	overflow: hidden;
}

.event-display .overview
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 20dp;
	overflow: hidden;
}

.event-display .overview event-lanes, .event-display .event-area event-lanes
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* The waveforms of audio events (#83): code puts each over its event's lane. */
.event-display .waveforms
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	pointer-events: none;
}

.event-display .waveforms waveform
{
	position: absolute;
	left: 0;
	right: 0;
	box-sizing: border-box;
	padding: 2dp 0;
	pointer-events: none;
}

.event-display .overview-view
{
	position: absolute;
	top: 0;
	bottom: 0;
	box-sizing: border-box;
}

.event-display .timeline
{
	position: absolute;
	left: 0;
	right: 0;
	top: 20dp;
	bottom: 0;
	overflow: hidden;
}

.event-display ruler
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 24dp;
}

/* A document's button at the ruler's right end, for the ruler's time format menu. */
.event-display .ruler-format
{
	position: absolute;
	top: 20dp;
	right: 0;
	z-index: 1;
}

.event-display .event-area
{
	position: absolute;
	left: 0;
	right: 0;
	top: 24dp;
	bottom: 0;
	overflow: hidden;
	clip: always; /* RmlUi clips only content that overflows in flow, not the absolute parts */
}

/* Without the overview line, a strip of docking windows (docs/features/docking.md). */
.no-overviewLine .event-display .overview
{
	display: none;
}

.no-overviewLine .event-display .timeline
{
	top: 0;
}

.no-overviewLine .event-display .ruler-format
{
	top: 0;
}

.event-display .project-cursor, .event-display .cross-hair-vertical
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 1dp;
	pointer-events: none;
}

.event-display .cross-hair-horizontal
{
	position: absolute;
	left: 0;
	right: 0;
	height: 1dp;
	pointer-events: none;
}

.event-display .cross-hair-vertical, .event-display .cross-hair-horizontal
{
	display: none;
}

.event-display.cross-hair .event-area:hover .cross-hair-vertical,
.event-display.cross-hair .event-area:hover .cross-hair-horizontal
{
	display: block;
}

/* Menus (ui/widgets.h): hidden until they open, over the document. A menu inside an item is its submenu, shown
   beside the item while the mouse is over it. */
menu
{
	display: none;
	position: absolute;
	z-index: 100;
	min-width: 160dp;
	padding: 4dp 0;
}

menu.open, menuitem:hover > menu
{
	display: block;
}

menuitem
{
	display: block;
	position: relative;
	padding: 3dp 12dp;
	white-space: nowrap;
	tab-index: auto;
}

menuitem:disabled
{
	pointer-events: none;
	tab-index: none;
}

menuitem > menu
{
	left: 100%;
	top: -4dp;
}

menuseparator
{
	display: block;
	height: 8dp;
}

/* Every document's tooltip, under the mouse; it lets the mouse through. */
tooltip
{
	display: none;
	position: absolute;
	z-index: 1000;
	padding: 4dp 8dp;
	pointer-events: none;
	white-space: nowrap;
}

tooltip.shown
{
	display: block;
}

/* Dialogs open in the middle of the window, and their title bar moves them. */
dialog
{
	display: block;
	position: absolute;
	padding-bottom: 12dp;
}

dialog .dialog-titlebar
{
	drag: drag;
}

/* List, tree and table views (ui/widgets.h). Rows inside a collapsed tree row are hidden; a tree row starts with its
   indent, which code sizes from its level, and its toggle, turned to point right while the row is collapsed. */
listview
{
	display: block;
	padding: 4dp 0;
	overflow-y: auto;
	tab-index: auto;
}

listitem
{
	display: block;
	box-sizing: border-box;
	height: 22dp;
	padding: 3dp 10dp 0 10dp;
	white-space: nowrap;
}

listitem.hidden, listview tr.hidden
{
	display: none;
}

.tree-indent
{
	display: inline-block;
	height: 1dp;
}

.tree-toggle
{
	display: inline-block;
	width: 12dp;
	height: 8dp;
	margin-right: 4dp;
	visibility: hidden;
	transform: rotate(-90deg);
}

listitem.parent > .tree-toggle, tr.parent .tree-toggle
{
	visibility: visible;
}

listitem.expanded > .tree-toggle, tr.expanded .tree-toggle
{
	transform: none;
}

table
{
	display: table;
	width: 100%;
}

thead, tbody, tfoot
{
	display: table-row-group;
}

tr
{
	display: table-row;
}

td
{
	display: table-cell;
	padding: 3dp 10dp;
	white-space: nowrap;
}

/* Splitters between the elements of a flex row or column; the grip shows which way they move. */
splitter
{
	display: flex;
	flex: 0 0 8dp;
	align-items: center;
	justify-content: center;
	drag: drag;
}

splitter .splitter-grip-horizontal, splitter.column .splitter-grip-vertical
{
	display: none;
}

splitter.column .splitter-grip-horizontal
{
	display: block;
}

/* Docking windows (docs/features/docking.md): strips above and below a row of zones, where the main zone takes what
   the left, right and lower zones leave. Code sets the zones' sizes and hides zones, their splitters and strips. */
.docking
{
	display: flex;
	flex-direction: column;
}

.docking .zones
{
	display: flex;
	flex: 1 1 0;
	min-height: 0;
}

.docking .zone-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0;
	min-width: 200dp;
}

.docking [zone]
{
	position: relative;
	flex: 0 0 auto;
	overflow: hidden;
	min-width: 120dp;
	min-height: 80dp;
}

.docking [zone=main]
{
	flex: 1 1 0;
	min-width: 0;
}

.docking .hidden
{
	display: none;
}

/* The frame of the zone with the keyboard focus, over what the zone shows. */
.docking .zone-frame
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 10;
	pointer-events: none;
}

.docking .focused > .zone-frame
{
	display: block;
}

.docking .strip
{
	height: 24dp;
}

.docking [zone] tabset
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
}

.docking [zone] tabset tab
{
	drag: drag-drop;
}

.docking [zone] tabset panels, .docking [zone] tabset panel
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0;
}

.docking .panel-content
{
	position: relative;
	flex: 1 1 0;
}

/* The edit history panel (ui/historypanel.h): a table of the undo steps that fills its panel. Rows of undone steps
   have the state class .undone. */
listview.history
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.history td
{
	padding: 3dp 4dp;
	overflow: hidden;
}

.history td.time
{
	width: 60dp;
}

.history td.state
{
	width: 56dp;
}

.history td.details input
{
	width: 100%;
	box-sizing: border-box;
}

/* The color picker: the saturation and value field, the hue strip, the old and new colors' swatches, and the value
   fields with their labels. Code places the thumbs and gives the field and the swatches their data's colors. */
colorpicker
{
	display: block;
	position: relative;
	width: 336dp;
	height: 200dp;
}

colorpicker .color-field
{
	position: absolute;
	left: 0;
	top: 0;
	width: 200dp;
	height: 200dp;
	drag: drag;
}

colorpicker .color-hue
{
	position: absolute;
	left: 208dp;
	top: 0;
	width: 16dp;
	height: 200dp;
	drag: drag;
}

colorpicker .color-field-thumb, colorpicker .color-hue-thumb
{
	position: absolute;
	width: 16dp;
	height: 16dp;
	margin: -8dp 0 0 -8dp;
}

colorpicker .color-hue-thumb
{
	left: 50%;
}

colorpicker .color-swatches
{
	position: absolute;
	left: 236dp;
	top: 0;
	width: 100dp;
	height: 24dp;
	display: flex;
}

colorpicker .color-old, colorpicker .color-new
{
	flex: 1;
}

colorpicker .color-values
{
	position: absolute;
	left: 236dp;
	top: 30dp;
	width: 100dp;
}

colorpicker .color-value
{
	display: flex;
	align-items: center;
	margin-bottom: 4dp;
}

colorpicker .color-value-label
{
	width: 16dp;
}

colorpicker valuefield
{
	width: 84dp;
}
