/* SPDX-License-Identifier: GPL-3.0-or-later */
/* GNUbase's design system (docs/features/themes.md): how every widget is laid out, in dp. Colors, fonts and skins
   come from the active theme, and documents add their own layout after both. RmlUi has no default style sheet, so the
   block elements are declared here too. */

body, div, p, h1, h2, h3, h4, form, ul, ol, li, tabset, panels, panel, .menu-item, .list-item, .menu-separator
{
	display: block;
}

body
{
	margin: 0;
	padding: 0;
}

p, h1, h2, h3, h4
{
	margin: 0 0 6dp 0;
}

/* Icons (resources/icons): 16 dp unless a document says otherwise. */
svg.icon
{
	width: 16dp;
	height: 16dp;
}

/* Canvas elements (docs/features/canvas.md): documents give them their size. */
event-lanes, waveform, curve, ruler
{
	display: block;
}

/* Buttons, also with an icon, and the small toggle buttons of tracks and channels (mute, solo, record, monitor). */
button
{
	display: inline-block;
	box-sizing: border-box;
	min-width: 64dp;
	height: 24dp;
	padding: 4dp 10dp;
	text-align: center;
	tab-index: auto;
	nav: auto;
}

/* A disabled button lets clicks pass and takes no focus (ui/widgets.h). */
button:disabled
{
	pointer-events: none;
	tab-index: none;
}

button svg.icon
{
	vertical-align: -3dp;
}

button.icon-only
{
	min-width: 24dp;
	width: 24dp;
	padding: 4dp 0;
}

button.toggle
{
	min-width: 20dp;
	width: 20dp;
	height: 20dp;
	padding: 2dp 0;
}

/* Text fields */
input.text, input.password
{
	display: inline-block;
	box-sizing: border-box;
	width: 160dp;
	height: 24dp;
	padding: 4dp 6dp;
	nav: auto;
}

textarea
{
	display: inline-block;
	box-sizing: border-box;
	width: 240dp;
	height: 72dp;
	padding: 4dp 6dp;
	nav: auto;
}

/* Check boxes and radio buttons */
input.checkbox, input.radio
{
	display: inline-block;
	width: 18dp;
	height: 18dp;
	vertical-align: -4dp;
	nav: auto;
}

/* Drop-down lists */
select
{
	display: inline-block;
	box-sizing: border-box;
	width: 160dp;
	height: 24dp;
	nav: auto;
}

select selectvalue
{
	width: auto;
	height: 24dp;
	margin-right: 24dp;
	padding: 4dp 0 0 6dp;
	box-sizing: border-box;
}

select selectarrow
{
	width: 12dp;
	height: 8dp;
	margin: 8dp 6dp 0 0;
}

select selectbox
{
	margin-top: 2dp;
	padding: 4dp 0;
}

select selectbox option
{
	width: auto;
	padding: 3dp 12dp;
}

/* Sliders and progress bars */
input.range
{
	display: inline-block;
	width: 120dp;
	height: 16dp;
	vertical-align: -3dp;
	nav: auto;
}

input.range slidertrack
{
	height: 8dp;
	margin-top: 4dp;
}

/* RmlUi places the fill over the track and gives it the track's height. */
input.range sliderprogress
{
	margin: 0;
}

input.range sliderbar
{
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
	margin-right: -8dp;
}

input.range sliderarrowdec, input.range sliderarrowinc
{
	width: 0;
	height: 0;
}

progress
{
	display: inline-block;
	width: 120dp;
	height: 8dp;
}

/* Scroll bars */
scrollbarvertical
{
	width: 10dp;
}

scrollbarvertical sliderbar
{
	min-height: 24dp;
}

scrollbarhorizontal
{
	height: 10dp;
}

scrollbarhorizontal sliderbar
{
	min-width: 24dp;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc,
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc
{
	width: 0;
	height: 0;
}

scrollbarcorner
{
	width: 10dp;
	height: 10dp;
}

/* Tabs */
tabset tabs
{
	display: flex;
	height: 28dp;
	padding: 2dp 4dp 0 4dp;
	box-sizing: border-box;
}

tabset tab
{
	display: block;
	height: 26dp;
	padding: 5dp 12dp 0 12dp;
	box-sizing: border-box;
	margin-right: 2dp;
}

/* Dialogs, panels, toolbars, displays, tooltips, menus and lists */
.dialog
{
	display: block;
	padding-bottom: 12dp;
}

.dialog-titlebar
{
	display: block;
	height: 28dp;
	padding: 6dp 12dp 0 12dp;
	box-sizing: border-box;
}

.panel
{
	display: block;
	padding: 8dp;
}

.panel-header
{
	display: block;
	height: 24dp;
	padding: 4dp 8dp 0 8dp;
	box-sizing: border-box;
}

.toolbar
{
	display: flex;
	align-items: center;
	height: 32dp;
	padding: 0 6dp;
	box-sizing: border-box;
}

.display, .tooltip
{
	display: inline-block;
	padding: 4dp 8dp;
}

.menu, .list
{
	display: block;
	padding: 4dp 0;
}

.menu-item
{
	padding: 3dp 12dp;
}

.menu-separator
{
	height: 8dp;
}

.list-item
{
	height: 22dp;
	padding: 3dp 10dp 0 10dp;
	box-sizing: border-box;
}

/* Fixed graphics of mixer and editor widgets: their sizes in the themes' artwork */
.dropdown-arrow { display: inline-block; width: 12dp; height: 8dp; }
.knob, .knob-pointer { display: block; width: 40dp; height: 40dp; }
.fader { display: block; width: 12dp; }
.fader-cap { display: block; width: 22dp; height: 12dp; }
.meter { display: block; width: 12dp; }
.meter-fill { display: block; width: 12dp; }
.meter-peak { display: block; width: 12dp; height: 4dp; }
.splitter-grip-vertical { display: block; width: 8dp; height: 24dp; }
.splitter-grip-horizontal { display: block; width: 24dp; height: 8dp; }
.focus-ring { display: block; }

/* Widgets with a number (ui/widgets.h). They take the focus for the arrow keys and get the mouse's drags. Code
   positions their parts from the value: the knob's pointer, the fader's cap, the slider's fill and thumb, the meter's
   level and peak. */
knob, fader, slider, valuefield
{
	tab-index: auto;
	drag: drag;
}

knob
{
	display: inline-block;
	position: relative;
	width: 40dp;
	height: 40dp;
}

knob .knob, knob .knob-pointer
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

fader
{
	display: inline-block;
	position: relative;
	width: 24dp;
	height: 120dp;
}

fader .fader
{
	position: absolute;
	left: 6dp;
	top: 0;
	height: 100%;
}

/* Where the cap's centre goes: half a cap from either end. */
fader .fader-travel
{
	position: absolute;
	left: 0;
	right: 0;
	top: 6dp;
	bottom: 6dp;
}

fader .fader-cap
{
	position: absolute;
	left: 1dp;
	margin-top: -6dp;
}

slider
{
	display: inline-block;
	position: relative;
	width: 120dp;
	height: 16dp;
	vertical-align: -3dp;
}

slider .slider-track
{
	position: absolute;
	left: 0;
	right: 0;
	top: 4dp;
	height: 8dp;
}

slider .slider-fill
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

/* Where the thumb's centre goes: half a thumb from either end. */
slider .slider-travel
{
	position: absolute;
	left: 8dp;
	right: 8dp;
	top: 0;
	bottom: 0;
}

slider .slider-thumb
{
	position: absolute;
	top: 0;
	width: 16dp;
	height: 16dp;
	margin-left: -8dp;
}

valuefield
{
	display: inline-block;
	position: relative;
	box-sizing: border-box;
	width: 80dp;
	height: 24dp;
	padding: 4dp 8dp;
	text-align: right;
	white-space: nowrap;
}

/* A double click edits the value in a text field over the widget. */
valuefield input.text
{
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	text-align: right;
}

valuefield.editing
{
	drag: none;
}

valuefield.editing input.text
{
	display: block;
}

valuefield.editing .valuefield-text
{
	visibility: hidden;
}

meter
{
	display: inline-block;
	position: relative;
	width: 12dp;
	height: 120dp;
	overflow: hidden;
	clip: always; /* RmlUi clips only content that overflows in flow, not the absolute parts */
}

meter .meter
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

meter .meter-level
{
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	overflow: hidden;
	clip: always;
}

meter .meter-fill
{
	position: absolute;
	left: 0;
	bottom: 0;
}

/* The peak's top edge marks the level; at the bottom the meter hides it. */
meter .meter-peak
{
	position: absolute;
	left: 0;
	margin-bottom: -4dp;
}

/* The event display (docs/features/event-display.md): the overview line, then the ruler over the event lanes, with
   the project cursor across both. Code sets only where the cursors and the overview's rectangle are; the cross-hair
   cursor shows while the mouse is over the lanes. */
.event-display
{
	position: relative;
	overflow: hidden;
}

.event-display .overview
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 20dp;
	overflow: hidden;
}

.event-display .overview event-lanes, .event-display .event-area event-lanes
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.event-display .overview-view
{
	position: absolute;
	top: 0;
	bottom: 0;
	box-sizing: border-box;
}

.event-display .timeline
{
	position: absolute;
	left: 0;
	right: 0;
	top: 20dp;
	bottom: 0;
	overflow: hidden;
}

.event-display ruler
{
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 24dp;
}

/* A document's button at the ruler's right end, for the ruler's time format menu. */
.event-display .ruler-format
{
	position: absolute;
	top: 20dp;
	right: 0;
	z-index: 1;
}

.event-display .event-area
{
	position: absolute;
	left: 0;
	right: 0;
	top: 24dp;
	bottom: 0;
	overflow: hidden;
}

.event-display .project-cursor, .event-display .cross-hair-vertical
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 1dp;
	pointer-events: none;
}

.event-display .cross-hair-horizontal
{
	position: absolute;
	left: 0;
	right: 0;
	height: 1dp;
	pointer-events: none;
}

.event-display .cross-hair-vertical, .event-display .cross-hair-horizontal
{
	display: none;
}

.event-display.cross-hair .event-area:hover .cross-hair-vertical,
.event-display.cross-hair .event-area:hover .cross-hair-horizontal
{
	display: block;
}

/* Menus (ui/widgets.h): hidden until they open, over the document. A menu inside an item is its submenu, shown
   beside the item while the mouse is over it. */
menu
{
	display: none;
	position: absolute;
	z-index: 100;
	min-width: 160dp;
	padding: 4dp 0;
}

menu.open, menuitem:hover > menu
{
	display: block;
}

menuitem
{
	display: block;
	position: relative;
	padding: 3dp 12dp;
	white-space: nowrap;
	tab-index: auto;
}

menuitem:disabled
{
	pointer-events: none;
	tab-index: none;
}

menuitem > menu
{
	left: 100%;
	top: -4dp;
}

menuseparator
{
	display: block;
	height: 8dp;
}

/* Every document's tooltip, under the mouse; it lets the mouse through. */
tooltip
{
	display: none;
	position: absolute;
	z-index: 1000;
	padding: 4dp 8dp;
	pointer-events: none;
	white-space: nowrap;
}

tooltip.shown
{
	display: block;
}

/* Dialogs open in the middle of the window, and their title bar moves them. */
dialog
{
	display: block;
	position: absolute;
	padding-bottom: 12dp;
}

dialog .dialog-titlebar
{
	drag: drag;
}
