/* The sampler panel (ui/samplerpanel.h, docs/features/sampler-track.md): the toolbar, the waveform display with the
   markers, the bars between them, the loop and the shades outside the start and end, the keyboard, and the sections
   side by side. Code places the markers, the loop and the shades in percent of the part of the sample shown. The root
   gets .empty without a sampler track, the loop and its markers .off without a loop mode, the loop's markers .loop,
   markers outside the part shown .out-of-view, the marker or bar being dragged .dragged, the loop's bar .loop and
   .off, keys .black, .root and .outside (the key range), the keyboard's handles .root (the root key's, the others the
   key range's) and .dragged, the toolbar's message .error and its event received indicator .lit; the themes color
   them. Code places the handles on their keys in percent of the keyboard. Above the display lies its ruler with the
   format's drop-down list as an arrow button at its right, beside it the vertical zoom and below it the scroll slider
   and the horizontal zoom (reference manual p. 717). */
.sampler-panel
{
	display: flex;
	flex-direction: column;
	height: 100%;
	overflow: hidden;
}

.sampler-hint
{
	display: none;
	padding: 8dp;
}

.sampler-panel.empty .sampler-hint
{
	display: block;
}

.sampler-panel.empty .sampler-toolbar, .sampler-panel.empty .sampler-timeline,
.sampler-panel.empty .sampler-view, .sampler-panel.empty .sampler-zoom,
.sampler-panel.empty .sampler-sections, .sampler-panel.empty .sampler-keyboard,
.sampler-panel.empty .sampler-handles
{
	display: none;
}

.sampler-toolbar
{
	display: flex;
	flex-shrink: 0;
	align-items: center;
	gap: 4dp;
	padding: 2dp 4dp;
}

.sampler-file
{
	flex: 1 1 0;
	overflow: hidden;
	white-space: nowrap;
}

.sampler-message
{
	flex: 0 1 auto;
	overflow: hidden;
	white-space: nowrap;
}

.sampler-level
{
	width: 64dp;
}

.sampler-received
{
	flex-shrink: 0;
	width: 8dp;
	height: 8dp;
}

/* The vertical zoom and the format's list keep 6dp off the display and the ruler, where the End marker's flag reaches
   when End is at the sample's end. */
.sampler-timeline, .sampler-zoom
{
	display: flex;
	flex-shrink: 0;
	height: 24dp;
	gap: 6dp;
}

.sampler-ruler
{
	display: block;
	flex: 1 1 0;
}

/* As wide as the vertical zoom below it, so that the ruler is as wide as the display; its list opens leftwards. */
.sampler-ruler-format
{
	flex-shrink: 0;
	width: 24dp;
}

.sampler-ruler-format selectvalue
{
	visibility: hidden;
}

.sampler-ruler-format selectbox
{
	width: 96dp;
	margin-left: -72dp;
}

.sampler-view
{
	display: flex;
	flex: 1 1 0;
	min-height: 40dp;
	gap: 6dp;
}

.sampler-display
{
	position: relative;
	flex: 1 1 0;
}

#sampler-vertical-zoom
{
	flex-shrink: 0;
	width: 24dp;
	height: auto;
}

.sampler-zoom
{
	align-items: center;
	padding-right: 30dp;
}

#sampler-scroll
{
	flex: 1 1 0;
}

#sampler-horizontal-zoom
{
	flex-shrink: 0;
	width: 120dp;
}

.sampler-wave
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.sampler-outside, .sampler-loop
{
	position: absolute;
	top: 0;
	bottom: 0;
}

.sampler-outside.sampler-before
{
	left: 0;
}

/* Markers outside the part of the sample shown (.out-of-view) are out of sight too. */
.sampler-loop.off, .sampler-marker.off, .sampler-marker.out-of-view
{
	display: none;
}

.sampler-marker
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 9dp;
	margin-left: -4dp;
	cursor: resize;
	drag: drag; /* its drag ends wherever the button goes up, outside the window too */
}

/* A bar spans its two markers at their flags' height; the themes show it on hover and while it is dragged. */
.sampler-bar
{
	position: absolute;
	top: 0;
	height: 6dp;
	cursor: move;
	drag: drag;
}

.sampler-bar.loop
{
	top: auto;
	bottom: 0;
}

.sampler-bar.off
{
	display: none;
}

.sampler-marker-line
{
	position: absolute;
	left: 4dp;
	top: 0;
	bottom: 0;
	width: 1dp;
}

.sampler-marker-flag
{
	position: absolute;
	left: 0;
	top: 0;
	width: 9dp;
	height: 6dp;
}

.sampler-marker.loop .sampler-marker-flag
{
	top: auto;
	bottom: 0;
}

/* The fades' and the loop crossfade's markers lie below the flags of Start and End and above the loop's, so that
   those stay reachable where a length of 0 puts them on the same spot. */
.sampler-marker.length
{
	top: 8dp;
	bottom: auto;
	height: 8dp;
}

.sampler-marker.loop.length
{
	top: auto;
	bottom: 8dp;
}

.sampler-sections
{
	display: flex;
	flex: 0 1 auto;
	min-height: 0;
	gap: 8dp;
	padding: 4dp;
	overflow: auto;
}

.sampler-section
{
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
	gap: 2dp;
	width: 170dp;
}

.sampler-section-title
{
	flex-shrink: 0;
	height: 14dp;
}

.sampler-control
{
	display: flex;
	flex-shrink: 0;
	align-items: center;
	gap: 4dp;
	height: 20dp;
}

.sampler-label
{
	width: 80dp;
	white-space: nowrap;
	overflow: hidden;
}

.sampler-control valuefield, .sampler-control select
{
	flex: 1 1 0;
}

.sampler-keyboard
{
	display: flex;
	flex-shrink: 0;
	height: 20dp;
	padding: 2dp 0;
}

.sampler-key
{
	flex: 1 1 0;
	height: 100%;
}

.sampler-key.black
{
	height: 60%;
}

/* Above the keyboard, on their keys, none over another (#1180), however narrow the keys are (#1200): a row each, the
   key range's low handle on top, its high one in the middle and the root key's at the bottom, each a key wide. */
.sampler-handles
{
	position: relative;
	flex-shrink: 0;
	height: 22dp;
	margin-top: 2dp;
}

.sampler-handle
{
	position: absolute;
	top: 0;
	height: 6dp;
	width: 0.78125%;
	min-width: 4dp;
	cursor: resize;
	drag: drag; /* its drag ends wherever the button goes up, outside the window too */
}

.sampler-handle[handle=high]
{
	top: 8dp;
}

.sampler-handle.root
{
	top: 16dp;
}
