/* The sample editor (ui/sampleeditor.h, docs/features/sample-editor.md): the toolbar, the info line, the overview,
   the inspector beside the waveform display and the regions list. Code places the event's edges, the selection, the
   snap point and the region shown in dp from the display's left, and the overview's in percent of the clip. The root
   gets .empty without an event and .no-info, .no-overview and .no-regions for the parts the window layout hides;
   the tools and switches get .checked, regions in the list .selected, and what isn't there .off. The themes color
   them. */
.sample-editor
{
	flex: 1 1 0;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

.sample-editor-toolbar
{
	flex-shrink: 0;
	flex-wrap: wrap;
	height: auto;
	min-height: 32dp;
}

.se-info
{
	flex-shrink: 0;
	height: 26dp;
	padding: 0 6dp;
}

.se-overview
{
	position: relative;
	flex-shrink: 0;
	height: 40dp;
}

.se-overview-wave, .se-wave
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.se-overview-event, .se-overview-selection, .se-overview-view, .se-overview-snap
{
	position: absolute;
	top: 0;
	bottom: 0;
}

.se-overview-snap, .se-snap-point
{
	min-width: 1dp;
}

.se-body
{
	flex: 1 1 0;
	display: flex;
	flex-direction: row;
	min-height: 0;
}

.se-inspector
{
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	width: 200dp;
	padding: 4dp;
	overflow-y: auto;
}

.se-inspector button
{
	margin-bottom: 2dp;
}

.se-main
{
	flex: 1 1 0;
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.se-display
{
	position: relative;
	flex: 1 1 0;
	min-height: 0;
	overflow: hidden;
}

.se-outside, .se-selection, .se-region-shown
{
	position: absolute;
	top: 0;
	bottom: 0;
}

/* The tools' pointers (docs/features/tools.md). */
.sample-editor[tool=range] .se-display
{
	cursor: tool-range;
}

.sample-editor[tool=zoom] .se-display
{
	cursor: tool-zoom;
}

.sample-editor[tool=play] .se-display, .sample-editor[tool=scrub] .se-display
{
	cursor: tool-play;
}

/* The snap point's handle: a line across the display that is easy to grab. */
.se-snap-point
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 3dp;
	margin-left: -1dp;
	cursor: resize;
}

.se-regions
{
	flex-shrink: 0;
	display: flex;
	flex-direction: column;
	height: 120dp;
}

.se-region-list
{
	flex: 1 1 0;
	overflow-y: auto;
}

.se-region
{
	display: flex;
	flex-direction: row;
	height: 20dp;
	line-height: 20dp;
	padding: 0 4dp;
}

.se-region-name
{
	flex: 1 1 0;
}

.se-region-start, .se-region-end
{
	width: 80dp;
	text-align: right;
}

.sample-editor.empty .se-overview, .sample-editor.empty .se-body, .sample-editor.no-info .se-info,
.sample-editor.no-overview .se-overview, .sample-editor.no-regions .se-regions, .sample-editor .off
{
	display: none;
}
