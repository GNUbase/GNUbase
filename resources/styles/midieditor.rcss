/* The MIDI editors (ui/midieditor.h, docs/features/midi-editors.md): the toolbar over the editor window's global
   tracks and the key editor (keyeditor.rcss), the Visibility tab's tracks with their check, and the inspector's Global
   Tracks section. The parts get .active and .editable, the Visibility tab's tracks .active and their checks .checked
   or .partial, Keep Editor Contents and the global track toggles .checked; the themes color them. */
.midi-editor
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
}

.midi-editor-toolbar
{
	flex-shrink: 0;
}

.midi-editor-toolbar button
{
	margin-right: 4dp;
}

.midi-editor-toolbar .spacer
{
	flex: 1 1 0;
}

.editor-global-tracks
{
	flex-shrink: 0;
}

.editor-global-track
{
	display: block;
	height: 20dp;
	padding: 2dp 6dp;
	box-sizing: border-box;
	white-space: nowrap;
	overflow: hidden;
}

.editor-visibility, .editor-global-track-list
{
	display: flex;
	flex-direction: column;
	padding: 4dp;
}

.editor-visibility-track
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
}

.editor-visibility-check
{
	width: 16dp;
	height: 16dp;
	min-width: 16dp;
	margin-right: 6dp;
	padding: 0;
}

.editor-visibility-name
{
	flex: 1 1 0;
	white-space: nowrap;
	overflow: hidden;
}

.editor-global-toggle
{
	display: block;
	margin-bottom: 2dp;
	text-align: left;
}
