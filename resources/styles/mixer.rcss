/* The mixer (ui/mixer.h, docs/features/mixer-window.md): its toolbar over the fader section, a row of channel strips
   that scrolls sideways, each the channel's name over its sections (picture, notepad, fader), and the Visibility tab's
   list of channels. Strips have the channel's type in their type attribute; their sections get .hidden from the
   docking system, the channel type filter's button .checked while a type is hidden. */
.mixer
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
}

.mixer-toolbar
{
	flex-shrink: 0;
}

.mixer-toolbar button
{
	margin-right: 4dp;
}

.mixer-toolbar .spacer
{
	flex: 1 1 0;
}

.mixer-channels
{
	flex: 1 1 0;
	display: flex;
	overflow-x: auto;
	overflow-y: hidden;
}

.mixer-channel
{
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
	width: 76dp;
	padding: 4dp;
	box-sizing: border-box;
}

.mixer-channel-name
{
	flex-shrink: 0;
	height: 20dp;
	overflow: hidden;
	white-space: nowrap;
	text-align: center;
	cursor: pointer; /* a drag reorders the channels, under a hand (reference manual p. 496) */
}

/* The display line, a textdisplay: the number and the name of the channel's link group, on every strip while the
   project has a link group (.link-groups). */
.mixer-link
{
	display: none;
}

.mixer-channels.link-groups .mixer-link
{
	display: block;
	flex-shrink: 0;
	min-width: 0;
	height: 16dp;
	padding: 0;
	overflow: hidden;
	white-space: nowrap;
	text-align: center;
}

.mixer-vca-group
{
	margin-bottom: 4dp;
}

.mixer-picture
{
	flex-shrink: 0;
	height: 52dp;
	margin-bottom: 4dp;
}

.mixer-picture img, .mixer-picture svg
{
	display: block;
	width: 100%;
	height: 100%;
}

.mixer-notes
{
	flex-shrink: 0;
	margin-bottom: 4dp;
}

.mixer-notes textarea
{
	display: block;
	width: 100%;
	height: 64dp;
	box-sizing: border-box;
}

/* The pre section, the equalizer and the strip's dynamics: small knobs and fields in rows that wrap */
.mixer-section
{
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
	margin-bottom: 4dp;
}

.mixer-row
{
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	margin-top: 2dp;
}

.mixer-section knob, .mixer-pan
{
	width: 22dp;
	height: 22dp;
	margin: 1dp;
}

.mixer-section valuefield
{
	width: 100%;
	height: 18dp;
}

.mixer-section button.toggle
{
	margin: 1dp;
}

/* A send's destination, a cut's slope and an EQ band's type take what their row leaves. */
.mixer-section select
{
	flex: 1;
	min-width: 0;
	height: 18dp;
}

/* Pan bypass and the pan control, or on a .combined strip the combined panner's left and right controls. */
.mixer-panner
{
	display: flex;
	flex-shrink: 0;
	align-items: center;
	margin-bottom: 4dp;
}

.mixer-pan-side, .mixer-channel.combined .mixer-pan
{
	display: none;
}

.mixer-channel.combined .mixer-pan-side
{
	display: inline-block;
}

/* A channel whose routing gives it no panner (mono into mono): its place stays, so the faders line up. */
.mixer-channel.no-panner .mixer-panner
{
	visibility: hidden;
}

.mixer-fader
{
	flex: 1 1 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	min-height: 120dp;
}

.mixer-buttons
{
	display: flex;
	flex-shrink: 0;
	margin-bottom: 4dp;
}

.mixer-buttons button
{
	margin: 0 1dp;
}

.mixer-edit
{
	flex-shrink: 0;
	margin-bottom: 4dp;
}

/* The fader with an audio channel's meter next to it, a bar per audio channel, over the fader's volume and the
   meter's peak level. */
.mixer-level
{
	flex: 1 1 0;
	display: flex;
	justify-content: center;
	min-height: 60dp;
}

.mixer-level fader
{
	height: auto;
}

.mixer-meter
{
	display: flex;
	margin-left: 2dp;
}

/* The channel meters' scale (+3 dB digital, reference manual pp. 467-468): its marks, whose middles code places at
   their levels' heights, as tall as the bars beside it. */
.mixer-meter-scale
{
	position: relative;
	width: 14dp;
	margin-left: 2dp;
}

.mixer-meter-scale span
{
	position: absolute;
	right: 0;
	height: 10dp;
	margin-top: -5dp;
	line-height: 10dp;
}

.mixer-meter meter
{
	width: 5dp;
	height: auto;
	margin-left: 1dp;
}

.mixer-readouts
{
	display: flex;
	flex-shrink: 0;
	justify-content: space-between;
	width: 100%;
	margin-top: 4dp;
}

.mixer-peak
{
	cursor: pointer;
}

.mixer-visibility
{
	display: flex;
	flex-direction: column;
	padding: 4dp;
}

.mixer-visibility-item
{
	display: block;
	margin-bottom: 2dp;
	text-align: left;
}

/* The channel settings window (docs/features/channel-settings.md): one channel, its sections side by side, its name
   in the toolbar. */
.settings-name
{
	min-width: 120dp;
	padding: 0 8dp;
	white-space: nowrap;
}

.channel-settings .mixer-channel
{
	flex: 1 1 auto;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: flex-start;
	width: auto;
}

.channel-settings .mixer-channel-name
{
	display: none;
}

.channel-settings .mixer-section, .channel-settings .mixer-picture, .channel-settings .mixer-notes
{
	width: 180dp;
	margin-right: 8dp;
}

.channel-settings .mixer-fader
{
	flex: 0 0 auto;
	width: 76dp;
	height: 240dp;
}
