/* The key editor (ui/keyeditor.h, docs/features/key-editor.md): its toolbar and info line, the parts by track, and
   the note display: the keyboard beside the grid of 128 pitch rows, the notes over it and the step input cursor. Code
   places the parts, the notes and the cursor in percent of the grid; the rows' height here sets the pitches' height.
   The keys and rows of black keys get .black, lit keys .selected, notes .selected, .inactive (outside the part
   editing mode) and .drawing (being drawn), the tools and input buttons .checked; the themes color them. The drum
   editor is .key-editor.drum-editor, below. */
.key-editor
{
	flex: 1 1 0;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

.key-editor-toolbar
{
	flex-shrink: 0;
	flex-wrap: wrap;
	height: auto;
	min-height: 32dp;
}

.key-editor-toolbar .separator
{
	display: inline-block;
	width: 8dp;
}

.key-editor-toolbar valuefield
{
	width: 40dp;
}

.key-editor-info
{
	flex-shrink: 0;
	height: 26dp;
	padding: 0 6dp;
}

.key-editor .editor-parts
{
	flex-shrink: 0;
	margin-left: 48dp;
}

.editor-part-row
{
	position: relative;
	height: 18dp;
}

.key-editor .editor-part
{
	position: absolute;
	top: 1dp;
	bottom: 1dp;
	padding: 1dp 4dp;
	box-sizing: border-box;
	white-space: nowrap;
	overflow: hidden;
}

.key-editor-body
{
	flex: 1 1 0;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	overflow-y: auto;
	min-height: 0;
}

/* The piano keyboard as high as the grid's 128 rows of 10dp. Code places each key's top and height: a black key on
   its pitch's row, the white keys in equal shares of their octave. */
.key-editor-keys
{
	position: relative;
	flex-shrink: 0;
	width: 48dp;
	height: 1280dp;
}

.key-editor-grid
{
	position: relative;
	flex: 1 1 0;
}

/* The row height: .key-editor-keys is 128 of them high. */
.key-editor-row
{
	display: block;
	height: 10dp;
	box-sizing: border-box;
}

/* A C key's name sits at the right, level with its own row (the bottom 10dp of the key's 120/7dp) but 1dp higher, clear
   of the key's bottom border. */
.key-editor-key
{
	position: absolute;
	left: 0;
	width: 100%;
	box-sizing: border-box;
	overflow: hidden;
	font-size: 8dp;
	line-height: 10dp;
	text-align: right;
	padding-top: 6dp;
	padding-right: 2dp;
}

.key-editor-key.black
{
	width: 60%;
	padding-top: 0;
}

.key-editor-notes
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.key-note
{
	position: absolute;
	box-sizing: border-box;
}

.key-editor-step-cursor
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 2dp;
}

.key-editor-step-cursor.off
{
	display: none;
}

/* The drum editor (#129, docs/features/drum-editor.md): the drum sound list instead of the keyboard, a row per
   sound with its pitch, mute button, name, snap, I-note, O-note and channel; taller rows; the notes as diamonds at
   their start, which code places by their left edge. */
.drum-editor .editor-parts
{
	margin-left: 300dp;
}

/* The drum sounds stack in the list's flow, unlike the piano keys code places. */
.drum-editor .key-editor-keys
{
	width: 300dp;
	height: auto;
}

.drum-editor .key-editor-row, .key-editor-key.drum-sound
{
	height: 16dp;
}

.key-editor-key.drum-sound
{
	position: static;
	padding-top: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 10dp;
	line-height: 14dp;
	text-align: left;
	padding-right: 0;
	white-space: nowrap;
}

.drum-sound-pitch
{
	width: 32dp;
	padding-left: 4dp;
}

.drum-sound-mute
{
	width: 16dp;
	min-width: 16dp;
	height: 14dp;
	padding: 0;
	font-size: 9dp;
	line-height: 14dp;
}

.drum-sound textdisplay
{
	min-width: 0;
	height: 14dp;
	padding: 0 2dp;
	overflow: hidden;
}

.drum-sound textdisplay.drum-sound-name
{
	flex: 1 1 0;
	margin-left: 4dp;
	text-align: left;
}

.drum-sound textdisplay.drum-sound-field
{
	flex: 0 0 auto;
	width: 40dp;
}

.key-note.drum-note
{
	width: 10dp;
	height: 10dp;
	margin: 3dp 0 0 -5dp;
	transform: rotate(45deg);
}

#drum-map
{
	min-width: 80dp;
}

/* The inspector's Chord Editing section (pp. 1215-1218). */
.editor-chord-editing
{
	display: flex;
	flex-direction: column;
	padding: 4dp;
}

.editor-chord-type
{
	height: 20dp;
	margin-bottom: 4dp;
}

.editor-chords, .editor-voicings
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 4dp;
}

.editor-chord, .editor-voicing
{
	margin: 0 2dp 2dp 0;
}

/* The in-place editor (#131, ui/inplaceeditor.h, docs/features/in-place-editor.md): a key editor over its track's
   lane in the event display, which code places. The editors' container has no height, so that the lanes beside them
   still take presses. The toolbar and the info line show while .toolbar-shown, which the toggle at the top right
   switches; .hidden while a folded folder hides the track. */
.in-place-editors
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 0;
}

.in-place-editor
{
	position: absolute;
	left: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
}

.in-place-editor.hidden,
.in-place-editor .key-editor-toolbar,
.in-place-editor .key-editor-info
{
	display: none;
}

.in-place-editor.toolbar-shown .key-editor-toolbar,
.in-place-editor.toolbar-shown .key-editor-info
{
	display: flex;
}

/* The parts' row as wide as the grid, which the note display's scroll bar (base.rcss) narrows: the parts lie on the
   timeline too. */
.in-place-editor .editor-parts
{
	margin-right: 10dp;
}

.in-place-toolbar-toggle
{
	position: absolute;
	top: 0;
	right: 0;
	width: 22dp;
	height: 18dp;
	padding: 0;
}
