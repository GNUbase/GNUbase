/* SPDX-License-Identifier: GPL-3.0-or-later */
/* The key editor (ui/keyeditor.h, docs/features/key-editor.md): its toolbar and info line, the parts by track, and
   the note display: the keyboard beside the grid of 128 pitch rows, the notes over it and the step input cursor. Code
   places the parts, the notes, the cursor and the drumstick's velocity in percent of the grid; the rows' height here
   sets the pitches' height. The keys and rows of black keys get .black, lit keys .selected, notes .selected,
   .inactive (outside the part editing mode) and .drawing (being drawn), the tools and input buttons .checked; the
   themes color them. The drum editor is .key-editor.drum-editor, below. */
.key-editor
{
	flex: 1 1 0;
	display: flex;
	flex-direction: column;
	min-height: 0;
}

/* The toolbar wraps button by button, as it did before it had sections: they are inline in its lines, so that a
   narrow editor doesn't move a whole section to the next line (#1766). */
.key-editor-toolbar
{
	display: block;
	flex-shrink: 0;
	height: auto;
	min-height: 32dp;
	padding: 4dp 6dp 0 6dp;
}

.key-editor-toolbar .toolbar-section
{
	display: inline;
}

/* Lines as high as the buttons, which their text's baseline would make a little higher. */
.key-editor-toolbar button, .key-editor-toolbar valuefield
{
	vertical-align: top;
}

.key-editor-toolbar .toolbar-section.hidden
{
	display: none;
}

.key-editor-toolbar valuefield
{
	width: 40dp;
}

.key-editor-info
{
	flex-shrink: 0;
	height: 26dp;
	padding: 0 6dp;
}

/* The Articulations field: names, as wide as a few even while it is empty, so that it can be clicked. */
.key-editor-info textdisplay[field=articulations]
{
	min-width: 80dp;
	text-align: left;
}

/* Its button that opens the pop-up menu of the track's map's attributes (p. 1290). */
.key-editor-info button.articulation-menu
{
	padding: 0 2dp;
	margin-left: 2dp;
}

/* Its warning sign, for attributes the track's articulation map doesn't have (.unknown, p. 1291). */
.key-editor-info svg.articulation-warning
{
	display: none;
	margin-left: 2dp;
}

.key-editor-info .info-field.unknown svg.articulation-warning
{
	display: block;
}

.key-editor .editor-parts
{
	flex-shrink: 0;
	margin-left: 48dp;
}

.editor-part-row
{
	position: relative;
	height: 18dp;
}

.key-editor .editor-part
{
	position: absolute;
	top: 1dp;
	bottom: 1dp;
	padding: 1dp 4dp;
	box-sizing: border-box;
	white-space: nowrap;
	overflow: hidden;
}

/* A line that may wrap is as high as its highest item, the grid, where a single line would be as high as the view: the
   keyboard stretches to it. It starts from 40% of the editor, so that in a low editor the controller lanes below,
   which shrink far faster, give way first, down to their footer; then it shrinks too (#1775). */
.key-editor-body
{
	flex: 1 1 40%;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	align-items: flex-start;
	overflow-y: auto;
	min-height: 0;
}

/* The piano keyboard, as high as the grid's rows. Code places each key's top and height: a black key on its pitch's
   row, the white keys in equal shares of their octave. */
.key-editor-keys
{
	position: relative;
	flex-shrink: 0;
	width: 48dp;
	align-self: stretch;
}

/* With drum sound names (a drum map's or a name list's, reference manual p. 1239) the keys name their sounds: the
   keyboard is wider, and the parts and the controller lanes start where the grid does. */
.key-editor.named-keys .key-editor-keys,
.key-editor.named-keys .controller-lane-header
{
	width: 128dp;
}

.key-editor.named-keys .editor-parts
{
	margin-left: 128dp;
}

.key-editor-grid
{
	position: relative;
	flex: 1 1 0;
}

/* The row height, the only one: the keyboard is as high as the rows, and the pitch zoom scales it. */
.key-editor-row
{
	display: block;
	height: 10dp;
	box-sizing: border-box;
}

/* A C key's name sits at the right, level with its own row (the bottom 10dp of the key's 120/7dp) but 1dp higher, clear
   of the key's bottom border. */
.key-editor-key
{
	position: absolute;
	left: 0;
	width: 100%;
	box-sizing: border-box;
	overflow: hidden;
	font-size: 8dp;
	line-height: 10dp;
	text-align: right;
	padding-top: 6dp;
	padding-right: 2dp;
}

.key-editor-key.black
{
	width: 60%;
	padding-top: 0;
}

/* The keyboard's left part, where a drag zooms the pitches and scrolls the note display (reference manual p. 1261):
   the pointer is the OS's four-point arrow over it. */
.key-editor-keys-zoom
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
	width: 12dp;
	cursor: move;
}

/* The tools' pointers over the note display (#1857); the trim tool's is the knife (reference manual p. 1215). */
.key-editor[tool=draw] .key-editor-grid
{
	cursor: tool-draw;
}

.key-editor[tool=line] .key-editor-grid
{
	cursor: tool-line;
}

.key-editor[tool=erase] .key-editor-grid
{
	cursor: tool-erase;
}

.key-editor[tool=trim] .key-editor-grid, .key-editor[tool=split] .key-editor-grid
{
	cursor: tool-split;
}

.key-editor[tool=glue] .key-editor-grid
{
	cursor: tool-glue;
}

.key-editor[tool=mute] .key-editor-grid
{
	cursor: tool-mute;
}

/* The drum editor's draw tool is the drumstick (reference manual p. 1224). */
.key-editor.drum-editor[tool=draw] .key-editor-grid
{
	cursor: tool-drumstick;
}

/* Where a press resizes a note, at its ends (pp. 1213-1214, 1242), with the object selection tool or the drumstick:
   code sets the note display's pointer. */
.key-editor .key-editor-grid[pointer=resize], .key-editor.drum-editor[tool=draw] .key-editor-grid[pointer=resize]
{
	cursor: resize;
}

/* While a gesture goes on, the grid and the keyboard's left part are RmlUi drag elements: their drag events come
   wherever the mouse is, also outside the window, and their dragend comes when the button goes up, also out there,
   where the document gets no mouseup. Only then: RmlUi doesn't scroll on a touch move during a drag. */
.key-editor.in-gesture .key-editor-grid,
.key-editor.in-gesture .key-editor-keys-zoom
{
	drag: drag;
}

.key-editor-notes
{
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.key-note
{
	position: absolute;
	box-sizing: border-box;
}

.key-editor-step-cursor
{
	position: absolute;
	top: 0;
	bottom: 0;
	width: 2dp;
}

.key-editor-step-cursor.off
{
	display: none;
}

/* The velocity of the notes the drumstick draws, while it drags (p. 1241): code places it on the note's row from the
   note's start, and the text goes right of the diamond. */
.key-editor-velocity
{
	position: absolute;
	box-sizing: border-box;
	padding-left: 8dp;
	white-space: nowrap;
	font-size: 8dp;
}

.key-editor-velocity.off
{
	display: none;
}

/* Per-note expression (reference manual pp. 1303-1313, docs/features/note-expression.md). Code places each step of an
   expression, from one point to the next, in percent of its note or of the expression editor: a line at its value.
   The expression editor lies over the note display on the selected notes' time, which code centers on the row of the
   note double-clicked and keeps inside the note display; its parameter button sits at its top left, and the area
   below is where the draw and erase tools edit. */
.key-expression-step
{
	position: absolute;
	height: 0;
	pointer-events: none; /* the note or the expression editor's area takes the mouse */
}

.key-expression-editor
{
	position: absolute;
	height: 96dp;
	min-width: 72dp; /* wider than Parameter Selection on a short note */
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
}

.key-expression-editor.off
{
	display: none;
}

.key-expression-type
{
	flex-shrink: 0;
	align-self: flex-start;
	height: 18dp;
	font-size: 9dp;
}

.key-expression-area
{
	position: relative;
	flex: 1 1 0;
}

/* The drum editor (#129, docs/features/drum-editor.md): the drum sound list instead of the keyboard, a row per
   sound with its pitch, mute button, name, snap, I-note, O-note, channel and output; taller rows; the notes as diamonds at
   their start, which code places by their left edge. The parts and the controller lanes start where the grid does. */
.drum-editor .editor-parts
{
	margin-left: 360dp;
}

.drum-editor .controller-lane-header
{
	width: 360dp;
}

/* The drum sounds stack in the list's flow, unlike the piano keys code places, beside the grid however narrow. */
.drum-editor .key-editor-body
{
	flex-wrap: nowrap;
}

.drum-editor .key-editor-keys
{
	width: 360dp;
	align-self: flex-start;
}

.drum-editor .key-editor-row, .key-editor-key.drum-sound
{
	height: 16dp;
}

.key-editor-key.drum-sound
{
	position: static;
	padding-top: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 10dp;
	line-height: 14dp;
	text-align: left;
	padding-right: 0;
	white-space: nowrap;
}

.drum-sound-pitch
{
	width: 32dp;
	padding-left: 4dp;
}

.drum-sound-mute
{
	width: 16dp;
	min-width: 16dp;
	height: 14dp;
	padding: 0;
	font-size: 9dp;
	line-height: 14dp;
}

.drum-sound textdisplay
{
	min-width: 0;
	height: 14dp;
	padding: 0 2dp;
	overflow: hidden;
}

.drum-sound textdisplay.drum-sound-name
{
	flex: 1 1 0;
	margin-left: 4dp;
	text-align: left;
}

/* A name list's names, without a drum map: not edited. */
.drum-sound span.drum-sound-name
{
	flex: 1 1 0;
	margin-left: 4dp;
	overflow: hidden;
	white-space: nowrap;
}

.drum-sound textdisplay.drum-sound-field
{
	flex: 0 0 auto;
	width: 40dp;
}

.drum-sound textdisplay.drum-sound-output
{
	width: 56dp;
}

.key-note.drum-note
{
	width: 10dp;
	height: 10dp;
	margin: 3dp 0 0 -5dp;
	transform: rotate(45deg);
}

#drum-map
{
	min-width: 80dp;
}

/* The inspector's Chord Editing section (pp. 1215-1218). */
.editor-chord-editing
{
	display: flex;
	flex-direction: column;
	padding: 4dp;
}

.editor-chord-type
{
	height: 20dp;
	margin-bottom: 4dp;
}

.editor-chords, .editor-voicings
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 4dp;
}

.editor-chord, .editor-voicing
{
	margin: 0 2dp 2dp 0;
}

/* The in-place editor (#131, ui/inplaceeditor.h, docs/features/in-place-editor.md): a key editor over its track's
   lane in the event display, which code places. The editors' container has no height, so that the lanes beside them
   still take presses. The toolbar and the info line show while .toolbar-shown, which the triangle in the track's row
   of the track list switches (base.rcss); .hidden while a folded folder hides the track. */
.in-place-editors
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 0;
}

.in-place-editor
{
	position: absolute;
	left: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
}

.in-place-editor.hidden,
.in-place-editor .key-editor-toolbar,
.in-place-editor .key-editor-info
{
	display: none;
}

.in-place-editor.toolbar-shown .key-editor-toolbar
{
	display: block;
}

.in-place-editor.toolbar-shown .key-editor-info
{
	display: flex;
}

/* The parts' row as wide as the grid, which the note display's scroll bar (base.rcss) narrows: the parts lie on the
   timeline too. */
.in-place-editor .editor-parts
{
	margin-right: 10dp;
}

/* As high as its track's lane, which the user sizes: the controller lanes keep their height there, and the note display
   takes what is left (#1775). */
.in-place-editor .key-editor-body
{
	flex-basis: 0;
}

.in-place-editor .controller-lanes
{
	flex-shrink: 0;
}
