	{
		border-top-width: 1dp;
		border-top-color: #ffffff;
	}
	.track-list .automation-row.selected
	{
		decorator: svg-ninepatch(list-item-selected.svg, 6 6 6 6);
	}
	.event-display .automation-lane
	{
		background-color: #00000080;
		border-top-width: 1dp;
		border-top-color: #ffffff;
	}
	.event-display .automation-curve
	{
		color: #ffffff;
		stroke-color: #00ffff;
	}
	.event-display .automation-lane.off .automation-curve
	{
		color: #c8c8c8;
		stroke-color: #c8c8c8;
	}
