		border-color: #ffff00;
	}
	.docking .strip
	{
		background-color: #000000;
	}
	.status-line .status-field
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.status-line .mismatch
	{
		color: #ffb000;
	}
	#lost-device
	{
		color: #ff8c8c;
	}
	.info-line.multiple .info-field
	{
		color: #ffff00;
	}
	.info-line .info-label, .inspector-label
	{
		color: #c8c8c8;
	}
	.inspector .insert.bypassed, .inspector .insert.inactive
	{
		color: #c8c8c8;
	}
	.pool-message.error
	{
