		background-color: #000000;
	}
	.key-note
	{
		background-color: #9e9e05;
		border-width: 1px;
		border-color: #ffff00;
	}
	.key-note.selected
	{
		background-color: #00ffff;
		border-color: #ffffff;
	}
	.key-note.inactive
	{
		background-color: #3c3c3c;
		border-color: #c8c8c8;
	}
	.key-note.drawing
	{
		background-color: #ffff0066;
	}
	.key-editor-step-cursor
	{
		background-color: #ffff00;
	}
	.in-place-editor
	{
		background-color: #000000;
		border-bottom-width: 1px;
		border-bottom-color: #ffffff;
	}
	.key-editor-key.drum-sound
	{
		background-color: #0d0d0d;
		color: #ffffff;
	}
	.key-editor-key.drum-sound.selected
	{
		background-color: #ffff00;
		color: #000000;
	}
	.controller-lane-area
	{
		background-color: #000000;
		border-bottom-width: 1px;
		border-bottom-color: #ffffff;
	}
	.controller-bar, .controller-step
	{
		background-color: #9e9e05;
	}
	.controller-bar.selected, .controller-step.selected
	{
		background-color: #00ffff;
	}
	.controller-bar.inactive, .controller-step.inactive
	{
		background-color: #3c3c3c;
	}
	.controller-lane[lane-kind=probability] .controller-bar, .controller-lane[lane-kind=velocityVariance] .controller-bar
	{
		background-color: transparent;
		decorator: repeating-linear-gradient(to top, #9e9e05 0dp, #9e9e05 3dp, #9e9e0500 3dp, #9e9e0500 5dp);
	}
	.controller-lane[lane-kind=probability] .controller-bar.selected, .controller-lane[lane-kind=velocityVariance] .controller-bar.selected
	{
		background-color: transparent;
		decorator: repeating-linear-gradient(to top, #00ffff 0dp, #00ffff 3dp, #00ffff00 3dp, #00ffff00 5dp);
	}
	.controller-lane[lane-kind=probability] .controller-bar.inactive, .controller-lane[lane-kind=velocityVariance] .controller-bar.inactive
	{
		background-color: transparent;
		decorator: repeating-linear-gradient(to top, #3c3c3c 0dp, #3c3c3c 3dp, #3c3c3c00 3dp, #3c3c3c00 5dp);
	}
	.ape-display
	{
		background-color: #000000;
	}
	.ape-lane
	{
		border-bottom-width: 1px;
		border-bottom-color: #808080;
	}
	.ape-event
	{
		background-color: #565609;
		border-width: 1px;
		border-color: #ffff00;
	}
	.ape-event.selected
	{
		background-color: #068686;
		border-color: #ffffff;
	}
	.ape-event.muted, .ape-event.inactive, .ape-event.outside
	{
		background-color: #3c3c3c;
		border-color: #c8c8c8;
	}
	.audio-part-editor .editor-part
	{
		color: #c8c8c8;
		border-width: 1dp;
		border-color: #ffffff;
		background-color: #060606;
	}
	.audio-part-editor .editor-part.editable
	{
		color: #ffffff;
	}
	.audio-part-editor .editor-part.active
	{
		color: #ffff00;
	}
	.se-overview, .se-display
	{
		background-color: #000000;
	}
	.se-overview-event
	{
		background-color: #ffffff1a;
	}
	.se-overview-selection, .se-selection
	{
		background-color: #ffffff33;
	}
	.se-overview-view
	{
		border-width: 1dp;
		border-color: #ffff00;
	}
	.se-overview-snap, .se-snap-point
	{
		background-color: #00ffff;
	}
	.se-outside
	{
		background-color: #00000099;
	}
	.se-region-shown
	{
		border-width: 1dp;
		border-color: #00ffff;
		background-color: #00ffff1a;
	}
	.se-region.selected
	{
		background-color: #666600;
	}
	.se-hitpoint-line, .se-hitpoint-handle
	{
		background-color: #ffff00;
	}
	.se-hitpoint.locked .se-hitpoint-handle
	{
		background-color: #00ffff;
	}
	.se-hitpoint.disabled .se-hitpoint-line, .se-hitpoint.disabled .se-hitpoint-handle
	{
		background-color: #c8c8c866;
	}
	.se-warp-marker-line, .se-warp-marker-handle
	{
