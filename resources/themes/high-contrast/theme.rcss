	.sampler-display
	{
		background-color: #000000;
	}
	.sampler-outside
	{
		background-color: #00000099;
	}
	.sampler-loop
	{
		background-color: #00ffff1a;
	}
	.sampler-marker-line, .sampler-marker-flag
	{
		background-color: #ffff00;
	}
	.sampler-marker.loop .sampler-marker-line, .sampler-marker.loop .sampler-marker-flag
	{
		background-color: #00ffff;
	}
	.sampler-marker.dragged .sampler-marker-line, .sampler-marker.dragged .sampler-marker-flag
	{
		background-color: #ffffff;
	}
	.sampler-section-title, .sampler-label
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.sampler-key
	{
		background-color: #ffffff;
		border-right-width: 1px;
		border-right-color: #ffffff;
	}
	.sampler-key.black
	{
		background-color: #000000;
	}
	.sampler-key.outside
	{
		background-color: #c8c8c8;
	}
	.sampler-key.black.outside
	{
		background-color: #505050;
	}
	.sampler-key.root
	{
		background-color: #ffff00;
	}
	.sampler-handle
	{
		background-color: #c8c8c8;
	}
	.sampler-handle.root
	{
		background-color: #ffff00;
	}
	.sampler-handle.dragged
	{
		background-color: #ffffff;
	}
	.sampler-message.error
	{
		color: #ff8c8c;
	}
	.ds-display, .sa-graph
	{
		background-color: #000000;
	}
	.ds-section
	{
		background-color: #9e9e05;
	}
	.sa-bar
	{
		background-color: #ffff00;
	}
	.sa-bar.reference
	{
		background-color: #00ffff;
	}
	.st-header, .st-name
	{
		color: #c8c8c8;
	}
	.pattern-editor-body, .pattern-bars
	{
		background-color: #000000;
	}
	.pattern-step
	{
		background-color: #808080;
	}
	.pattern-step.beat
	{
		background-color: #ffffff;
	}
	.pattern-step.on
	{
		background-color: #ffff00;
	}
	.pattern-step.tied
	{
		background-color: #8c8c00;
	}
	.pattern-step.selected
	{
		background-color: #00ffff;
	}
	.pattern-lane.selected .pattern-lane-name
	{
		color: #ffff00;
	}
	.pattern-bar
	{
		background-color: #ffff00;
	}
	.list-editor-header
	{
		color: #c8c8c8;
		border-bottom-width: 1px;
		border-bottom-color: #ffffff;
	}
	.list-editor-rows .list-row
	{
		border-bottom-width: 1px;
		border-bottom-color: #808080;
	}
	.list-editor-body
	{
		background-color: #000000;
	}
	.list-row.selected
	{
		background-color: #404000;
	}
	.list-row.inactive
	{
		color: #c8c8c8;
	}
	.list-event
	{
		background-color: #9e9e05;
		border-width: 1px;
		border-color: #ffff00;
