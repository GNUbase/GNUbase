/* SPDX-License-Identifier: GPL-3.0-or-later */
/* The high-contrast theme: colors, fonts and skins of GNUbase's widgets (docs/features/themes.md). Generated by
   tools/skin/generate.py: change the generator and run it again rather than editing this file. */
@media (theme: high-contrast)
{
	body
	{
		background-color: #000000;
		color: #ffffff;
		font-family: Inter;
		font-size: 13dp;
	}
	h1
	{
		font-size: 15dp;
		font-weight: 600;
	}
	h2
	{
		font-size: 13dp;
		font-weight: 600;
	}
	.text-small
	{
		font-size: 11dp;
		color: #c8c8c8;
	}
	.text-label
	{
		font-size: 12dp;
	}
	.text-title
	{
		font-size: 15dp;
		font-weight: 600;
	}
	.text-display
	{
		font-size: 20dp;
		font-weight: 600;
	}
	.text-muted
	{
		color: #c8c8c8;
	}
	.text-accent
	{
		color: #ffff00;
	}
	.counter
	{
		font-family: JetBrains Mono;
	}
	svg.icon
	{
		image-color: #ffffff;
	}
	svg.icon.accent
	{
		image-color: #ffff00;
	}
	svg.icon.muted
	{
		image-color: #c8c8c8;
	}
	svg.icon.danger
	{
		image-color: #ff8c8c;
	}
	.dialog, dialog
	{
		decorator: svg-ninepatch(dialog.svg, 6 6 6 6);
	}
	.dialog-titlebar
	{
		decorator: svg-ninepatch(dialog-titlebar.svg, 6 6 6 6);
		font-weight: 600;
	}
	.panel
	{
		decorator: svg-ninepatch(panel.svg, 6 6 6 6);
	}
	.panel-header
	{
		decorator: svg-ninepatch(panel-header.svg, 6 6 6 6);
		color: #c8c8c8;
		font-size: 12dp;
	}
	.toolbar
	{
		decorator: svg-ninepatch(toolbar.svg, 6 6 6 6);
	}
	.display, valuefield
	{
		decorator: svg-ninepatch(display.svg, 6 6 6 6);
		font-family: JetBrains Mono;
		color: #ffffff;
	}
	.tooltip, tooltip
	{
		decorator: svg-ninepatch(tooltip.svg, 6 6 6 6);
		font-size: 11dp;
	}
	.focus-ring
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
	.menu, menu, select selectbox
	{
		decorator: svg-ninepatch(menu.svg, 6 6 6 6);
	}
	.menu-item:hover, menuitem:hover, menuitem:focus-visible, select selectbox option:hover
	{
		decorator: svg-ninepatch(menu-item-hover.svg, 6 6 6 6);
	}
	menuitem:disabled
	{
		color: #c8c8c8;
	}
	menuitem.checked
	{
		color: #ffff00;
	}
	.menu-separator, menuseparator
	{
		decorator: svg-ninepatch(menu-separator.svg, 2 2 2 2);
	}
	.list, listview
	{
		decorator: svg-ninepatch(list.svg, 6 6 6 6);
	}
	.list-item:hover, listitem:hover, listview tbody tr:hover
	{
		decorator: svg-ninepatch(list-item-hover.svg, 6 6 6 6);
	}
	.list-item.selected, listitem.selected, listview tr.selected, select selectbox option:checked
	{
		decorator: svg-ninepatch(list-item-selected.svg, 6 6 6 6);
	}
	listview thead td.sorted
	{
		color: #ffff00;
	}
	tabset tabs
	{
		decorator: svg-ninepatch(tabbar.svg, 6 6 6 6);
	}
	tabset tab
	{
		decorator: svg-ninepatch(tab-normal.svg, 6 6 6 6);
		color: #c8c8c8;
	}
	tabset tab:hover
	{
		decorator: svg-ninepatch(tab-hover.svg, 6 6 6 6);
		color: #ffffff;
	}
	tabset tab:selected
	{
		decorator: svg-ninepatch(tab-active.svg, 6 6 6 6);
		color: #ffffff;
	}
	button
	{
		decorator: svg-ninepatch(button-normal.svg, 6 6 6 6);
		color: #ffffff;
	}
	button:hover
	{
		decorator: svg-ninepatch(button-hover.svg, 6 6 6 6);
	}
	button:active
	{
		decorator: svg-ninepatch(button-pressed.svg, 6 6 6 6);
	}
	button.checked
	{
		decorator: svg-ninepatch(button-checked.svg, 6 6 6 6);
	}
	button.suspended
	{
		decorator: svg-ninepatch(button-normal.svg, 6 6 6 6);
		color: #ffb000;
	}
	button.tapping
	{
		decorator: svg-ninepatch(button-pressed.svg, 6 6 6 6);
	}
	button:disabled
	{
		decorator: svg-ninepatch(button-disabled.svg, 6 6 6 6);
		color: #c8c8c8;
	}
	button.primary
	{
		decorator: svg-ninepatch(button-primary-normal.svg, 6 6 6 6);
		color: #000000;
	}
	button.primary:hover
	{
		decorator: svg-ninepatch(button-primary-hover.svg, 6 6 6 6);
	}
	button.primary:active
	{
		decorator: svg-ninepatch(button-primary-pressed.svg, 6 6 6 6);
	}
	button svg.icon
	{
		image-color: #ffffff;
	}
	button:disabled svg.icon
	{
		image-color: #c8c8c8;
	}
	button.primary svg.icon
	{
		image-color: #000000;
	}
	button.toggle
	{
		decorator: svg-ninepatch(toggle-off.svg, 6 6 6 6);
		color: #c8c8c8;
		font-size: 11dp;
		font-weight: 600;
	}
	button.toggle:hover
	{
		decorator: svg-ninepatch(toggle-hover.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.mute.checked
	{
		decorator: svg-ninepatch(toggle-mute.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.solo.checked
	{
		decorator: svg-ninepatch(toggle-solo.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.record.checked
	{
		decorator: svg-ninepatch(toggle-record.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.monitor.checked
	{
		decorator: svg-ninepatch(toggle-monitor.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.listen.checked
	{
		decorator: svg-ninepatch(toggle-monitor.svg, 6 6 6 6);
		color: #ffffff;
	}
	button.toggle.solo.defeated
	{
		decorator: svg-ninepatch(toggle-hover.svg, 6 6 6 6);
		color: #ffff00;
	}
	input.text, input.password, textarea
	{
		decorator: svg-ninepatch(field-normal.svg, 6 6 6 6);
		color: #ffffff;
	}
	input.text:focus, input.password:focus, textarea:focus
	{
		decorator: svg-ninepatch(field-focus.svg, 6 6 6 6);
	}
	input.text:disabled, input.password:disabled, textarea:disabled
	{
		decorator: svg-ninepatch(field-disabled.svg, 6 6 6 6);
		color: #c8c8c8;
	}
	input.text selection, input.password selection, textarea selection
	{
		background-color: #7a7a07;
		color: #ffffff;
	}
	select
	{
		decorator: svg-ninepatch(dropdown-normal.svg, 6 6 6 6);
		color: #ffffff;
	}
	select:hover
	{
		decorator: svg-ninepatch(dropdown-hover.svg, 6 6 6 6);
	}
	select:focus
	{
		decorator: svg-ninepatch(dropdown-open.svg, 6 6 6 6);
	}
	select:disabled
	{
		decorator: svg-ninepatch(field-disabled.svg, 6 6 6 6);
		color: #c8c8c8;
	}
	select selectarrow, .dropdown-arrow
	{
		decorator: svg(dropdown-arrow.svg);
	}
	input.checkbox
	{
		decorator: svg(checkbox-off.svg);
	}
	input.checkbox:checked
	{
		decorator: svg(checkbox-on.svg);
	}
	input.checkbox.mixed
	{
		decorator: svg(checkbox-mixed.svg);
	}
	input.radio
	{
		decorator: svg(radio-off.svg);
	}
	input.radio:checked
	{
		decorator: svg(radio-on.svg);
	}
	input.checkbox:disabled, input.radio:disabled
	{
		opacity: 0.5;
	}
	input.range slidertrack, progress, .slider-track
	{
		decorator: svg-ninepatch(slider-track.svg, 1 1 1 1);
	}
	input.range sliderprogress, progress fill, .slider-fill
	{
		decorator: svg-ninepatch(slider-fill.svg, 1 1 1 1);
	}
	input.range sliderbar, .slider-thumb
	{
		decorator: svg(slider-thumb.svg);
	}
	scrollbarvertical slidertrack
	{
		decorator: svg-ninepatch(scrollbar-track-vertical.svg, 3 3 3 3);
	}
	scrollbarvertical sliderbar
	{
		decorator: svg-ninepatch(scrollbar-thumb-vertical.svg, 2 2 2 2);
	}
	scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active
	{
		decorator: svg-ninepatch(scrollbar-thumb-vertical-hover.svg, 2 2 2 2);
	}
	scrollbarhorizontal slidertrack
	{
		decorator: svg-ninepatch(scrollbar-track-horizontal.svg, 3 3 3 3);
	}
	scrollbarhorizontal sliderbar
	{
		decorator: svg-ninepatch(scrollbar-thumb-horizontal.svg, 2 2 2 2);
	}
	scrollbarhorizontal sliderbar:hover, scrollbarhorizontal sliderbar:active
	{
		decorator: svg-ninepatch(scrollbar-thumb-horizontal-hover.svg, 2 2 2 2);
	}
	scrollbarcorner
	{
		background-color: #000000;
	}
	.knob
	{
		decorator: svg(knob-base.svg);
	}
	.knob-pointer
	{
		decorator: svg(knob-pointer.svg);
	}
	.fader
	{
		decorator: svg-ninepatch(fader-track.svg, 2 2 2 2);
	}
	.fader-cap
	{
		decorator: svg(fader-cap.svg);
	}
	.meter
	{
		decorator: svg-ninepatch(meter-background.svg, 1 1 1 1);
	}
	.meter-fill
	{
		decorator: svg(meter-fill.svg);
	}
	.meter-peak
	{
		decorator: svg(meter-peak.svg);
	}
	.tree-toggle
	{
		decorator: svg(dropdown-arrow.svg);
	}
	knob:focus-visible, fader:focus-visible, slider:focus-visible, input.range:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
	colorpicker .color-field
	{
		decorator: linear-gradient(to bottom, #00000000, #000000), linear-gradient(to right, #ffffff, #ffffff00);
	}
	colorpicker .color-hue
	{
		decorator: linear-gradient(to bottom, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
	}
	colorpicker .color-field-thumb, colorpicker .color-hue-thumb
	{
		decorator: svg(slider-thumb.svg);
	}
	.splitter-grip-vertical
	{
		decorator: svg(splitter-grip-vertical.svg);
	}
	.splitter-grip-horizontal
	{
		decorator: svg(splitter-grip-horizontal.svg);
	}
	event-lanes
	{
		color: #626208;
		stroke-color: #ffff00;
		stroke-width: 1dp;
	}
	waveform
	{
		color: #ffff00;
	}
	curve
	{
		stroke-color: #00ffff;
		stroke-width: 3dp;
	}
	ruler
	{
		color: #c8c8c8;
		stroke-color: #ffffff;
		stroke-width: 1dp;
		font-size: 11dp;
	}
	.event-display
	{
		background-color: #000000;
	}
	.event-display .overview
	{
		background-color: #000000;
	}
	.event-display .overview event-lanes
	{
		color: #737300;
		stroke-color: transparent;
	}
	.event-display .overview-view
	{
		border-width: 1dp;
		border-color: #ffff00;
		background-color: #ffff0026;
	}
	.event-display event-lanes.muted-events
	{
		color: #323232;
		stroke-color: #646464;
	}
	.event-display event-lanes.selected-events
	{
		color: #b6b604;
		stroke-color: #ffffff;
	}
	.event-display fade-lines
	{
		color: #ffffff;
		stroke-color: #ffffff;
		stroke-width: 1dp;
	}
	.event-display event-lanes.folder-data
	{
		color: #4c4c00;
		stroke-color: transparent;
	}
	.event-display ruler
	{
		background-color: #000000;
	}
	.event-display .project-cursor
	{
		background-color: #ffffff;
	}
	.event-display .step-input-cursor, .event-display .step-input-handle
	{
		background-color: #ffff00;
	}
	.event-display .cross-hair-vertical, .event-display .cross-hair-horizontal
	{
		background-color: #646464;
	}
	.event-display .marker-lines
	{
		stroke-color: #008080;
		stroke-width: 1dp;
	}
	.event-display .marker-events
	{
		color: #00ffff40;
		stroke-color: #00ffff;
		stroke-width: 1dp;
	}
	.event-display .marker-label
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.event-display .marker-label.active
	{
		color: #ffffff;
	}
	.event-display .marker-label.selected
	{
		color: #000000;
		background-color: #00ffff;
	}
	.tempo-curve .tempo-line
	{
		stroke-color: #ffff00;
		stroke-width: 3dp;
	}
	.tempo-curve.inactive .tempo-line
	{
		stroke-color: #c8c8c8;
	}
	.tempo-curve .tempo-line.fixed-tempo
	{
		stroke-color: #ffff00;
	}
	.tempo-curve .tempo-point
	{
		background-color: #ffff00;
	}
	.tempo-curve.inactive .tempo-point
	{
		background-color: #c8c8c8;
	}
	.tempo-curve .tempo-point.selected
	{
		background-color: #ffffff;
	}
	.tempo-editor .tempo-scale-label
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.tempo-editor .tool-rectangle
	{
		border-width: 1dp;
		border-color: #ffff00;
		background-color: #ffff001a;
	}
	.signature-row .signature-event
	{
		color: #ffffff;
		font-size: 11dp;
		border-left-width: 1dp;
		border-left-color: #00ffff;
	}
	.signature-row .signature-event.selected
	{
		color: #000000;
		background-color: #00ffff;
	}
	.transpose-row .transpose-event
	{
		color: #ffffff;
		font-size: 11dp;
		border-left-width: 1dp;
		border-left-color: #ffff00;
	}
	.chord-row .chord-event
	{
		color: #ffffff;
		font-size: 11dp;
		border-left-width: 1dp;
		border-left-color: #00ffff;
	}
	.chord-row .chord-event.detected
	{
		border-right-width: 3dp;
		border-right-color: #ffb000;
	}
	.scale-row .scale-event
	{
		color: #c8c8c8;
		font-size: 11dp;
		border-left-width: 1dp;
		border-left-color: #ffff00;
	}
	.chord-pad
	{
		color: #ffffff;
		background-color: #0d0d0d;
		border-width: 1dp;
		border-color: #ffffff;
		border-radius: 2dp;
	}
	.chord-pad.unassigned
	{
		color: #c8c8c8;
		background-color: #000000;
	}
	.chord-pad .chord-pad-degree, .chord-pad .chord-pad-key
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.chord-pad.reference
	{
		border-color: #ffb000;
	}
	.chord-pad .chord-pad-reference
	{
		background-color: #ffb000;
	}
	.chord-pad.selected
	{
		border-color: #ffffff;
	}
	.chord-pad.locked .chord-pad-key
	{
		color: #00ffff;
	}
	.chord-pad .chord-pad-adaptive
	{
		background-color: #ffff00;
		border-radius: 999dp;
	}
	.chord-pad.triggered
	{
		background-color: #7a7a07;
	}
	.chord-pad.listening
	{
		border-color: #ff8c8c;
	}
	.chord-pad.level-0
	{
		border-bottom-color: #40ff80;
	}
	.chord-pad.level-1
	{
		border-bottom-color: #ffb000;
	}
	.chord-pad.level-2
	{
		border-bottom-color: #ff8c8c;
	}
	.chord-pad .chord-pad-voicing
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.chord-pad .chord-pad-progress
	{
		background-color: #ffff00;
	}
	.chord-pad.black-key
	{
		background-color: #050505;
	}
	.chord-pads-key.white
	{
		background-color: #ffffff;
		border-width: 1dp;
		border-color: #ffffff;
	}
	.chord-pads-key.black
	{
		background-color: #000000;
	}
	.chord-pads-key.remote
	{
		background-color: #ffff80;
	}
	.chord-pads-key.black.remote
	{
		background-color: #999900;
	}
	.chord-pads-key.modifier
	{
		background-color: #40ff80;
	}
	.chord-pads-key.hover
	{
		background-color: #ffb000;
	}
	.chord-pads-key.played
	{
		background-color: #00ffff;
	}
	.chord-proximity-reference
	{
		color: #ffff00;
	}
	.chord-suggestion.recent .chord-suggestion-chord
	{
		font-weight: bold;
	}
	.chord-suggestion
	{
		color: #ffffff;
		border-left-width: 3dp;
		border-left-color: #ffffff;
	}
	.chord-suggestion.level-0
	{
		border-left-color: #40ff80;
	}
	.chord-suggestion.level-1
	{
		border-left-color: #ffb000;
	}
	.chord-suggestion.level-2
	{
		border-left-color: #ff8c8c;
	}
	.chord-suggestion.in-key
	{
		border-left-color: #ffff00;
	}
	.chord-suggestion .chord-suggestion-degree, .chord-pads-hint
	{
		color: #c8c8c8;
		font-size: 11dp;
	}
	.event-display .range-selection
	{
		border-width: 1dp;
		border-color: #ffffff;
		background-color: #ffffff33;
	}
	.event-display .tool-rectangle
	{
		border-width: 1dp;
		border-color: #ffff00;
		background-color: #ffff001a;
	}
	.track-list
	{
		background-color: #000000;
	}
	.track-list listitem
	{
		border-bottom-width: 1dp;
		border-bottom-color: #ffffff;
	}
	.track-list listitem.disabled
	{
		color: #c8c8c8;
	}
	.track-list listitem.frozen
	{
		color: #c8c8c8;
	}
	.track-list .drop-line
	{
		background-color: #ffff00;
	}
	.track-list .track-controls input.current-tempo, .track-list .track-controls select.tempo-type
	{
		font-size: 11dp;
	}
	.track-list .automation-rows
	{
		background-color: #000000;
	}
