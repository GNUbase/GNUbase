	{
		color: #c8c8c8;
		border-width: 1dp;
		border-color: #ffffff;
		background-color: #060606;
	}
	.midi-editor .editor-part.editable, .in-place-editor .editor-part.editable
	{
		color: #ffffff;
	}
	.midi-editor .editor-part.active, .in-place-editor .editor-part.active, .editor-visibility-track.active
	{
		color: #ffff00;
	}
