/* SPDX-License-Identifier: GPL-3.0-or-later */
/* The gnubase theme: colors, fonts and skins of GNUbase's widgets (docs/features/themes.md). Generated by
   tools/skin/generate.py: change the generator and run it again rather than editing this file. */
@media (theme: gnubase)
{
	body
	{
		background-color: #090b18;
		color: #f1f4ff;
		font-family: Inter;
		font-size: 13dp;
	}
	h1
	{
		font-size: 15dp;
		font-weight: 600;
	}
	h2
	{
		font-size: 13dp;
		font-weight: 600;
	}
	.text-small
	{
		font-size: 11dp;
		color: #aeb7d0;
	}
	.text-label
	{
		font-size: 12dp;
	}
	.text-title
	{
		font-size: 15dp;
		font-weight: 600;
	}
	.text-display
	{
		font-size: 20dp;
		font-weight: 600;
	}
	.text-muted
	{
		color: #aeb7d0;
	}
	.text-accent
	{
		color: #10dff2;
	}
	.counter
	{
		font-family: JetBrains Mono;
	}
	svg.icon
	{
		image-color: #f1f4ff;
	}
	svg.icon.accent
	{
		image-color: #10dff2;
	}
	svg.icon.muted
	{
		image-color: #aeb7d0;
	}
	svg.icon.danger
	{
		image-color: #ff5270;
	}
	.dialog, dialog
	{
		decorator: svg-ninepatch(dialog.svg, 6 6 6 6);
	}
	.dialog-titlebar
	{
		decorator: svg-ninepatch(dialog-titlebar.svg, 6 6 6 6);
		font-weight: 600;
	}
	.panel
	{
		decorator: svg-ninepatch(panel.svg, 6 6 6 6);
	}
	.panel-header
	{
		decorator: svg-ninepatch(panel-header.svg, 6 6 6 6);
		color: #aeb7d0;
		font-size: 12dp;
	}
	.toolbar
	{
		decorator: svg-ninepatch(toolbar.svg, 6 6 6 6);
	}
	.display, valuefield
	{
		decorator: svg-ninepatch(display.svg, 6 6 6 6);
		font-family: JetBrains Mono;
		color: #f1f4ff;
	}
	.tooltip, tooltip
	{
		decorator: svg-ninepatch(tooltip.svg, 6 6 6 6);
		font-size: 11dp;
	}
	.focus-ring
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
	.menu, menu, select selectbox
	{
		decorator: svg-ninepatch(menu.svg, 6 6 6 6);
	}
	.menu-item:hover, menuitem:hover, menuitem:focus-visible, select selectbox option:hover
	{
		decorator: svg-ninepatch(menu-item-hover.svg, 6 6 6 6);
	}
	menuitem:disabled
	{
		color: #aeb7d0;
	}
	menuitem.checked
	{
		color: #10dff2;
	}
	.menu-separator, menuseparator
	{
		decorator: svg-ninepatch(menu-separator.svg, 2 2 2 2);
	}
	.list
	{
		decorator: svg-ninepatch(list.svg, 6 6 6 6);
	}
	.list-item:hover
	{
		decorator: svg-ninepatch(list-item-hover.svg, 6 6 6 6);
	}
	.list-item.selected, select selectbox option:checked
	{
		decorator: svg-ninepatch(list-item-selected.svg, 6 6 6 6);
	}
	tabset tabs
	{
		decorator: svg-ninepatch(tabbar.svg, 6 6 6 6);
	}
	tabset tab
	{
		decorator: svg-ninepatch(tab-normal.svg, 6 6 6 6);
		color: #aeb7d0;
	}
	tabset tab:hover
	{
		decorator: svg-ninepatch(tab-hover.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	tabset tab:selected
	{
		decorator: svg-ninepatch(tab-active.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button
	{
		decorator: svg-ninepatch(button-normal.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button:hover
	{
		decorator: svg-ninepatch(button-hover.svg, 6 6 6 6);
	}
	button:active
	{
		decorator: svg-ninepatch(button-pressed.svg, 6 6 6 6);
	}
	button.checked
	{
		decorator: svg-ninepatch(button-checked.svg, 6 6 6 6);
	}
	button.suspended
	{
		decorator: svg-ninepatch(button-normal.svg, 6 6 6 6);
		color: #ffc44d;
	}
	button:disabled
	{
		decorator: svg-ninepatch(button-disabled.svg, 6 6 6 6);
		color: #aeb7d0;
	}
	button.primary
	{
		decorator: svg-ninepatch(button-primary-normal.svg, 6 6 6 6);
		color: #090b18;
	}
	button.primary:hover
	{
		decorator: svg-ninepatch(button-primary-hover.svg, 6 6 6 6);
	}
	button.primary:active
	{
		decorator: svg-ninepatch(button-primary-pressed.svg, 6 6 6 6);
	}
	button:focus-visible
	{
		decorator: svg-ninepatch(button-normal.svg, 6 6 6 6), svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
	button.primary:focus-visible
	{
		decorator: svg-ninepatch(button-primary-normal.svg, 6 6 6 6), svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
	button svg.icon
	{
		image-color: #f1f4ff;
	}
	button:disabled svg.icon
	{
		image-color: #aeb7d0;
	}
	button.primary svg.icon
	{
		image-color: #090b18;
	}
	button.toggle
	{
		decorator: svg-ninepatch(toggle-off.svg, 6 6 6 6);
		color: #aeb7d0;
		font-size: 11dp;
		font-weight: 600;
	}
	button.toggle:hover
	{
		decorator: svg-ninepatch(toggle-hover.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button.toggle.mute.checked
	{
		decorator: svg-ninepatch(toggle-mute.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button.toggle.solo.checked
	{
		decorator: svg-ninepatch(toggle-solo.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button.toggle.record.checked
	{
		decorator: svg-ninepatch(toggle-record.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	button.toggle.monitor.checked
	{
		decorator: svg-ninepatch(toggle-monitor.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	input.text, input.password, textarea
	{
		decorator: svg-ninepatch(field-normal.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	input.text:focus, input.password:focus, textarea:focus
	{
		decorator: svg-ninepatch(field-focus.svg, 6 6 6 6);
	}
	input.text:disabled, input.password:disabled, textarea:disabled
	{
		decorator: svg-ninepatch(field-disabled.svg, 6 6 6 6);
		color: #aeb7d0;
	}
	input.text selection, input.password selection, textarea selection
	{
		background-color: #147488;
		color: #f1f4ff;
	}
	select
	{
		decorator: svg-ninepatch(dropdown-normal.svg, 6 6 6 6);
		color: #f1f4ff;
	}
	select:hover
	{
		decorator: svg-ninepatch(dropdown-hover.svg, 6 6 6 6);
	}
	select:focus
	{
		decorator: svg-ninepatch(dropdown-open.svg, 6 6 6 6);
	}
	select:disabled
	{
		decorator: svg-ninepatch(field-disabled.svg, 6 6 6 6);
		color: #aeb7d0;
	}
	select selectarrow, .dropdown-arrow
	{
		decorator: svg(dropdown-arrow.svg);
	}
	input.checkbox
	{
		decorator: svg(checkbox-off.svg);
	}
	input.checkbox:checked
	{
		decorator: svg(checkbox-on.svg);
	}
	input.checkbox.mixed
	{
		decorator: svg(checkbox-mixed.svg);
	}
	input.radio
	{
		decorator: svg(radio-off.svg);
	}
	input.radio:checked
	{
		decorator: svg(radio-on.svg);
	}
	input.checkbox:disabled, input.radio:disabled
	{
		opacity: 0.5;
	}
	input.range slidertrack, progress, .slider-track
	{
		decorator: svg-ninepatch(slider-track.svg, 1 1 1 1);
	}
	input.range sliderprogress, progress fill, .slider-fill
	{
		decorator: svg-ninepatch(slider-fill.svg, 1 1 1 1);
	}
	input.range sliderbar, .slider-thumb
	{
		decorator: svg(slider-thumb.svg);
	}
	scrollbarvertical slidertrack
	{
		decorator: svg-ninepatch(scrollbar-track-vertical.svg, 3 3 3 3);
	}
	scrollbarvertical sliderbar
	{
		decorator: svg-ninepatch(scrollbar-thumb-vertical.svg, 2 2 2 2);
	}
	scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active
	{
		decorator: svg-ninepatch(scrollbar-thumb-vertical-hover.svg, 2 2 2 2);
	}
	scrollbarhorizontal slidertrack
	{
		decorator: svg-ninepatch(scrollbar-track-horizontal.svg, 3 3 3 3);
	}
	scrollbarhorizontal sliderbar
	{
		decorator: svg-ninepatch(scrollbar-thumb-horizontal.svg, 2 2 2 2);
	}
	scrollbarhorizontal sliderbar:hover, scrollbarhorizontal sliderbar:active
	{
		decorator: svg-ninepatch(scrollbar-thumb-horizontal-hover.svg, 2 2 2 2);
	}
	scrollbarcorner
	{
		background-color: #0b0e1d;
	}
	.knob
	{
		decorator: svg(knob-base.svg);
	}
	.knob-pointer
	{
		decorator: svg(knob-pointer.svg);
	}
	.fader
	{
		decorator: svg-ninepatch(fader-track.svg, 2 2 2 2);
	}
	.fader-cap
	{
		decorator: svg(fader-cap.svg);
	}
	.meter
	{
		decorator: svg-ninepatch(meter-background.svg, 1 1 1 1);
	}
	.meter-fill
	{
		decorator: svg(meter-fill.svg);
	}
	.meter-peak
	{
		decorator: svg(meter-peak.svg);
	}
	.splitter-grip-vertical
	{
		decorator: svg(splitter-grip-vertical.svg);
	}
	.splitter-grip-horizontal
	{
		decorator: svg(splitter-grip-horizontal.svg);
	}
	event-lanes
	{
		color: #156075;
		stroke-color: #10dff2;
		stroke-width: 1dp;
	}
	waveform
	{
		color: #10dff2;
	}
	curve
	{
		stroke-color: #e12ad8;
		stroke-width: 2dp;
	}
	ruler
	{
		color: #aeb7d0;
		stroke-color: #303754;
		stroke-width: 1dp;
		font-size: 11dp;
	}
	.event-display
	{
		background-color: #090b18;
	}
	.event-display .overview
	{
		background-color: #101426;
	}
	.event-display .overview event-lanes
	{
		color: #106f82;
		stroke-color: transparent;
	}
	.event-display .overview-view
	{
		border-width: 1dp;
		border-color: #10dff2;
		background-color: #10dff226;
	}
	.event-display ruler
	{
		background-color: #101426;
	}
	.event-display .project-cursor
	{
		background-color: #f1f4ff;
	}
	.event-display .cross-hair-vertical, .event-display .cross-hair-horizontal
	{
		background-color: #5c6174;
	}
}
