	.list-editor-body
	{
		background-color: #101426;
	}
	.list-row.selected
	{
		background-color: #104759;
	}
	.list-row.inactive
	{
		color: #aeb7d0;
	}
	.list-event
	{
		background-color: #1391a5;
		border-width: 1px;
		border-color: #10dff2;
	}
	.list-row.selected .list-event
	{
		background-color: #e12ad8;
		border-color: #f1f4ff;
	}
	.list-value
	{
		background-color: #10dff2;
	}
	.list-row.selected .list-value
	{
		background-color: #e12ad8;
	}
	.docking [zone]
	{
		background-color: #0c101f;
	}
	.docking .zone-frame
	{
		border-width: 2dp;
		border-color: #10dff2;
	}
	.docking .strip
	{
		background-color: #101426;
	}
	.status-line .status-field
	{
		color: #aeb7d0;
		font-size: 11dp;
	}
	.status-line .mismatch
	{
		color: #ffc44d;
	}
	#lost-device
	{
		color: #ff5270;
	}
	.info-line.multiple .info-field
	{
		color: #10dff2;
	}
	.info-line .info-label, .inspector-label
	{
		color: #aeb7d0;
	}
	.inspector .insert.bypassed, .inspector .insert.inactive
	{
		color: #aeb7d0;
	}
	.pool-message.error
	{
		color: #ff5270;
	}
	.history tr.undone, .history tr.undone input.text
	{
		color: #aeb7d0;
	}
	.history .history-separator
	{
		background-color: #10dff2;
	}
	.quantize-display
	{
		background-color: #101426;
	}
	.quantize-line
	{
		background-color: #10dff2;
	}
	.quantize-catch
	{
		background-color: #10dff233;
	}
	.onscreen-keyboard .white-key
	{
		background-color: #f1f4ff;
		color: #090b18;
		border-color: #303754;
	}
	.onscreen-keyboard .black-key
	{
		background-color: #090b18;
		color: #aeb7d0;
		border-color: #303754;
	}
	.onscreen-keyboard .white-key.pressed, .onscreen-keyboard .black-key.pressed
	{
		background-color: #10dff2;
	}
	menubar
	{
		background-color: #101426;
	}
	menubar button
	{
		decorator: none;
		color: #f1f4ff;
	}
	menubar button:hover
	{
		decorator: svg-ninepatch(menu-item-hover.svg, 6 6 6 6);
	}
	menuitem .menu-keys
	{
		color: #aeb7d0;
	}
	menuitem > .menu-arrow
	{
		decorator: svg(dropdown-arrow.svg);
	}
	.time-display.size-0
	{
		font-size: 32dp;
		line-height: 64dp;
	}
	.time-display.size-1
	{
		font-size: 48dp;
		line-height: 96dp;
	}
	.time-display.size-2
	{
		font-size: 64dp;
		line-height: 128dp;
	}
	.time-display.size-3
	{
		font-size: 96dp;
		line-height: 192dp;
	}
	.time-display.size-4
	{
		font-size: 128dp;
		line-height: 256dp;
	}
	valuefield:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(display.svg, 6 6 6 6);
	}
	listview:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(list.svg, 6 6 6 6);
	}
	button:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(button-normal.svg, 6 6 6 6);
	}
	button.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(button-checked.svg, 6 6 6 6);
	}
	button.suspended:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(button-normal.svg, 6 6 6 6);
	}
	button.primary:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(button-primary-normal.svg, 6 6 6 6);
	}
	button.toggle:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-off.svg, 6 6 6 6);
	}
	button.toggle.mute.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-mute.svg, 6 6 6 6);
	}
	button.toggle.solo.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-solo.svg, 6 6 6 6);
	}
	button.toggle.record.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-record.svg, 6 6 6 6);
	}
	button.toggle.monitor.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-monitor.svg, 6 6 6 6);
	}
	button.toggle.listen.checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-monitor.svg, 6 6 6 6);
	}
	button.toggle.solo.defeated:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg-ninepatch(toggle-hover.svg, 6 6 6 6);
	}
	input.checkbox:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg(checkbox-off.svg);
	}
	input.checkbox:checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg(checkbox-on.svg);
	}
	input.checkbox.mixed:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg(checkbox-mixed.svg);
	}
	input.radio:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg(radio-off.svg);
	}
	input.radio:checked:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6), svg(radio-on.svg);
	}
	menubar button:focus-visible
	{
		decorator: svg-ninepatch(focus-ring.svg, 6 6 6 6);
	}
}
